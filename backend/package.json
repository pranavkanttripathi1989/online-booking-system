    "seed": "ts-node prisma/seed.ts"
  },
  "overrides": {
    "multer": "2.2.0",
    "tar": "7.5.22",
    "lodash": "4.18.1",
    "@nestjs/graphql": {
      "ws": "8.21.3"
    }
  }
}
