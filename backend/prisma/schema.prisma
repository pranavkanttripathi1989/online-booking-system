// REQ008/PLAN017 — admin-configurable OTP/SMS provider per org. Deliberately
// its own model, not columns bolted onto ClientOrganizations, since the
// credential shape varies per provider (see backend/src/notifications/providers/)
// and doesn't belong flattened into the org's own row. `channel` is a plain
// string ('sms' today) rather than an enum so a future channel (whatsapp,
// etc.) needs zero schema change — same reasoning for `provider` being a
// registry key, not an enum, so adding a provider is a code change only.
model NotificationProviderConfig {
  id                    String   @id @default(uuid())
  client_org_id         String
  channel               String
  provider              String
  credentials_encrypted String   // AES-256-GCM JSON blob, shape owned by the provider's registry entry
  sender_id             String?  // common display field across most SMS providers; kept denormalized
  is_active             Boolean  @default(true)
  created_at            DateTime @default(now())
  updated_at            DateTime @default(now())

  client_org ClientOrganizations @relation(fields: [client_org_id], references: [id])

  @@unique([client_org_id, channel])
}

model OrganizationSubscriptions {
