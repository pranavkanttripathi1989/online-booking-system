generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//
// INDEX POLICY (F-13, BUG005 — migration 20260822130000_add_indexes)
//
// The 69 @@index declarations below were derived by reading the real `where` and
// `orderBy` clauses in backend/src/**/*.service.ts, then measured with
// EXPLAIN (ANALYZE, BUFFERS) on a scratch database seeded to 50,000 appointments.
// Four rules came out of that measurement. Follow them when adding a model:
//
//   1. Equality columns first, range/sort column last, so one index serves both
//      the filter and the ordering and the sort node leaves the plan.
//   2. Never lead a composite with client_org_id, and never index it alone. The
//      tenant predicate matches ~20% of rows, so a sequential scan is genuinely
//      optimal and the planner correctly ignores such an index (measured:
//      identical buffer counts with and without). Lead with the selective
//      column - clinician_id, clinic_id, patient_id.
//
//      The exception, and it is a real one: an unselective leading column is
//      still worth indexing when the TRAILING column supplies the sort order for
//      a LIMIT. Appointments(is_deleted, appointment_time) leads with a boolean
//      that is false for ~all rows, and the planner uses it anyway - measured, an
//      Index Scan Backward at 130 buffers instead of a 2,753-buffer sequential
//      scan plus a 50,000-row sort - because it can walk in appointment_time
//      order and stop at the LIMIT. Selectivity is one reason to index; ordered
//      access for a paginated list is another. client_org_id has neither here,
//      because it is not even a column on Appointments (it is joined through
//      Clinics), so no index on this table can serve it.
//   3. Do not blanket-index every foreign key. That yields ~120 indexes here
//      instead of 69, most never used, each paying write amplification forever.
//      Index a bare FK only where a query filters on it alone.
//   4. Small global reference tables (Languages, RoomTypes, ClinicianTypes,
//      EmailTemplates) get none - an index scan is slower than scanning two pages.
//
// Note Appointments carries both appointment_date and appointment_time; the
// services overwhelmingly use appointment_time, so the composites follow the code.
//
// Nothing enforces this policy in CI yet - see BUG005 follow-ups.
//

//
// ENUMS
//

// Realigned to admin/EmailTemplates.jsx's actual values (context/backend-hard-rules.md
// Rule 9) — zero code anywhere referenced the previous placeholder values, confirmed
// via grep before renaming. otp/review_request from earlier planning aren't dropped
// from the roadmap, just not modeled here until something real needs them this way.
enum TemplateType {
  appointment_confirmation
  appointment_reminder
  appointment_cancellation
  appointment_rescheduled
  password_reset
  welcome
  invoice
  cancellation_fee
}

enum NotificationType {
  appointment
  system
  payment
  alert
}

// settings/index.jsx's Notifications tab (REQ005) — one row per (user, event
// type) rather than a JSON blob, matching the DB-normalization precedent
// already set project-wide. Values match NOTIF_ROWS' 7 fixed event kinds.
enum NotificationEventType {
  new_appointment
  appointment_reminder
  appointment_cancelled
  new_message
  new_review
  payment_received
  system_announcement
  // REQ053 (US-SEC-05) — break-glass.service.ts's request() already called
  // dispatch(admin.id, 'break_glass_requested', ...) without this value
  // ever existing here; Prisma's runtime enum validation rejected every
  // such call, throwing out of the awaited Promise.all and failing the
  // entire requestBreakGlassAccess mutation for orgs with any admin/
  // manager to notify. Found live via a real e2e run, not a code review.
  break_glass_requested
  // REQ022 (US-PHR-09, scoped) — a drug's total remaining stock has crossed
  // at or below its own configured reorder_level.
  low_stock_alert
  // REQ106 — a cancellation/no-show freed a slot for the earliest waiting
  // entry on that clinician/date. Added in its own separate migration,
  // applied before any code references it — the exact break_glass_requested
  // precedent above (a missing enum value crashes the whole dispatch call).
  waitlist_slot_available
}

enum NotificationPriority {
  low
  medium
  high
}

enum ProductType {
  simple
  variable
}

enum RuleType {
  cancellation
  reschedule
}

enum FeeType {
  fixed
  percentage
}

enum SubscriptionStatus {
  active
  cancelled
  expired
  trial
}

enum TestResultStatus {
  pending
  processing
  completed
}

enum OnboardingStatus {
  pending       // org row created, wizard not yet started or abandoned mid-way
  in_progress   // wizard started, not all required steps done
  completed     // owner finished onboarding — org is fully usable
}

enum BillingCycle {
  monthly
  yearly
}

enum RecurrenceType {
  single
  daily
  weekly
  monthly
  custom
}

//
// MODELS
//

model ClinicianTypeModel {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now())

  @@map("clinician_types")
}

model RoomTypeModel {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now())

  @@map("room_types")
}

// Two Postgres EXCLUDE constraints (GiST, requires btree_gist) prevent two
// non-cancelled, non-deleted, booking_mode='slot' rows from having
// overlapping [appointment_time, appointment_time + duration_minutes)
// ranges for the same clinician_id, and separately for the same room_id --
// added in this model's own migrations (20260823030000/20260823031500_
// ..._exclusion_constraint, narrowed to booking_mode='slot' by REQ017's
// migration), not expressible declaratively here (Prisma has no
// EXCLUDE-constraint syntax). This is the P3.1/F-16 fix for
// booking-concurrency.int-spec.ts: the application-level assertSlotFree()
// check and the later create() are two separate statements, so N
// concurrent requests could all pass the check before any of them wrote --
// the database itself is now the only thing that can make "is this slot
// free" atomic. The room constraint is a data-integrity backstop only --
// create()'s own room *selection* still has no availability check at all
// (see open question #14). Session/hybrid mode (booking_mode != 'slot')
// deliberately falls outside both constraints -- many tokens in one
// session legitimately share the same clinician/room/time; that mode's
// capacity guarantee is a pg_advisory_xact_lock-guarded count check in
// appointments.service.ts instead (REQ017).
model Appointments {
  id                  String   @id @default(uuid())
  clinic_id           String
  room_id             String
  clinician_id        String
  patient_id          String
  appointment_date    DateTime
  appointment_time    DateTime
  duration_minutes    Int      @default(30)
  status              String   @default("scheduled")
  reason              String
  notes               String   @default("")
  is_deleted          Boolean  @default(false)
  created_at          DateTime @default(now())
  updated_at          DateTime @default(now())
  product_id          String?
  product_variation_id String?
  // AppointmentFields fragment (frontend/src/graphql/queries.js) requests these
  // three — none existed before the Appointments-domain increment (backend-hard-rules.md Rule 9).
  cancellation_reason String?
  reminder_sent_at    DateTime?
  booked_by_user_id   String?
  // calendar/index.jsx's type filter and video/index.jsx's getAppointment
  // both expect an appointment "type" (in_person/video/home_visit) — no
  // column existed for it (a pre-existing gap flagged in the master plan).
  type                String?  @default("in_person")
  // REQ017: denormalized copy of the matching ClinicianAvailability.mode at
  // booking time. Exists so the two overlap-exclusion constraints below can
  // exclude session/hybrid rows via their WHERE clause — many tokens in one
  // session legitimately share the same clinician/room/start time, which
  // the constraints must NOT reject; session/hybrid capacity is enforced in
  // application code instead (pg_advisory_xact_lock-guarded count check in
  // appointments.service.ts), a different but equally real guarantee.
  booking_mode        String   @default("slot")
  // Sequential 1..N within one session/hybrid window. Null for slot mode.
  token_no            Int?
  // REQ052 (US-BOOK-06) — { [field_key]: response value } for whatever
  // ClinicIntakeFieldConfig items applied at booking time. Exposed via
  // GraphQL as a structured [IntakeFieldResponseType!] list (this
  // codebase's convention for every other Json column), never a raw scalar.
  intake_responses    Json?
  // REQ107 — same shape as Users.password_reset_token/password_reset_expires
  // (auth.service.ts): only the SHA-256 hash is ever persisted, the raw
  // token is returned once, at generation time, and never again.
  // checkin_token_used_at makes the token single-use, cleared atomically
  // with the checked_in status write.
  checkin_token_hash       String?   @unique
  checkin_token_expires_at DateTime?
  checkin_token_used_at    DateTime?

  clinic              Clinics               @relation(fields: [clinic_id], references: [id])
  room                Rooms                 @relation(fields: [room_id], references: [id])
  clinician           Clinicians            @relation(fields: [clinician_id], references: [id])
  patient             Patients              @relation(fields: [patient_id], references: [id])
  product             Products?             @relation(fields: [product_id], references: [id])
  product_variation   ProductVariations?    @relation(fields: [product_variation_id], references: [id])
  booked_by_user      UserProfiles?         @relation("AppointmentBookedBy", fields: [booked_by_user_id], references: [id])
  reviews             Reviews[]
  status_logs         AppointmentStatusLogs[]
  payments            AppointmentPayments[]
  discountApprovalRequests DiscountApprovalRequests[]
  resources           AppointmentResources[]
  encounter           Encounters?
  queue_entry         QueueEntries?
  checklist_completions ChecklistCompletions[]
  claims              Claims[]

  @@index([clinician_id, appointment_time])
  @@index([clinic_id, appointment_time])
  @@index([patient_id, appointment_date])
  @@index([is_deleted, appointment_time])
  @@index([room_id])
  @@index([product_id])
  @@index([booked_by_user_id])
}

// APPOINTMENT_DETAIL_QUERY (frontend/src/graphql/queries.js) requests
// appointment.status_logs{...} — append-only, written inside every
// status-changing resolver via $transaction (backend-hard-rules.md Rule 5).
model AppointmentStatusLogs {
  id                String   @id @default(uuid())
  appointment_id    String
  status            String
  reason            String?
  changed_by_user_id String?
  created_at        DateTime @default(now())

  appointment     Appointments  @relation(fields: [appointment_id], references: [id])
  changed_by_user UserProfiles? @relation("StatusLogChangedBy", fields: [changed_by_user_id], references: [id])

  @@index([appointment_id, created_at])
}

// REQ020 (Phase 1, slice 2) — consultation workspace / clinical records
// (EMR), P0 subset. One Encounter per Appointment (US-EMR-01's "clinician
// opens the encounter" from an existing booking). client_org_id is its own
// column, denormalized from the appointment's clinic at creation -- Patients
// has no client_org_id of its own (confirmed), so this table needs one for
// direct orgScope() the same way Resources (REQ017) does.
//
// Immutability (US-EMR-06/PRD §14.2, "write-protected by trigger"): once
// locked=true, EncounterNotes/Diagnoses rows for this encounter are rejected
// at the DATABASE layer by a BEFORE UPDATE OR DELETE trigger (this model's
// own migration -- Prisma has no trigger syntax, and this is the first
// trigger in this codebase). The service layer's own lock check is the fast,
// friendly-error path in front of it, not a substitute for it -- the PRD
// explicitly names the trigger as the actual guarantee, not the application
// check. Correcting a signed encounter goes through EncounterAddenda
// instead, which is append-only and untouched by the trigger.
model Encounters {
  id             String    @id @default(uuid())
  client_org_id  String
  appointment_id String    @unique
  patient_id     String
  clinician_id   String
  status         String    @default("in_progress") // in_progress | signed
  locked         Boolean   @default(false)
  signed_at      DateTime?
  signed_by_id   String?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  client_organization ClientOrganizations @relation(fields: [client_org_id], references: [id])
  appointment         Appointments        @relation(fields: [appointment_id], references: [id])
  patient             Patients            @relation(fields: [patient_id], references: [id])
  clinician           Clinicians          @relation(fields: [clinician_id], references: [id])
  signed_by           UserProfiles?       @relation("EncounterSignedBy", fields: [signed_by_id], references: [id])
  notes               EncounterNotes[]
  addenda             EncounterAddenda[]
  diagnoses           Diagnoses[]
  attachments         Attachments[]
  prescriptions       Prescriptions[]
  investigationOrders TestResults[]
  referrals           Referrals[]
  vitals              Vitals[]

  @@index([client_org_id, patient_id])
  @@index([clinician_id])
  @@index([patient_id, created_at])
}

// One row per structured section per encounter (US-EMR-02) -- "vitals" is
// one of these section values, not a separate discrete-reading table this
// slice (that granular, trendable model is the explicitly-P1 "growth
// charts" half of FR-EMR-05, see PLAN### for this slice). Upserted on
// [encounter_id, section]; version increments on every save so a future
// audit view can show edit history without needing full row versioning.
model EncounterNotes {
  id          String   @id @default(uuid())
  encounter_id String
  section     String   // complaints|history|exam|vitals|diagnosis|investigations|advice|follow_up
  content     String   @default("")
  version     Int      @default(1)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  encounter Encounters @relation(fields: [encounter_id], references: [id], onDelete: Cascade)

  @@unique([encounter_id, section])
}

// Append-only. The only way to add information to a signed (locked)
// encounter -- never updated or deleted, so the trigger on EncounterNotes/
// Diagnoses has no equivalent need here.
model EncounterAddenda {
  id           String   @id @default(uuid())
  encounter_id String
  author_id    String
  content      String
  reason       String?
  created_at   DateTime @default(now())

  encounter Encounters   @relation(fields: [encounter_id], references: [id], onDelete: Cascade)
  author    UserProfiles @relation("AddendumAuthor", fields: [author_id], references: [id])

  @@index([encounter_id, created_at])
}

// Also backs the allergy banner (US-EMR-04): type='allergy' rows, queried
// across every encounter for the patient (not scoped to the current one) --
// the requirement's own Data Model Impact section names no separate
// Allergies table, so this is the specified model doing double duty, not an
// invented one. icd10_code is nullable/free-text-fallback at MVP per the
// requirement's own note -- real coding (FR-EMR-03) is P1.
model Diagnoses {
  id           String   @id @default(uuid())
  encounter_id String
  type         String   @default("diagnosis") // diagnosis | allergy
  icd10_code   String?
  text         String
  status       String   @default("active") // active | resolved
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  encounter Encounters @relation(fields: [encounter_id], references: [id], onDelete: Cascade)

  @@index([encounter_id])
}

// REQ128 (FR-EMR-10) -- a clinician referring a patient onward to another
// specialty/clinician from within a consultation. referred_to_clinician_id
// is nullable: a referral to "Cardiology" in general is valid even when no
// specific in-org clinician is named yet (e.g. referring out of network).
// No client_org_id column, same reasoning as Diagnoses -- scoped entirely
// via the parent encounter, which already carries it.
model Referrals {
  id                      String   @id @default(uuid())
  encounter_id            String
  patient_id              String
  referred_to_specialty   String
  referred_to_clinician_id String?
  reason                  String
  urgency                 String   @default("routine") // routine | urgent
  status                  String   @default("pending")  // pending | scheduled | completed | declined
  created_at              DateTime @default(now())
  updated_at              DateTime @updatedAt

  encounter           Encounters @relation(fields: [encounter_id], references: [id], onDelete: Cascade)
  patient             Patients   @relation(fields: [patient_id], references: [id])
  referred_to_clinician Clinicians? @relation(fields: [referred_to_clinician_id], references: [id])

  @@index([encounter_id])
  @@index([patient_id])
  @@index([referred_to_clinician_id])
}

// REQ130 (FR-EMR-05) -- one row per discrete vital-sign reading, not one
// wide "vitals" row per encounter: a code/value/unit shape (matching this
// requirement's own Data Model Impact section verbatim) lets a growth chart
// query one code (e.g. weight_kg) across every encounter for a patient
// without a schema change per new vital type. No patient_id column, same
// reasoning as Diagnoses/Referrals -- a cross-encounter query joins via
// encounter.patient_id (see EncountersService#patientVitals).
model Vitals {
  id           String   @id @default(uuid())
  encounter_id String
  code         String   // height_cm | weight_kg | temperature_c | pulse_bpm | bp_systolic | bp_diastolic | spo2_percent
  value        Float
  unit         String
  recorded_by_user_id String
  recorded_at  DateTime @default(now())

  encounter   Encounters   @relation(fields: [encounter_id], references: [id], onDelete: Cascade)
  recorded_by UserProfiles @relation(fields: [recorded_by_user_id], references: [id])

  @@index([encounter_id])
  @@index([code])
}

// file_ref is a local-filesystem URL under /uploads/attachments/, written by
// a REST controller (this codebase's established pattern for uploads --
// GqlAuthGuard doesn't cover REST routes, so that controller verifies its
// own bearer token directly, mirroring org-branding.controller.ts) and then
// persisted here via a separate GraphQL mutation, matching that same
// controller's two-step split rather than the avatar controller's
// inline-persist (this row carries more metadata than one column).
model Attachments {
  id                String   @id @default(uuid())
  encounter_id      String
  file_ref          String
  mime_type         String
  original_filename String
  uploaded_by_id    String
  created_at        DateTime @default(now())

  encounter   Encounters   @relation(fields: [encounter_id], references: [id], onDelete: Cascade)
  uploaded_by UserProfiles @relation("AttachmentUploadedBy", fields: [uploaded_by_id], references: [id])

  @@index([encounter_id])
}

// US-EMR-03: one-click templates. client_org_id null + clinician_id set
// would be meaningless (a personal favourite with no owning org) in
// practice every clinician has an org, but both are nullable per the
// requirement's own spec (a future platform-seeded default set could have
// client_org_id null too) -- clinician_id set means a personal favourite,
// null means org-shared.
model EncounterTemplates {
  id            String   @id @default(uuid())
  client_org_id String?
  clinician_id  String?
  specialty     String?
  name          String
  sections_json Json // { [section]: defaultContent }
  created_at    DateTime @default(now())

  client_organization ClientOrganizations? @relation(fields: [client_org_id], references: [id])
  clinician           Clinicians?          @relation(fields: [clinician_id], references: [id])

  @@index([client_org_id])
  @@index([clinician_id])
}

// REQ021 (Phase 1, slice 3) -- prescription builder, print view, and
// repeat-Rx, P0 subset. Issued from within an Encounter (REQ020's own
// dependency). Has no client_org_id of its own -- scoped indirectly via
// encounter.client_org_id, same reasoning as every other model here that
// hangs off Encounters rather than duplicating the column.
//
// Never updated after creation: no lock/trigger needed the way Encounters
// does, since there is no edit mutation to guard against in the first
// place. reprint_count distinguishes the original print (count stays 0 on
// first fetch) from a later reprint (incremented on every fetch after the
// first), which the frontend reads to render a "DUPLICATE" watermark.
model Prescriptions {
  id               String    @id @default(uuid())
  encounter_id     String
  patient_id       String
  clinician_id     String
  mode             String    @default("in_person") // in_person|video|audio|text
  issued_at        DateTime  @default(now())
  language         String    @default("en")
  repeated_from_id String?
  reprint_count    Int       @default(0)
  // REQ129 (US-RX-08) -- SHA-256 over the prescription's own canonical
  // clinical content (patient/clinician/encounter/issued_at + every item),
  // computed once at issue time. Not a hash of rendered PDF bytes: pdfkit
  // embeds a wall-clock CreationDate in every PDF it produces, which would
  // make two renders of identical content hash differently -- content
  // hashing is the deterministic, verifiable choice. Nullable: rows created
  // before this column existed have none.
  pdf_hash         String?

  encounter      Encounters      @relation(fields: [encounter_id], references: [id])
  patient        Patients        @relation(fields: [patient_id], references: [id])
  clinician      Clinicians      @relation(fields: [clinician_id], references: [id])
  repeated_from  Prescriptions?  @relation("PrescriptionRepeat", fields: [repeated_from_id], references: [id])
  repeats        Prescriptions[] @relation("PrescriptionRepeat")
  items          PrescriptionItems[]
  shareOtps      PrescriptionShareOtps[]

  @@index([patient_id, issued_at])
  @@index([encounter_id])
}

model PrescriptionItems {
  id              String   @id @default(uuid())
  prescription_id String
  drug_id         String
  dose            String
  frequency       String   // OD|BD|TDS|QID|HS|SOS
  route           String?
  duration_days   Int?
  qty             Int?     // server-calculated from frequency x duration; null for SOS (as-needed)
  instructions    String?
  substitutable   Boolean  @default(true)

  prescription Prescriptions @relation(fields: [prescription_id], references: [id], onDelete: Cascade)
  drug         Drugs         @relation(fields: [drug_id], references: [id])

  @@index([prescription_id])
}

// REQ109 — a dedicated table, not Redis (unlike the login-OTP stub),
// because this OTP gates a REST download that must survive a Redis
// restart within its TTL, and because attempts/consumed_at double as the
// audit trail for "was this ever shared, did the recipient retrieve it" —
// a real clinical-safety question worth persisting durably.
model PrescriptionShareOtps {
  id              String    @id @default(uuid())
  prescription_id String
  phone           String
  otp_code        String
  attempts        Int       @default(0)
  expires_at      DateTime
  consumed_at     DateTime?
  created_at      DateTime  @default(now())

  prescription Prescriptions @relation(fields: [prescription_id], references: [id])

  @@index([prescription_id])
}

// US-RX-02: saved drug-set favourites. Mirrors EncounterTemplates' exact
// shape (client_org_id/clinician_id both nullable, clinician_id set = a
// personal favourite, null = org-shared) -- the requirement's own Data
// Model Impact section lists no favourites table at all, the identical gap
// EncounterTemplates had in REQ020, resolved the same way. Structured
// SetItems rather than a JSON blob (unlike EncounterTemplates.sections_json)
// because each line needs a real drug_id FK, not free text.
model PrescriptionSets {
  id            String   @id @default(uuid())
  client_org_id String?
  clinician_id  String?
  specialty     String?
  name          String
  created_at    DateTime @default(now())

  client_organization ClientOrganizations?    @relation(fields: [client_org_id], references: [id])
  clinician           Clinicians?             @relation(fields: [clinician_id], references: [id])
  items               PrescriptionSetItems[]

  @@index([client_org_id])
  @@index([clinician_id])
}

model PrescriptionSetItems {
  id                  String  @id @default(uuid())
  prescription_set_id String
  drug_id             String
  dose                String
  frequency           String
  route               String?
  duration_days       Int?
  instructions        String?

  set  PrescriptionSets @relation(fields: [prescription_set_id], references: [id], onDelete: Cascade)
  drug Drugs            @relation(fields: [drug_id], references: [id])

  @@index([prescription_set_id])
}

// REQ019 (Phase 1, slice 4) -- check-in, live queue board, and queue
// actions, P0 subset. No client_org_id of its own -- scoped via
// clinic.client_org_id, the same precedent Appointments itself uses (this
// table is genuinely runtime state for an Appointment, not a standalone
// clinical/tenant record like Encounters). One row per checked-in
// appointment (created at check-in, not at booking).
model QueueEntries {
  id                String    @id @default(uuid())
  appointment_id    String    @unique
  clinic_id         String
  clinician_id      String
  token_no          Int?
  // waiting | called | in_progress | done | skipped | no_show. Free-text,
  // matching Appointments.status' own established additive-convention style
  // rather than a Postgres enum (REQ042's precedent).
  status            String    @default("waiting")
  checked_in_at     DateTime  @default(now())
  called_at         DateTime?
  // US-QUE-05: set when skipped/parked; null otherwise. served_since_skip
  // counts other patients served on this clinician's queue since the skip,
  // and the entry auto-returns to 'waiting' once it reaches
  // skip_return_after -- see queue.service.ts's recordServed().
  skip_return_after Int?
  served_since_skip Int       @default(0)
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  appointment Appointments @relation(fields: [appointment_id], references: [id])
  clinic      Clinics      @relation(fields: [clinic_id], references: [id])
  clinician   Clinicians   @relation(fields: [clinician_id], references: [id])
  events      QueueEvents[]

  @@index([clinic_id, status])
  @@index([clinician_id, status])
}

// Append-only audit trail for queue actions, mirroring AppointmentStatusLogs.
model QueueEvents {
  id                 String   @id @default(uuid())
  queue_entry_id     String
  // checked_in | called | recalled | skipped | auto_recalled | transferred |
  // started | completed | no_show
  action             String
  reason             String?
  changed_by_user_id String?
  created_at         DateTime @default(now())

  queue_entry QueueEntries  @relation(fields: [queue_entry_id], references: [id], onDelete: Cascade)
  changed_by  UserProfiles? @relation("QueueEventChangedBy", fields: [changed_by_user_id], references: [id])

  @@index([queue_entry_id, created_at])
}

model AuditLogs {
  id         String   @id @default(uuid())
  user_id    String?
  action     String
  resource   String
  resource_id String?
  details    Json     @default("{}")
  ip_address String?
  // Nullable: existing rows predate both columns and genuinely have no
  // known value -- null means "not recorded", not a backfilled guess.
  outcome    String?
  user_agent String?
  is_deleted Boolean  @default(false)
  created_at DateTime @default(now())
  // REQ053 (US-SEC-06) — set only while user_id's session is an active
  // impersonation. user_id is the REAL actor (AuditLogInterceptor logs
  // real_actor_id ?? sub, never the impersonated identity); this column
  // records who was being impersonated, satisfying "tagged with both the
  // agent's and the target user's identity" without a schema rewrite.
  acting_as_user_id String?

  user      Users? @relation("AuditLogUser", fields: [user_id], references: [id])
  acting_as Users? @relation("AuditLogActingAs", fields: [acting_as_user_id], references: [id])

  @@index([user_id, created_at])
  @@index([resource, resource_id])
  @@index([created_at])
}

model ClientOrganizations {
  id            String   @id @default(uuid())
  name          String
  code          String   @unique
  contact_email String
  contact_phone String?
  address       String?
  // Structured India address ({line1, line2, city, state, pincode, country}) —
  // same shape as Patients.address_structured. TC-ADMIN-UNIT-013/API-011 spec
  // this explicitly; the legacy flat `address` column above is kept unused
  // rather than dropped, since nothing else in the schema reads it.
  address_structured Json?
  is_active     Boolean  @default(true)
  is_deleted    Boolean  @default(false)
  settings      Json     @default("{}")
  // Self-serve SaaS onboarding
  owner_user_id     String?          // the user who signed up / owns billing for this tenant
  onboarding_status OnboardingStatus @default(pending)
  onboarding_step   String?          // e.g. "org_details" | "plan_selected" | "first_clinic_added" | "team_invited" — resumable wizard
  trial_ends_at     DateTime?
  onboarded_at      DateTime?
  // admin/Communications.jsx "Global Settings" tab — Email half only. The
  // SMS half (provider select + raw API key) is deliberately not modeled:
  // it contradicts CLAUDE.md's fixed-vendor rule (MSG91/Gupshup, not an
  // org-configurable Twilio/Vonage) -- see context/open-questions.md #6.
  // These configure the sender identity used *within* the fixed AWS SES
  // pipeline, not an alternate vendor.
  email_from_name        String  @default("HealthSync")
  email_from_address     String? // falls back to the platform default (noreply@) when null
  email_reply_to         String?
  email_include_branding Boolean @default(true)
  // P1-01/REQ144 — admin/Communications.jsx "Global Settings" tab, WhatsApp
  // conversation-spend card. Null means no cap configured (spend is tracked
  // and shown, but nothing is ever blocked) -- this is a visibility control
  // for now, not an enforcement point; P1-04's entitlement guard is the
  // future consumer that would actually act on it. Paise, same convention
  // as no_show_fee_paise above; NotificationBillingService converts its own
  // internal micro-rupee spend total to paise-comparable rupees only at
  // this same resolver boundary when computing "remaining".
  whatsapp_monthly_cap_paise Int?
  // admin/Policies.jsx "Booking Policies" tab. Cancellation Policy/Late Fee
  // sliders are deliberately not modeled here -- they conceptually overlap
  // with ProductCancellationRules' global-rule support, see
  // context/open-questions.md #7. No-show is a genuinely distinct trigger
  // (non-attendance, not cancellation) with no equivalent there.
  no_show_fee_paise         Int @default(8500)
  slot_buffer_minutes       Int @default(10)
  max_reschedules_per_month Int @default(3)
  data_retention_years      Int @default(7)
  // REQ052 (US-BOOK-04) — the auto-no-show sweep's own configurable grace
  // period, and the repeat-no-show count that forces prepayment on a
  // patient's next booking regardless of the service's own
  // prepayment_policy. See appointments.service.ts's create().
  no_show_grace_minutes        Int @default(30)
  no_show_prepayment_threshold Int @default(3)
  // REQ056 (US-BIL-03) — a counter-payment discount at or below this
  // amount is applied inline by recordCounterPayment (self-service, no
  // approval needed); above it, the discount is queued as a
  // DiscountApprovalRequests row instead, requiring a distinct
  // manager+-gated approveDiscountRequest call before any payment is
  // recorded. Default ₹1000 (100000 paise).
  discount_approval_threshold_paise Int @default(100000)
  // admin/Policies.jsx "Security & Privacy" tab (REQ012). All five toggles
  // now have real enforcement, not just persisted config:
  // - mfa_required: checked in auth.service.ts's issueTokens() for every
  //   non-patient role in this org; flags AuthPayload.mfa_setup_required
  //   rather than blocking login outright (a user who can't log in at all
  //   has no way to reach the 2FA enrollment screen that requires being
  //   logged in -- see PLAN021).
  // - session_timeout_minutes: read by the frontend once after login
  //   (myOrgSecuritySettings) to drive a real client-side idle-activity
  //   timer -- distinct from the JWT's own fixed access/refresh TTLs.
  // - audit_log_enabled: gates the new global AuditLogInterceptor (logs
  //   every GraphQL mutation) per-org; org-less callers (admin/super_admin)
  //   are always logged regardless, matching this schema's existing
  //   "org-less caller sees/does everything" precedent.
  // - patient_data_export_enabled: gates a real GDPR Art.20 data-export
  //   query for patient callers.
  // - ip_whitelist_enabled/ip_whitelist: enforced by IpWhitelistGuard
  //   against manager-role callers of this same org (admin/super_admin are
  //   platform-wide/org-less and can't be scoped to any one org's list).
  mfa_required                 Boolean @default(false)
  session_timeout_minutes      Int?
  audit_log_enabled            Boolean @default(false)
  patient_data_export_enabled  Boolean @default(false)
  ip_whitelist_enabled         Boolean @default(false)
  ip_whitelist                 String? // newline- or comma-separated IPs/CIDR ranges
  // Settings -> Clinic -> Branding (REQ002/PLAN022). Propagated to AppShell's
  // sidebar/top-nav header (logo + org name) for every JWT with a non-null
  // client_org_id -- see PLAN022 for why email/invoice/favicon propagation
  // and plan-tier gating are explicitly not built yet. Colors default to the
  // platform's own existing teal (AppShell.jsx TEAL/TEAL_LIGHT) so an org
  // that never customizes branding renders identically to today.
  logo_url        String?
  primary_color   String  @default("#006D77")
  // #00858F (the platform's own decorative TEAL_LIGHT, used widely in
  // frontend gradients) fails this pass's own WCAG AA contrast check
  // against white by a hair (4.42:1, needs 4.5:1) -- found live while
  // testing updateMyOrgBranding against a never-customized org. #007680 is
  // the nearest passing shade (5.38:1); this column's default is the only
  // thing changed, not the sitewide TEAL_LIGHT constant, since
  // secondary_color isn't wired into any rendered surface this pass (see
  // PLAN022) -- purely a stored value a manager must be able to re-save
  // without hitting a rejection on a default they never touched.
  secondary_color String  @default("#007680")
  // REQ024 (US-MSG-04) — org-configurable clinical hours for the
  // patient<->clinic messaging auto-responder. "HH:MM" strings, same shape
  // and IST-implicit convention as NotificationPreferences' own
  // quiet_hours_start/end (see notification-trigger.service.ts). Null
  // start/end or a null auto-reply message means the auto-responder is
  // off — an org must explicitly configure all three before anything
  // fires, matching this schema's own "off by default" convention for
  // every optional behavioral toggle.
  clinical_hours_start             String?
  clinical_hours_end               String?
  clinical_hours_auto_reply_message String?
  // P1-04 — the entitlement guard's own read path. Nullable: today, no
  // real org has one assigned yet (this is a new mechanism, not a
  // backfilled one), and EntitlementsService treats a null plan_id as
  // "ungated" (every feature flag true, no quota enforced) rather than
  // "blocked" — the same fail-open-for-legacy-rows precedent this
  // schema already uses for pre-org-linkage records elsewhere (see
  // orgScope()'s own doc comment). This is distinct from the OLDER
  // OrganizationSubscriptions/SubscriptionPlans pair above (the
  // self-serve-onboarding billing record) — this links to the newer,
  // versioned Plans/PlanVersions catalog (REQ032) that actually carries
  // feature_flags_json/quotas_json, the real entitlement source.
  plan_id       String?
  created_at    DateTime @default(now())
  updated_at    DateTime @default(now())

  plan                   Plans?    @relation(fields: [plan_id], references: [id])
  owner                  Users?    @relation("OrganizationOwner", fields: [owner_user_id], references: [id])
  clinics                Clinics[]
  organizationSubs       OrganizationSubscriptions[]
  user_profiles          UserProfiles[]
  stripe_configurations  StripeConfigurations?
  paymentTransactions    PaymentTransactions[]
  messageThreads         MessageThreads[]
  customRoles            UserRoles[]
  cancellationRules      ProductCancellationRules[]
  appointmentPayments    AppointmentPayments[]
  discountApprovalRequests DiscountApprovalRequests[]
  cashDrawerCloseouts    CashDrawerCloseouts[]
  products               Products[]
  patients               Patients[]
  productCategories      ProductCategories[]
  productSubcategories   ProductSubcategories[]
  drugs                  Drugs[]
  notificationProviderConfigs NotificationProviderConfig[]
  resources              Resources[]
  departments            Departments[]
  encounters             Encounters[]
  encounterTemplates     EncounterTemplates[]
  prescriptionSets       PrescriptionSets[]
  bookingWidgetConfigs   BookingWidgetConfig[]
  consents               Consents[]
  rightsRequests         RightsRequests[]
  retentionPolicies      RetentionPolicies[]
  payerTariffs           PayerTariffs[]
  webhookEndpoints       WebhookEndpoints[]
  payerEmpanelments      PayerEmpanelments[]
  patientInsurancePolicies PatientInsurancePolicies[]
  apiKeys                ApiKeys[]
  scheduledReports       ScheduledReports[]
  drugBatches            DrugBatches[]
  breakGlassGrants       BreakGlassGrants[]
  impersonationSessions  ImpersonationSessions[]
  packages               Packages[]
  patientPackages        PatientPackages[]
  productBranchOverrides ProductBranchOverrides[]
  cannedReplies          CannedReplies[]
  tasks                  Tasks[]
}

model ClinicianAvailability {
  id                String   @id @default(uuid())
  clinician_id      String
  clinic_id         String
  day_of_week       Int?     // 0-6 (Sunday-Saturday) for weekly recurring
  start_time        String   // HH:MM format
  end_time          String   // HH:MM format
  recurrence_type   String   @default("weekly") // daily, weekly, monthly, custom
  custom_dates      String?  // JSON array of dates for custom recurrence
  exclude_weekends  Boolean  @default(false)
  exclude_saturday  Boolean  @default(false)
  exclude_sunday    Boolean  @default(false)
  excluded_days     String?  // JSON array of day numbers (0-6) to exclude
  valid_from        DateTime @default(now())
  valid_until       DateTime?
  is_active         Boolean  @default(true)
  is_deleted        Boolean  @default(false)
  created_at        DateTime @default(now())
  updated_at        DateTime @default(now()) @updatedAt
  room_id           String?
  // REQ017 (dual-mode scheduling): 'slot' (existing, default, unchanged
  // behavior) | 'session' | 'hybrid'. capacity/overbook_allowance only
  // apply to session/hybrid; walkin_ratio is schema-only for now — the
  // hybrid walk-in interleaving algorithm itself is P1, not built yet.
  mode               String  @default("slot")
  capacity           Int?
  overbook_allowance Int     @default(0)
  walkin_ratio       Int?

  clinician Clinicians @relation(fields: [clinician_id], references: [id])
  clinic    Clinics    @relation(fields: [clinic_id], references: [id])
  room      Rooms?     @relation(fields: [room_id], references: [id])

  @@index([clinician_id, is_deleted])
  @@index([clinic_id, is_deleted])
  @@index([room_id])
}


model Clinicians {
  id             String   @id @default(uuid())
  clinic_id      String
  first_name     String
  last_name      String
  clinician_type String
  gender         String?
  email          String   @unique
  phone          String
  // frontend/src/graphql/queries.js CLINICIAN_FIELDS fragment — none of these
  // three existed on this model before this increment (context/backend-hard-rules.md Rule 9).
  bio               String?
  avatar_url        String?
  consultation_fee  Int?     // paise — GraphQL exposes this as rupees, converted at the resolver
  // REQ021 — absent from this model entirely before this slice; needed on
  // a printed prescription's letterhead per the requirement's own
  // acceptance criteria. Both nullable: most seeded clinicians won't have
  // one set yet, matching bio/avatar_url's own nullability.
  registration_number String?
  qualifications       String?
  // REQ015 (US-SEC-07) — the council registration_number was captured for
  // (e.g. "Delhi Medical Council"); free text, no council master table yet.
  medical_council      String?
  // unverified (default) | pending | verified | rejected. Only 'verified'
  // renders the public-profile badge — this is an admin-attested interim
  // path (REQ015's own acceptance criteria), not real HPR/NMC API
  // verification, which the requirement doc explicitly defers.
  verification_status  String    @default("unverified")
  verified_at          DateTime?
  // Plain UUID, no Prisma relation — see PLAN065's "actor-reference fields"
  // note: this batch of 8 slices deliberately skips formal Users relations
  // for audit-actor columns to keep the schema change tractable.
  verified_by_user_id  String?
  is_active      Boolean  @default(true)
  is_deleted     Boolean  @default(false)
  created_at     DateTime @default(now())
  // REQ014 (US-ORG-03) — optional specialty grouping, nullable since most
  // existing clinicians predate departments existing at all.
  department_id  String?

  clinic     Clinics      @relation(fields: [clinic_id], references: [id])
  department Departments? @relation(fields: [department_id], references: [id])

  availability        ClinicianAvailability[]
  appointments        Appointments[]
  lunchBreaks         LunchBreaks[]
  spacerBlocks        SpacerBlocks[]
  userProfiles        UserProfiles[]
  clinicianLanguages  ClinicianLanguages[]
  clinicianServices   ClinicianServices[]
  reviews             Reviews[]
  encounters          Encounters[]
  encounterTemplates  EncounterTemplates[]
  prescriptions       Prescriptions[]
  prescriptionSets    PrescriptionSets[]
  queueEntries        QueueEntries[]
  waitlistEntries     WaitlistEntries[]
  // REQ128 -- referrals naming this clinician as the target, not one they authored.
  referralsReceived   Referrals[]

  @@index([clinic_id, is_deleted, is_active])
  @@index([department_id])
}

// CLINICIAN_FIELDS wants `services{id name duration_minutes price}` per clinician
// and SERVICES_QUERY wants `clinicians{id full_name}` per service — no join
// existed between Clinicians and Products before this increment.
model ClinicianServices {
  id           String   @id @default(uuid())
  clinician_id String
  product_id   String
  is_deleted   Boolean  @default(false)
  created_at   DateTime @default(now())

  clinician Clinicians @relation(fields: [clinician_id], references: [id], onDelete: Cascade)
  product   Products   @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([clinician_id, product_id])

  @@index([product_id])
}

// REQ041 -- a partial unique index (migration 20260823040000_clinics_one_
// primary_per_org) enforces at most one is_primary=true, is_deleted=false
// clinic per client_org_id, not expressible declaratively here (Prisma has
// no partial-index/WHERE-clause syntax for @@unique).
model Clinics {
  id           String   @id @default(uuid())
  name         String
  address      String
  // frontend/src/graphql/queries.js CLINICS_QUERY requests these as flat scalar
  // fields (not a structured JSON blob like Patients.address_structured) — matched
  // exactly per context/backend-hard-rules.md Rule 9. `postcode` naming and the
  // frontend form's 'Europe/London' timezone default are flagged as a follow-up
  // fix, not silently changed here (see context/phase4-catalog-modules-implementation-plan.md).
  city         String?
  postcode     String?
  // REQ101 — supplier-side GST fields. Both null until an admin configures
  // them; AppointmentPayments' own GST split stays null (not guessed)
  // until both this clinic's gstin AND the paid product's gst_rate are
  // set. `state` is also place_of_supply's only source — Clinics has
  // never had one before this.
  state        String?
  gstin        String?
  timezone     String?  @default("Asia/Kolkata")
  phone        String
  email        String
  is_primary   Boolean  @default(false)
  is_active    Boolean  @default(true)
  is_deleted   Boolean  @default(false)
  created_at   DateTime @default(now())
  client_org_id String?

  client_organization ClientOrganizations? @relation(fields: [client_org_id], references: [id])

  clinicians         Clinicians[]
  rooms              Rooms[]
  resources          Resources[]
  departments        Departments[]
  availability       ClinicianAvailability[]
  lunchBreaks        LunchBreaks[]
  spacerBlocks       SpacerBlocks[]
  blocks             RoomBlocks[]
  appointments       Appointments[]
  userProfiles       UserProfiles[]
  products           Products[]
  productCategories  ProductCategories[]
  productSubcategories ProductSubcategories[]
  reviews            Reviews[]
  cancellationRules  ProductCancellationRules[]
  payments           AppointmentPayments[]
  discountApprovalRequests DiscountApprovalRequests[]
  cashDrawerCloseouts CashDrawerCloseouts[]
  invoiceSequences   InvoiceSequences[]
  queueEntries       QueueEntries[]
  drugBatches        DrugBatches[]
  payerEmpanelments  PayerEmpanelments[]
  bookingWidgetConfigs BookingWidgetConfig[]
  scheduledReports   ScheduledReports[]
  checklistItems     ChecklistItems[]
  intakeFieldConfigs ClinicIntakeFieldConfig[]
  packages           Packages[]
  patientPackages    PatientPackages[]
  productBranchOverrides ProductBranchOverrides[]
  messageThreads     MessageThreads[]
  waitlistEntries    WaitlistEntries[]

  @@index([client_org_id, is_deleted])
}

model EmailTemplates {
  id            String       @id @default(uuid())
  name          String
  template_type TemplateType
