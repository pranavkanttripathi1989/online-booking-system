generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//
// ENUMS
//

// Realigned to admin/EmailTemplates.jsx's actual values (context/backend-hard-rules.md
// Rule 9) — zero code anywhere referenced the previous placeholder values, confirmed
// via grep before renaming. otp/review_request from earlier planning aren't dropped
// from the roadmap, just not modeled here until something real needs them this way.
enum TemplateType {
  appointment_confirmation
  appointment_reminder
  appointment_cancellation
  appointment_rescheduled
  password_reset
  welcome
  invoice
  cancellation_fee
}

enum NotificationType {
  appointment
  system
  payment
  alert
}

// settings/index.jsx's Notifications tab (REQ005) — one row per (user, event
// type) rather than a JSON blob, matching the DB-normalization precedent
// already set project-wide. Values match NOTIF_ROWS' 7 fixed event kinds.
enum NotificationEventType {
  new_appointment
  appointment_reminder
  appointment_cancelled
  new_message
  new_review
  payment_received
  system_announcement
}

enum NotificationPriority {
  low
  medium
  high
}

enum ProductType {
  simple
  variable
}

enum RuleType {
  cancellation
  reschedule
}

enum FeeType {
  fixed
  percentage
}

enum SubscriptionStatus {
  active
  cancelled
  expired
  trial
}

enum TestResultStatus {
  pending
  processing
  completed
}

enum OnboardingStatus {
  pending       // org row created, wizard not yet started or abandoned mid-way
  in_progress   // wizard started, not all required steps done
  completed     // owner finished onboarding — org is fully usable
}

enum BillingCycle {
  monthly
  yearly
}

enum RecurrenceType {
  single
  daily
  weekly
  monthly
  custom
}

//
// MODELS
//

model ClinicianTypeModel {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now())

  @@map("clinician_types")
}

model RoomTypeModel {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now())

  @@map("room_types")
}

model Appointments {
  id                  String   @id @default(uuid())
  clinic_id           String
  room_id             String
  clinician_id        String
  patient_id          String
  appointment_date    DateTime
  appointment_time    DateTime
  duration_minutes    Int      @default(30)
  status              String   @default("scheduled")
  reason              String
  notes               String   @default("")
  is_deleted          Boolean  @default(false)
  created_at          DateTime @default(now())
  updated_at          DateTime @default(now())
  product_id          String?
  product_variation_id String?
  // AppointmentFields fragment (frontend/src/graphql/queries.js) requests these
  // three — none existed before the Appointments-domain increment (backend-hard-rules.md Rule 9).
  cancellation_reason String?
  reminder_sent_at    DateTime?
  booked_by_user_id   String?
  // calendar/index.jsx's type filter and video/index.jsx's getAppointment
  // both expect an appointment "type" (in_person/video/home_visit) — no
  // column existed for it (a pre-existing gap flagged in the master plan).
  type                String?  @default("in_person")

  clinic              Clinics               @relation(fields: [clinic_id], references: [id])
  room                Rooms                 @relation(fields: [room_id], references: [id])
  clinician           Clinicians            @relation(fields: [clinician_id], references: [id])
  patient             Patients              @relation(fields: [patient_id], references: [id])
  product             Products?             @relation(fields: [product_id], references: [id])
  product_variation   ProductVariations?    @relation(fields: [product_variation_id], references: [id])
  booked_by_user      UserProfiles?         @relation("AppointmentBookedBy", fields: [booked_by_user_id], references: [id])
  reviews             Reviews[]
  status_logs         AppointmentStatusLogs[]
  payments            AppointmentPayments[]
}

// APPOINTMENT_DETAIL_QUERY (frontend/src/graphql/queries.js) requests
// appointment.status_logs{...} — append-only, written inside every
// status-changing resolver via $transaction (backend-hard-rules.md Rule 5).
model AppointmentStatusLogs {
  id                String   @id @default(uuid())
  appointment_id    String
  status            String
  reason            String?
  changed_by_user_id String?
  created_at        DateTime @default(now())

  appointment     Appointments  @relation(fields: [appointment_id], references: [id])
  changed_by_user UserProfiles? @relation("StatusLogChangedBy", fields: [changed_by_user_id], references: [id])
}

model AuditLogs {
  id         String   @id @default(uuid())
  user_id    String?
  action     String
  resource   String
  resource_id String?
  details    Json     @default("{}")
  ip_address String?
  is_deleted Boolean  @default(false)
  created_at DateTime @default(now())

  user Users? @relation(fields: [user_id], references: [id])
}

model ClientOrganizations {
  id            String   @id @default(uuid())
  name          String
  code          String   @unique
  contact_email String
  contact_phone String?
  address       String?
  // Structured India address ({line1, line2, city, state, pincode, country}) —
  // same shape as Patients.address_structured. TC-ADMIN-UNIT-013/API-011 spec
  // this explicitly; the legacy flat `address` column above is kept unused
  // rather than dropped, since nothing else in the schema reads it.
  address_structured Json?
  is_active     Boolean  @default(true)
  is_deleted    Boolean  @default(false)
  settings      Json     @default("{}")
  // Self-serve SaaS onboarding
  owner_user_id     String?          // the user who signed up / owns billing for this tenant
  onboarding_status OnboardingStatus @default(pending)
  onboarding_step   String?          // e.g. "org_details" | "plan_selected" | "first_clinic_added" | "team_invited" — resumable wizard
  trial_ends_at     DateTime?
  onboarded_at      DateTime?
  // admin/Communications.jsx "Global Settings" tab — Email half only. The
  // SMS half (provider select + raw API key) is deliberately not modeled:
  // it contradicts CLAUDE.md's fixed-vendor rule (MSG91/Gupshup, not an
  // org-configurable Twilio/Vonage) -- see context/open-questions.md #6.
  // These configure the sender identity used *within* the fixed AWS SES
  // pipeline, not an alternate vendor.
  email_from_name        String  @default("HealthSync")
  email_from_address     String? // falls back to the platform default (noreply@) when null
  email_reply_to         String?
  email_include_branding Boolean @default(true)
  // admin/Policies.jsx "Booking Policies" tab. Cancellation Policy/Late Fee
  // sliders are deliberately not modeled here -- they conceptually overlap
  // with ProductCancellationRules' global-rule support, see
  // context/open-questions.md #7. No-show is a genuinely distinct trigger
  // (non-attendance, not cancellation) with no equivalent there.
  no_show_fee_paise         Int @default(8500)
  slot_buffer_minutes       Int @default(10)
  max_reschedules_per_month Int @default(3)
  data_retention_years      Int @default(7)
  // admin/Policies.jsx "Security & Privacy" tab (REQ012). All five toggles
  // now have real enforcement, not just persisted config:
  // - mfa_required: checked in auth.service.ts's issueTokens() for every
  //   non-patient role in this org; flags AuthPayload.mfa_setup_required
  //   rather than blocking login outright (a user who can't log in at all
  //   has no way to reach the 2FA enrollment screen that requires being
  //   logged in -- see PLAN021).
  // - session_timeout_minutes: read by the frontend once after login
  //   (myOrgSecuritySettings) to drive a real client-side idle-activity
  //   timer -- distinct from the JWT's own fixed access/refresh TTLs.
  // - audit_log_enabled: gates the new global AuditLogInterceptor (logs
  //   every GraphQL mutation) per-org; org-less callers (admin/super_admin)
  //   are always logged regardless, matching this schema's existing
  //   "org-less caller sees/does everything" precedent.
  // - patient_data_export_enabled: gates a real GDPR Art.20 data-export
  //   query for patient callers.
  // - ip_whitelist_enabled/ip_whitelist: enforced by IpWhitelistGuard
  //   against manager-role callers of this same org (admin/super_admin are
  //   platform-wide/org-less and can't be scoped to any one org's list).
  mfa_required                 Boolean @default(false)
  session_timeout_minutes      Int?
  audit_log_enabled            Boolean @default(false)
  patient_data_export_enabled  Boolean @default(false)
  ip_whitelist_enabled         Boolean @default(false)
  ip_whitelist                 String? // newline- or comma-separated IPs/CIDR ranges
  created_at    DateTime @default(now())
  updated_at    DateTime @default(now())

  owner                  Users?    @relation("OrganizationOwner", fields: [owner_user_id], references: [id])
  clinics                Clinics[]
  organizationSubs       OrganizationSubscriptions[]
  user_profiles          UserProfiles[]
  stripe_configurations  StripeConfigurations?
  paymentTransactions    PaymentTransactions[]
  messageThreads         MessageThreads[]
  customRoles            UserRoles[]
  cancellationRules      ProductCancellationRules[]
  appointmentPayments    AppointmentPayments[]
  products               Products[]
  productCategories      ProductCategories[]
  productSubcategories   ProductSubcategories[]
  notificationProviderConfigs NotificationProviderConfig[]
}

model ClinicianAvailability {
  id                String   @id @default(uuid())
  clinician_id      String
  clinic_id         String
  day_of_week       Int?     // 0-6 (Sunday-Saturday) for weekly recurring
  start_time        String   // HH:MM format
  end_time          String   // HH:MM format
  recurrence_type   String   @default("weekly") // daily, weekly, monthly, custom
  custom_dates      String?  // JSON array of dates for custom recurrence
  exclude_weekends  Boolean  @default(false)
  exclude_saturday  Boolean  @default(false)
  exclude_sunday    Boolean  @default(false)
  excluded_days     String?  // JSON array of day numbers (0-6) to exclude
  valid_from        DateTime @default(now())
  valid_until       DateTime?
  is_active         Boolean  @default(true)
  is_deleted        Boolean  @default(false)
  created_at        DateTime @default(now())
  updated_at        DateTime @default(now()) @updatedAt
  room_id           String?

  clinician Clinicians @relation(fields: [clinician_id], references: [id])
  clinic    Clinics    @relation(fields: [clinic_id], references: [id])
  room      Rooms?     @relation(fields: [room_id], references: [id])
}


model Clinicians {
  id             String   @id @default(uuid())
  clinic_id      String
  first_name     String
  last_name      String
  clinician_type String
  gender         String?
  email          String   @unique
  phone          String
  // frontend/src/graphql/queries.js CLINICIAN_FIELDS fragment — none of these
  // three existed on this model before this increment (context/backend-hard-rules.md Rule 9).
  bio               String?
  avatar_url        String?
  consultation_fee  Int?     // paise — GraphQL exposes this as rupees, converted at the resolver
  is_active      Boolean  @default(true)
  is_deleted     Boolean  @default(false)
  created_at     DateTime @default(now())

  clinic Clinics @relation(fields: [clinic_id], references: [id])

  availability        ClinicianAvailability[]
  appointments        Appointments[]
  lunchBreaks         LunchBreaks[]
  spacerBlocks        SpacerBlocks[]
  userProfiles        UserProfiles[]
  clinicianLanguages  ClinicianLanguages[]
  clinicianServices   ClinicianServices[]
  reviews             Reviews[]
}

// CLINICIAN_FIELDS wants `services{id name duration_minutes price}` per clinician
// and SERVICES_QUERY wants `clinicians{id full_name}` per service — no join
// existed between Clinicians and Products before this increment.
model ClinicianServices {
  id           String   @id @default(uuid())
  clinician_id String
  product_id   String
  is_deleted   Boolean  @default(false)
  created_at   DateTime @default(now())

  clinician Clinicians @relation(fields: [clinician_id], references: [id], onDelete: Cascade)
  product   Products   @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([clinician_id, product_id])
}

model Clinics {
  id           String   @id @default(uuid())
  name         String
  address      String
  // frontend/src/graphql/queries.js CLINICS_QUERY requests these as flat scalar
  // fields (not a structured JSON blob like Patients.address_structured) — matched
  // exactly per context/backend-hard-rules.md Rule 9. `postcode` naming and the
  // frontend form's 'Europe/London' timezone default are flagged as a follow-up
  // fix, not silently changed here (see context/phase4-catalog-modules-implementation-plan.md).
  city         String?
  postcode     String?
  timezone     String?  @default("Asia/Kolkata")
  phone        String
  email        String
  is_primary   Boolean  @default(false)
  is_active    Boolean  @default(true)
  is_deleted   Boolean  @default(false)
  created_at   DateTime @default(now())
  client_org_id String?

  client_organization ClientOrganizations? @relation(fields: [client_org_id], references: [id])

  clinicians         Clinicians[]
  rooms              Rooms[]
  availability       ClinicianAvailability[]
  lunchBreaks        LunchBreaks[]
  spacerBlocks       SpacerBlocks[]
  blocks             RoomBlocks[]
  appointments       Appointments[]
  userProfiles       UserProfiles[]
  products           Products[]
  productCategories  ProductCategories[]
  productSubcategories ProductSubcategories[]
  reviews            Reviews[]
  cancellationRules  ProductCancellationRules[]
  payments           AppointmentPayments[]
}

model EmailTemplates {
  id            String       @id @default(uuid())
  name          String
  template_type TemplateType
  subject       String
  body          String
  // admin/EmailTemplates.jsx — the allowed {{variable}} tokens for this template;
  // updateEmailTemplate rejects a subject/body using a token outside this list
  // (TC-ADMIN-UNIT-004/API-009). Didn't exist on this model before this increment.
  variables     String[]     @default([])
  is_active     Boolean      @default(true)
  is_deleted    Boolean      @default(false)
  created_at    DateTime     @default(now())
  updated_at    DateTime     @default(now())
}

model LunchBreaks {
  id             String        @id @default(uuid())
  clinician_id   String
  clinic_id      String
  day_of_week    Int?
  start_time     DateTime
  end_time       DateTime
  is_recurring   Boolean       @default(true)
  specific_date  DateTime?
  is_deleted     Boolean       @default(false)
  created_at     DateTime      @default(now())
  recurrence_type RecurrenceType @default(single)
  recurrence_days Json?
  end_date       DateTime?

  clinician Clinicians @relation(fields: [clinician_id], references: [id])
  clinic    Clinics    @relation(fields: [clinic_id], references: [id])
}

model Notifications {
  id         String              @id @default(uuid())
  user_id    String
  title      String
  message    String
  type       NotificationType
  priority   NotificationPriority @default(medium)
  is_read    Boolean             @default(false)
  is_deleted Boolean             @default(false)
  action_url String?
  metadata   Json                @default("{}")
  created_at DateTime            @default(now())

  user Users @relation(fields: [user_id], references: [id])
}

// REQ008/PLAN017 — admin-configurable OTP/SMS provider per org. Deliberately
// its own model, not columns bolted onto ClientOrganizations, since the
// credential shape varies per provider (see backend/src/notifications/providers/)
// and doesn't belong flattened into the org's own row. `channel` is a plain
// string ('sms' today) rather than an enum so a future channel (whatsapp,
// etc.) needs zero schema change — same reasoning for `provider` being a
// registry key, not an enum, so adding a provider is a code change only.
model NotificationProviderConfig {
  id                    String   @id @default(uuid())
  client_org_id         String
  channel               String
  provider              String
  credentials_encrypted String   // AES-256-GCM JSON blob, shape owned by the provider's registry entry
  sender_id             String?  // common display field across most SMS providers; kept denormalized
  is_active             Boolean  @default(true)
  created_at            DateTime @default(now())
  updated_at            DateTime @default(now())

  client_org ClientOrganizations @relation(fields: [client_org_id], references: [id])

  @@unique([client_org_id, channel])
}

model OrganizationSubscriptions {
  id                   String              @id @default(uuid())
  client_org_id        String
  plan_id              String
  status               SubscriptionStatus
  billing_cycle        BillingCycle
  current_period_start DateTime @default(now())
  current_period_end   DateTime
  is_deleted           Boolean  @default(false)
  stripe_customer_id   String?
  stripe_subscription_id String?
  created_at           DateTime @default(now())
  updated_at           DateTime @default(now())

  client_org          ClientOrganizations @relation(fields: [client_org_id], references: [id])
  plan                SubscriptionPlans   @relation(fields: [plan_id], references: [id])
  paymentTransactions PaymentTransactions[] @relation("SubscriptionTransactions")
}

model Patients {
  id                    String   @id @default(uuid())
  first_name            String
  last_name             String
  date_of_birth         DateTime
  email                 String
  phone                 String
  phone_country_code    String?
  address               String
  medical_notes         String   @default("")
  title                 String?
  status                String?
  birth_surname         String?
  birth_name            String?
  birth_names           String?
  social_security_number String?
  gender                String?
  sex                   String?
  google_client_id      String?
  payment_reference     String?
  occupation            String?
  place_of_birth        Json?    // JSON: { city, country }
  phones                Json?    // JSON array: [{ countryCode, number }]
  address_structured    Json?    // JSON: { line1, line2, city, state, pincode, country } — India address format
  is_deleted            Boolean  @default(false)
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  appointments Appointments[]
  userProfiles UserProfiles[]
  reviews      Reviews[]
  testResults  TestResults[]
  payments     AppointmentPayments[]
}

// pages/test-results/index.jsx — built from scratch (zero pre-existing GraphQL
// contract, unlike every other module this session). patient_name/ordered_by_name
// are denormalized because the current Order-Test dialog is a free-text field,
// not a real patient picker; patient_id/ordered_by_user_id are optional FKs added
// for forward compatibility once a Patients module (Phase 6) and a real picker
// exist — see context/test-results-backend-implementation-plan.md.
model TestResults {
  id               String            @id @default(uuid())
  patient_name     String
  patient_id       String?
  test_name        String
  test_type        String
  ordered_by_name  String
  ordered_by_user_id String?
  date_ordered     DateTime          @default(now())
  date_completed   DateTime?
  status           TestResultStatus  @default(pending)
  values           Json              @default("[]") // [{name, value, ref, flag}]
  is_deleted       Boolean           @default(false)
  created_at       DateTime          @default(now())

  patient       Patients?     @relation(fields: [patient_id], references: [id])
  ordered_by    UserProfiles? @relation(fields: [ordered_by_user_id], references: [id])
}

model PaymentTransactions {
  id             String   @id @default(uuid())
  client_org_id  String
  subscription_id String?
  amount         Int      // stored in paise (smallest INR unit) to avoid float rounding
  currency       String   @default("INR")
  status         String
  is_deleted     Boolean  @default(false)
  stripe_payment_intent_id String?
  stripe_invoice_id String?
  razorpay_order_id   String?
  razorpay_payment_id String?
  razorpay_signature  String?
  // GST invoicing fields (India)
  gstin          String?
  hsn_sac_code   String?
  gst_rate       Float?   // e.g. 18.0 for 18%
  cgst_amount    Int?     // paise
  sgst_amount    Int?     // paise
  igst_amount    Int?     // paise
  transaction_date DateTime @default(now())
  metadata       Json     @default("{}")
  created_at     DateTime @default(now())

  client_org    ClientOrganizations        @relation(fields: [client_org_id], references: [id])
  subscription  OrganizationSubscriptions? @relation("SubscriptionTransactions", fields: [subscription_id], references: [id])
}

// REQ004 — real per-appointment PATIENT payments via Razorpay. Deliberately
// separate from PaymentTransactions above, which is scoped to
// ClientOrganizations/OrganizationSubscriptions (tenant SaaS-subscription
// billing only, per CLAUDE.md) and has no appointment_id/patient_id at all --
// retrofitting it would be the wrong shape, not a shortcut. GST fields mirror
// PaymentTransactions' own (nullable, per-transaction -- no org-level GST
// config table exists anywhere in this schema to source from automatically).
model AppointmentPayments {
  id                  String   @id @default(uuid())
  appointment_id      String
  patient_id          String
  clinic_id           String
  client_org_id       String? // derived from clinic at write time; nullable to match Clinics' own optional client_org_id
  amount              Int     // paise
  currency            String  @default("INR")
  status              String  // pending | succeeded | failed
  razorpay_order_id   String?
  razorpay_payment_id String?
  razorpay_signature  String?
  gstin               String?
  hsn_sac_code        String?
  gst_rate            Float?
  cgst_amount         Int?
  sgst_amount         Int?
  igst_amount         Int?
  metadata            Json     @default("{}")
  created_at          DateTime @default(now())
  updated_at          DateTime @default(now())

  appointment Appointments        @relation(fields: [appointment_id], references: [id])
  patient     Patients            @relation(fields: [patient_id], references: [id])
  clinic      Clinics             @relation(fields: [clinic_id], references: [id])
  client_org  ClientOrganizations? @relation(fields: [client_org_id], references: [id])
}

model Reviews {
  id             String   @id @default(uuid())
  appointment_id String
  patient_id     String
  clinician_id   String?
  clinic_id      String?
  stars          Int      // 1-5
  comment        String
  response       String?
  responded_at   DateTime?
  is_deleted     Boolean  @default(false)
  created_at     DateTime @default(now())

  appointment Appointments @relation(fields: [appointment_id], references: [id])
  patient     Patients     @relation(fields: [patient_id], references: [id])
  clinician   Clinicians?  @relation(fields: [clinician_id], references: [id])
  clinic      Clinics?     @relation(fields: [clinic_id], references: [id])
}

model MessageThreads {
  id            String   @id @default(uuid())
  client_org_id String
  last_message  String?
  last_activity DateTime @default(now())
  created_at    DateTime @default(now())

  client_org   ClientOrganizations   @relation(fields: [client_org_id], references: [id])
  participants MessageParticipants[]
  messages     Messages[]
}

model MessageParticipants {
  id         String   @id @default(uuid())
  thread_id  String
  user_id    String
  unread_count Int    @default(0)

  thread MessageThreads @relation(fields: [thread_id], references: [id])
  user   Users          @relation(fields: [user_id], references: [id])

  @@unique([thread_id, user_id])
}

model Messages {
  id         String   @id @default(uuid())
  thread_id  String
  from_id    String
  body       String
  read_at    DateTime?
  sent_at    DateTime @default(now())

  thread MessageThreads @relation(fields: [thread_id], references: [id])
  from   Users          @relation(fields: [from_id], references: [id])
}

model Permissions {
  id          String   @id @default(uuid())
  name        String   @unique
  description String   @default("")
  resource    String
  action      String
  created_at  DateTime @default(now())

  rolePermissions RolePermissions[]
}

// A rule is either clinic-scoped (a clinic-wide default policy) or
// product-scoped (a per-service override) -- exactly one of product_id/
// clinic_id is set, enforced by a CHECK constraint added in this model's
// extension migration (Prisma doesn't model CHECK constraints declaratively,
// so it's hand-written in the migration.sql, not expressed here). Originally
// product-only; admin/Policies.jsx's real, already-written GraphQL contract
// (name/description/priority/clinic_id, no product_id at all) needed the
// clinic-scoped half added rather than building a second, parallel model.
model ProductCancellationRules {
  id                     String      @id @default(uuid())
  name                   String
  description            String?
  product_id             String?
  clinic_id              String?
  client_org_id          String?
  rule_type              RuleType    @default(cancellation)
  hours_before_appointment Int      @default(24)
  fee_type               FeeType
  fee_amount             Int      // paise
  priority               Int        @default(1)
  is_active              Boolean    @default(true)
  is_deleted             Boolean    @default(false)
  created_at             DateTime   @default(now())
  updated_at             DateTime   @default(now())

  product     Products?          @relation(fields: [product_id], references: [id])
  clinic      Clinics?           @relation(fields: [clinic_id], references: [id])
  clientOrg   ClientOrganizations? @relation(fields: [client_org_id], references: [id])
}

model ProductCategories {
  id           String   @id @default(uuid())
  clinic_id    String?
  // BUG001 — Products/Categories/Subcategories never had a client_org_id of
  // their own; every create path left clinic_id null too, so the old
  // clinic-relation tenant filter silently matched nothing for a caller's own
  // rows and skipped the check entirely on findOne. Stamped from the JWT at
  // create time, decoupled from any specific clinic — see BUG001 for why an
  // org-wide catalog is the right model here, not a per-clinic one.
  client_org_id String?
  name         String
  description  String   @default("")
  is_active    Boolean  @default(true)
  is_deleted   Boolean  @default(false)
  created_at   DateTime @default(now())

  clinic            Clinics? @relation(fields: [clinic_id], references: [id])
  client_org        ClientOrganizations? @relation(fields: [client_org_id], references: [id])
  subcategories     ProductSubcategories[]
  products          Products[]
}

model ProductSubcategories {
  id           String   @id @default(uuid())
  clinic_id    String?
  client_org_id String?  // BUG001 — see ProductCategories.client_org_id
  category_id  String
  name         String
  description  String   @default("")
  is_active    Boolean  @default(true)
  is_deleted   Boolean  @default(false)
  created_at   DateTime @default(now())

  clinic    Clinics? @relation(fields: [clinic_id], references: [id])
  client_org ClientOrganizations? @relation(fields: [client_org_id], references: [id])
  category  ProductCategories @relation(fields: [category_id], references: [id])
  products  Products[]
}

model ProductVariations {
  id              String   @id @default(uuid())
  product_id      String
  variation_name  String
  sku             String   @unique
  price           Int      // paise
  duration_minutes Int?    // overrides the parent Product's duration for this variation (e.g. "30 min" vs "60 min" session)
  stock_quantity  Int      @default(0)
  is_active       Boolean  @default(true)
  is_deleted      Boolean  @default(false)
  created_at      DateTime @default(now())

  product Products @relation(fields: [product_id], references: [id])
  appointments Appointments[]
}

model Products {
  id                String   @id @default(uuid())
  clinic_id         String?
  client_org_id     String?  // BUG001 — see ProductCategories.client_org_id
  category_id       String?
  subcategory_id    String?
  name              String
  description       String   @default("")
  product_type      ProductType
  sku               String   @unique
  price             Int?     // paise
  // manager/products/{create,edit}.jsx's real "Stock Qty" field — no column
  // existed for it at all before (context/frontend-integration-audit.md #17-19).
  stock_quantity    Int?     @default(0)
  duration_minutes  Int?     // required for a bookable service (test-cases/08-products-services flagged this as missing — a clinical service needs a duration to generate slots)
  order_by          Int      @default(0)
  is_active         Boolean  @default(true)
  is_deleted        Boolean  @default(false)
  created_at        DateTime @default(now())

  clinic            Clinics? @relation(fields: [clinic_id], references: [id])
  client_org        ClientOrganizations? @relation(fields: [client_org_id], references: [id])
  category          ProductCategories? @relation(fields: [category_id], references: [id])
  subcategory       ProductSubcategories? @relation(fields: [subcategory_id], references: [id])
  variations        ProductVariations[]
  appointments      Appointments[]
  cancellationRules ProductCancellationRules[]
  clinicianServices ClinicianServices[]
}

model RolePermissions {
  id            String   @id @default(uuid())
  role_id       String
  permission_id String
  is_deleted    Boolean  @default(false)
  created_at    DateTime @default(now())

  role       UserRoles   @relation(fields: [role_id], references: [id])
  permission Permissions @relation(fields: [permission_id], references: [id])
}

model RoomBlocks {
  id          String   @id @default(uuid())
  room_id     String
  clinic_id   String
  block_date  DateTime
  start_time  DateTime
  end_time    DateTime
  reason      String   @default("")
  is_recurring Boolean @default(false)
  is_deleted  Boolean  @default(false)
  created_at  DateTime @default(now())
  // manager/Blocks.jsx's roomBlocks query requests these three — mirrors
  // SpacerBlocks' already-existing fields exactly (backend-hard-rules.md Rule 9).
  recurrence_type RecurrenceType @default(single)
  recurrence_days Json?
  end_date        DateTime?

  room   Rooms   @relation(fields: [room_id], references: [id])
  clinic Clinics @relation(fields: [clinic_id], references: [id])
}

model Rooms {
  id          String   @id @default(uuid())
  clinic_id   String
  room_number String
  room_type   String   @default("consultation")
  clinician_type String?
  capacity    Int?     // frontend Create/Edit Room forms require this (test-cases/07-clinics-rooms) — was missing from schema
  is_active   Boolean  @default(true)
  is_deleted  Boolean  @default(false)
  created_at  DateTime @default(now())

  clinic Clinics @relation(fields: [clinic_id], references: [id])
  availability ClinicianAvailability[]
  appointments Appointments[]
  roomBlocks   RoomBlocks[]
  spacerBlocks SpacerBlocks[]
}

model SpacerBlocks {
  id             String        @id @default(uuid())
  clinician_id   String
  clinic_id      String
  room_id        String?
  block_date     DateTime?
  start_time     DateTime
  end_time       DateTime
  reason         String         @default("")
  is_deleted     Boolean        @default(false)
  created_at     DateTime       @default(now())
  recurrence_type RecurrenceType @default(single)
  recurrence_days Json?
  end_date       DateTime?

  clinician Clinicians @relation(fields: [clinician_id], references: [id])
  clinic    Clinics    @relation(fields: [clinic_id], references: [id])
  room      Rooms?     @relation(fields: [room_id], references: [id])
}

model StripeConfigurations {
  id                 String   @id @default(uuid())
  client_org_id      String   @unique
  stripe_account_id  String?
  stripe_publishable_key String?
  stripe_webhook_secret String?
  is_active          Boolean  @default(true)
  is_deleted         Boolean  @default(false)
  created_at         DateTime @default(now())
  updated_at         DateTime @default(now())

  client_organization ClientOrganizations @relation(fields: [client_org_id], references: [id])
}

model SubscriptionPlans {
  id            String   @id @default(uuid())
  name          String   @unique
  description   String
  price_monthly Int      @default(0) // paise
  price_yearly  Int      @default(0) // paise
  max_clinics   Int      @default(1)
  max_users     Int      @default(5)
  features      Json     @default("{}")
  is_active     Boolean  @default(true)
  is_deleted    Boolean  @default(false)
  created_at    DateTime @default(now())

  subscriptions OrganizationSubscriptions[]
}

//
// USERS FROM auth.users TABLE
//

model Users {
  id String @id @default(uuid())

  auditLogs    AuditLogs[]
  notifications Notifications[]
  userProfiles  UserProfiles?
  messageParticipants MessageParticipants[]
  messages      Messages[]
  ownedOrganizations ClientOrganizations[] @relation("OrganizationOwner")
  notificationPreferences NotificationPreferences[]
}

// REQ005 Notifications tab. No code path in this codebase currently reads
// these to decide whether to actually send anything (NotificationsService.create()
// has zero callers today, and there's no real email/SMS sending infra beyond
// the OTP-SMS stub) -- see context/open-questions.md. This table is real,
// persisted storage for the preference itself, not yet wired to a trigger.
model NotificationPreferences {
  id            String                @id @default(uuid())
  user_id       String
  event_type    NotificationEventType
  email_enabled Boolean               @default(true)
  sms_enabled   Boolean               @default(false)
  app_enabled   Boolean               @default(true)
  created_at    DateTime              @default(now())
  updated_at    DateTime              @default(now())

  user Users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, event_type])
}

model UserProfiles {
  id            String   @id
  role_id       String
  first_name    String
  last_name     String
  email         String   @unique
  password      String
  phone         String?  @unique // OTP login requires an unambiguous phone→account lookup
  phone_country_code String?
  address_line1 String?
  address_line2 String?
  city          String?
  postal_code   String?
  country       String?
  user_image    String?
  clinic_id     String?
  clinician_id  String?
  patient_id    String?
  is_active     Boolean  @default(true)
  is_deleted    Boolean  @default(false)
  created_at    DateTime @default(now())
  updated_at    DateTime @default(now())
  client_org_id String?
  // admin/users/index.jsx's getUsers requests lastLoginAt/profile{avatarUrl} —
  // neither existed before the Users/RBAC increment.
  last_login_at DateTime?
  avatar_url    String?
  // staff/{index,edit,new}.jsx — Staff is UserProfiles scoped to non-clinician,
  // non-patient roles, reusing the Users/RBAC module rather than a dedicated
  // Staff table (next-10-features-implementation-plan.md #7). department/
  // job_title/notes/staff_status have no other home in the existing schema.
  department    String?
  job_title     String?
  notes         String?
  staff_status  String?  @default("active")
  // context/open-questions.md #3 — real, backdatable employment start date,
  // distinct from created_at (the row's actual creation timestamp). Null for
  // every staff row created before this column existed; toGraphQL() falls
  // back to created_at for those so `since` is never null in the API.
  staff_since   DateTime?

  // add these for forgot-password
  password_reset_token   String?
  password_reset_expires DateTime?

  email_verified           Boolean   @default(false)
  email_verification_token String?
  email_verification_expires DateTime?

  // PLAN016 (REQ005 remainder) — settings/index.jsx's Profile tab. address_structured
  // matches Patients/ClientOrganizations' exact {line1, line2, city, state, pincode,
  // country} shape (the modern, actively-used convention project-wide) rather than
  // this model's older address_line1/postal_code/no-state columns above, which are
  // never exposed in any GraphQL entity today — no compatibility surface to preserve.
  date_of_birth DateTime?
  gender        String?
  bio           String?
  address_structured Json?

  // PLAN016 Slice C — real TOTP 2FA. Secret and backup codes are always
  // encrypted/hashed at rest, never stored or returned in plaintext.
  totp_secret_encrypted String?
  totp_enabled          Boolean  @default(false)
  totp_backup_codes     Json?    // array of bcrypt-hashed one-time codes

  user        Users                @relation(fields: [id], references: [id])
  role        UserRoles            @relation(fields: [role_id], references: [id])
  clinic      Clinics?             @relation(fields: [clinic_id], references: [id])
  clinician   Clinicians?          @relation(fields: [clinician_id], references: [id])
  patient     Patients?            @relation(fields: [patient_id], references: [id])
  client_org  ClientOrganizations? @relation(fields: [client_org_id], references: [id])
  orderedTestResults TestResults[]
  bookedAppointments Appointments[] @relation("AppointmentBookedBy")
  appointmentStatusLogs AppointmentStatusLogs[] @relation("StatusLogChangedBy")
}

model UserRoles {
  id          String   @id @default(uuid())
  name        String
  description String   @default("")
  // null = platform-wide system role (admin/super_admin/manager/clinician/staff/patient,
  // seeded once, never org-specific); set = an org admin's own custom role
  // (requirements/custom-role-permission-management-requirements.md). Global
  // uniqueness among system roles (client_org_id IS NULL) is enforced at the
  // application layer, not this constraint — Postgres treats NULLs as distinct
  // in a composite unique index, so it wouldn't catch a duplicate among them;
  // in practice only the seed script creates those rows, via upsert.
  client_org_id String?
  is_system   Boolean  @default(false) // system roles can't be renamed/deleted by an org admin
  is_deleted  Boolean  @default(false)
  created_at  DateTime @default(now())
  // admin/users/index.jsx's getUserRoles/getUsers request roles{code} — a
  // short slug ('system_admin', 'clinic_manager', ...) distinct from the
  // display `name`, used client-side to key ROLE_STYLES. Nullable: falls back
  // to a slugified `name` at the resolver boundary when unset (users.service.ts).
  code        String?

  client_org      ClientOrganizations? @relation(fields: [client_org_id], references: [id])
  rolePermissions RolePermissions[]
  userProfiles   UserProfiles[]

  @@unique([client_org_id, name], name: "org_role_name", map: "org_role_name")
}

model Languages {
  id         String   @id @default(uuid())
  name       String   @unique
  code       String   @unique
  is_active  Boolean  @default(true)
  // admin/Languages.jsx (TC-ADMIN-UNIT-010/API-014): exactly one language is
  // ever the default — enforced in the service via a $transaction, not a DB constraint.
  is_default Boolean  @default(false)
  is_deleted Boolean  @default(false)
  created_at DateTime @default(now())

  clinicianLanguages ClinicianLanguages[]
}

model ClinicianLanguages {
  id            String   @id @default(uuid())
  clinician_id  String
  language_id   String
  is_deleted    Boolean  @default(false)
  created_at    DateTime @default(now())

  clinician Clinicians @relation(fields: [clinician_id], references: [id], onDelete: Cascade)
  language  Languages  @relation(fields: [language_id], references: [id], onDelete: Cascade)

  @@unique([clinician_id, language_id])
}
