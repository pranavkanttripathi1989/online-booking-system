generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//
// INDEX POLICY (F-13, BUG005 — migration 20260822130000_add_indexes)
//
// The 69 @@index declarations below were derived by reading the real `where` and
// `orderBy` clauses in backend/src/**/*.service.ts, then measured with
// EXPLAIN (ANALYZE, BUFFERS) on a scratch database seeded to 50,000 appointments.
// Four rules came out of that measurement. Follow them when adding a model:
//
//   1. Equality columns first, range/sort column last, so one index serves both
//      the filter and the ordering and the sort node leaves the plan.
//   2. Never lead a composite with client_org_id, and never index it alone. The
//      tenant predicate matches ~20% of rows, so a sequential scan is genuinely
//      optimal and the planner correctly ignores such an index (measured:
//      identical buffer counts with and without). Lead with the selective
//      column - clinician_id, clinic_id, patient_id.
//
//      The exception, and it is a real one: an unselective leading column is
//      still worth indexing when the TRAILING column supplies the sort order for
//      a LIMIT. Appointments(is_deleted, appointment_time) leads with a boolean
//      that is false for ~all rows, and the planner uses it anyway - measured, an
//      Index Scan Backward at 130 buffers instead of a 2,753-buffer sequential
//      scan plus a 50,000-row sort - because it can walk in appointment_time
//      order and stop at the LIMIT. Selectivity is one reason to index; ordered
//      access for a paginated list is another. client_org_id has neither here,
//      because it is not even a column on Appointments (it is joined through
//      Clinics), so no index on this table can serve it.
//   3. Do not blanket-index every foreign key. That yields ~120 indexes here
//      instead of 69, most never used, each paying write amplification forever.
//      Index a bare FK only where a query filters on it alone.
//   4. Small global reference tables (Languages, RoomTypes, ClinicianTypes,
//      EmailTemplates) get none - an index scan is slower than scanning two pages.
//
// Note Appointments carries both appointment_date and appointment_time; the
// services overwhelmingly use appointment_time, so the composites follow the code.
//
// Nothing enforces this policy in CI yet - see BUG005 follow-ups.
//

//
// ENUMS
//

// Realigned to admin/EmailTemplates.jsx's actual values (context/backend-hard-rules.md
// Rule 9) — zero code anywhere referenced the previous placeholder values, confirmed
// via grep before renaming. otp/review_request from earlier planning aren't dropped
// from the roadmap, just not modeled here until something real needs them this way.
enum TemplateType {
  appointment_confirmation
  appointment_reminder
  appointment_cancellation
  appointment_rescheduled
  password_reset
  welcome
  invoice
  cancellation_fee
}

enum NotificationType {
  appointment
  system
  payment
  alert
}

// settings/index.jsx's Notifications tab (REQ005) — one row per (user, event
// type) rather than a JSON blob, matching the DB-normalization precedent
// already set project-wide. Values match NOTIF_ROWS' 7 fixed event kinds.
enum NotificationEventType {
  new_appointment
  appointment_reminder
  appointment_cancelled
  new_message
  new_review
  payment_received
  system_announcement
  // REQ053 (US-SEC-05) — break-glass.service.ts's request() already called
  // dispatch(admin.id, 'break_glass_requested', ...) without this value
  // ever existing here; Prisma's runtime enum validation rejected every
  // such call, throwing out of the awaited Promise.all and failing the
  // entire requestBreakGlassAccess mutation for orgs with any admin/
  // manager to notify. Found live via a real e2e run, not a code review.
  break_glass_requested
  // REQ022 (US-PHR-09, scoped) — a drug's total remaining stock has crossed
  // at or below its own configured reorder_level.
  low_stock_alert
  // REQ106 — a cancellation/no-show freed a slot for the earliest waiting
  // entry on that clinician/date. Added in its own separate migration,
  // applied before any code references it — the exact break_glass_requested
  // precedent above (a missing enum value crashes the whole dispatch call).
  waitlist_slot_available
  // REQ167 (P2-11) — a patient (or their guardian) has an overdue or
  // soon-due immunization per the National Immunization Schedule. Added in
  // its own separate migration, applied before any code references it —
  // the exact break_glass_requested/low_stock_alert precedent above.
  immunization_due
  // REQ168 (P2-12) — a patient enrolled in a chronic-disease registry
  // (diabetes/hypertension) has fallen overdue for their recall review.
  // Notifies org staff, not the patient (the reverse of immunization_due).
  // Added in its own separate migration, same precedent as above.
  chronic_registry_recall_due
  // REQ179 (IPD slice 1) — in-patient ADT events. All four added in their own
  // migration (20260902100000_notification_events_ipd_core), applied before
  // any code referenced them, same precedent as every value above.
  patient_admitted
  patient_discharged
  bed_transfer_recorded
  // Statutory: a medico-legal case has been registered and the 24h police
  // intimation has not yet been recorded. Belongs in QUIET_HOURS_BYPASS_EVENTS
  // — a legal clock does not respect an org's quiet hours.
  mlc_police_intimation_due
  // REQ179 (IPD slice 5) — the running IPD bill has crossed 80% of the
  // admission's own currently authorized total; the insurance desk needs
  // to request an enhancement before authorization is exhausted. Added in
  // its own separate migration, applied before any code references it —
  // the exact break_glass_requested/low_stock_alert precedent above.
  preauth_enhancement_needed
}

enum NotificationPriority {
  low
  medium
  high
}

enum ProductType {
  simple
  variable
}

enum RuleType {
  cancellation
  reschedule
}

enum FeeType {
  fixed
  percentage
}

enum SubscriptionStatus {
  active
  cancelled
  expired
  trial
}

enum TestResultStatus {
  pending
  processing
  completed
}

enum OnboardingStatus {
  pending       // org row created, wizard not yet started or abandoned mid-way
  in_progress   // wizard started, not all required steps done
  completed     // owner finished onboarding — org is fully usable
}

enum BillingCycle {
  monthly
  yearly
}

enum RecurrenceType {
  single
  daily
  weekly
  monthly
  custom
}

//
// MODELS
//

model ClinicianTypeModel {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now())

  @@map("clinician_types")
}

model RoomTypeModel {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now())

  @@map("room_types")
}

// Two Postgres EXCLUDE constraints (GiST, requires btree_gist) prevent two
// non-cancelled, non-deleted, booking_mode='slot' rows from having
// overlapping [appointment_time, appointment_time + duration_minutes)
// ranges for the same clinician_id, and separately for the same room_id --
// added in this model's own migrations (20260823030000/20260823031500_
// ..._exclusion_constraint, narrowed to booking_mode='slot' by REQ017's
// migration), not expressible declaratively here (Prisma has no
// EXCLUDE-constraint syntax). This is the P3.1/F-16 fix for
// booking-concurrency.int-spec.ts: the application-level assertSlotFree()
// check and the later create() are two separate statements, so N
// concurrent requests could all pass the check before any of them wrote --
// the database itself is now the only thing that can make "is this slot
// free" atomic. The room constraint is a data-integrity backstop only --
// create()'s own room *selection* still has no availability check at all
// (see open question #14). Session/hybrid mode (booking_mode != 'slot')
// deliberately falls outside both constraints -- many tokens in one
// session legitimately share the same clinician/room/time; that mode's
// capacity guarantee is a pg_advisory_xact_lock-guarded count check in
// appointments.service.ts instead (REQ017).
model Appointments {
  id                  String   @id @default(uuid())
  clinic_id           String
  room_id             String
  clinician_id        String
  patient_id          String
  appointment_date    DateTime
  appointment_time    DateTime
  duration_minutes    Int      @default(30)
  status              String   @default("scheduled")
  reason              String
  notes               String   @default("")
  is_deleted          Boolean  @default(false)
  created_at          DateTime @default(now())
  updated_at          DateTime @default(now())
  product_id          String?
  product_variation_id String?
  // AppointmentFields fragment (frontend/src/graphql/queries.js) requests these
  // three — none existed before the Appointments-domain increment (backend-hard-rules.md Rule 9).
  cancellation_reason String?
  reminder_sent_at    DateTime?
  // P1-17 — reminder_sent_at alone can't express "how many reminders",
  // needed since a high no-show-risk appointment gets an extra early
  // reminder on top of the standard one (AppointmentReminderSweepService).
  reminder_count      Int       @default(0)
  booked_by_user_id   String?
  // calendar/index.jsx's type filter and video/index.jsx's getAppointment
  // both expect an appointment "type" (in_person/video/home_visit) — no
  // column existed for it (a pre-existing gap flagged in the master plan).
  type                String?  @default("in_person")
  // REQ017: denormalized copy of the matching ClinicianAvailability.mode at
  // booking time. Exists so the two overlap-exclusion constraints below can
  // exclude session/hybrid rows via their WHERE clause — many tokens in one
  // session legitimately share the same clinician/room/start time, which
  // the constraints must NOT reject; session/hybrid capacity is enforced in
  // application code instead (pg_advisory_xact_lock-guarded count check in
  // appointments.service.ts), a different but equally real guarantee.
  booking_mode        String   @default("slot")
  // Sequential 1..N within one session/hybrid window. Null for slot mode.
  token_no            Int?
  // REQ052 (US-BOOK-06) — { [field_key]: response value } for whatever
  // ClinicIntakeFieldConfig items applied at booking time. Exposed via
  // GraphQL as a structured [IntakeFieldResponseType!] list (this
  // codebase's convention for every other Json column), never a raw scalar.
  intake_responses    Json?
  // REQ107 — same shape as Users.password_reset_token/password_reset_expires
  // (auth.service.ts): only the SHA-256 hash is ever persisted, the raw
  // token is returned once, at generation time, and never again.
  // checkin_token_used_at makes the token single-use, cleared atomically
  // with the checked_in status write.
  checkin_token_hash       String?   @unique
  checkin_token_expires_at DateTime?
  checkin_token_used_at    DateTime?
  // P2-16 — same shape as checkin_token_* immediately above, minted by
  // AppointmentReminderSweepService in the same call that sends a reminder
  // (not at booking time — a reschedule link's own natural trigger point
  // is "we just told you about this appointment"). Expires at the
  // appointment's own current appointment_time; single-use, cleared
  // atomically with the reschedule write.
  reschedule_token_hash       String?   @unique
  reschedule_token_expires_at DateTime?
  reschedule_token_used_at    DateTime?
  // REQ026 (US-TEL-07) — "advise in-person visit" escalation from a
  // teleconsultation. Nullable: set only on the new in-person appointment
  // this creates, never on the originating video appointment itself.
  escalated_from_encounter_id String?
  // REQ163 (P2-10) — set only by AppointmentSeriesService.create(), never
  // client-settable via AppointmentInput (deliberately kept off that
  // GraphQL-decorated DTO entirely -- see appointments.service.ts's
  // create() signature, which takes this as a separate internal-only
  // parameter rather than trusting a client-supplied field, the same
  // Hard-Rule-6 discipline escalated_from_encounter_id above already
  // established for a system-linked id).
  series_id           String?
  series_occurrence_no Int?

  clinic              Clinics               @relation(fields: [clinic_id], references: [id])
  room                Rooms                 @relation(fields: [room_id], references: [id])
  clinician           Clinicians            @relation(fields: [clinician_id], references: [id])
  patient             Patients              @relation(fields: [patient_id], references: [id])
  product             Products?             @relation(fields: [product_id], references: [id])
  product_variation   ProductVariations?    @relation(fields: [product_variation_id], references: [id])
  booked_by_user      UserProfiles?         @relation("AppointmentBookedBy", fields: [booked_by_user_id], references: [id])
  escalated_from_encounter Encounters?      @relation("EscalatedFromEncounter", fields: [escalated_from_encounter_id], references: [id])
  series              AppointmentSeries?    @relation(fields: [series_id], references: [id])
  reviews             Reviews[]
  status_logs         AppointmentStatusLogs[]
  payments            AppointmentPayments[]
  discountApprovalRequests DiscountApprovalRequests[]
  resources           AppointmentResources[]
  encounter           Encounters?
  queue_entry         QueueEntries?
  checklist_completions ChecklistCompletions[]
  claims              Claims[]
  idempotency_key_row AppointmentIdempotencyKeys?

  @@index([clinician_id, appointment_time])
  @@index([clinic_id, appointment_time])
  @@index([patient_id, appointment_date])
  @@index([is_deleted, appointment_time])
  @@index([room_id])
  @@index([product_id])
  @@index([booked_by_user_id])
  @@index([escalated_from_encounter_id])
  @@index([series_id])

  // REQ179 (IPD slice 1) — a planned admission converted from this visit.
  sourcedAdmissions Admissions[]
}

// REQ163 (P2-10) — a named, eagerly-materialized group of linked
// Appointments rows. Covers both a simple "recurring series" (every
// occurrence shares one service_id) and a heterogeneous "treatment plan"
// (each occurrence can be a different service) -- the distinction is a
// frontend authoring convenience only (series_type is display metadata),
// never a different backend code path. There is deliberately no separate
// "planned occurrence" table: every occurrence is a real Appointments row
// from the moment the series is created (no lazy/on-demand generation,
// no background sweep) -- see AppointmentSeriesService.create()'s own
// comment for why (no working recurrence-expansion precedent existed to
// build on, and the per-row EXCLUDE constraints require reusing
// AppointmentsService.create()'s existing per-row validation anyway).
model AppointmentSeries {
  id                String   @id @default(uuid())
  // Nullable to match every other tenant-scoped model's convention here
  // (a platform operator's own org-less write path) -- always populated
  // in practice since only an org-affiliated caller can create a series.
  client_org_id     String?
  clinic_id         String
  patient_id        String
  name              String
  series_type       String   @default("recurring") // 'recurring' | 'treatment_plan' -- display metadata only
  status            String   @default("active") // 'active' | 'cancelled' -- 'completed' is derived client-side, never stored (see entity comment)
  created_by_user_id String?
  created_at        DateTime @default(now())
  updated_at        DateTime @default(now())

  client_organization ClientOrganizations? @relation(fields: [client_org_id], references: [id])
  clinic       Clinics        @relation(fields: [clinic_id], references: [id])
  patient      Patients       @relation(fields: [patient_id], references: [id])
  created_by_user UserProfiles? @relation(fields: [created_by_user_id], references: [id])
  appointments Appointments[]

  @@index([client_org_id, clinic_id])
  @@index([patient_id])
}

// P1-05 — BOOK-3's client-generated idempotency key, durable (unlike the
// slot hold below, which is Redis/TTL-only and fine to lose). A repeat
// createAppointment/bookPatientAppointment call carrying a key already
// recorded here is a no-op that returns the original appointment instead
// of re-running validation or creating a second row -- covers a retried
// request, a flaky-network resubmit, and a genuine double-tap alike.
model AppointmentIdempotencyKeys {
  id              String       @id @default(uuid())
  idempotency_key String       @unique
  appointment_id  String       @unique
  appointment     Appointments @relation(fields: [appointment_id], references: [id], onDelete: Cascade)
  created_at      DateTime     @default(now())
}

// APPOINTMENT_DETAIL_QUERY (frontend/src/graphql/queries.js) requests
// appointment.status_logs{...} — append-only, written inside every
// status-changing resolver via $transaction (backend-hard-rules.md Rule 5).
model AppointmentStatusLogs {
  id                String   @id @default(uuid())
  appointment_id    String
  status            String
  reason            String?
  changed_by_user_id String?
  created_at        DateTime @default(now())

  appointment     Appointments  @relation(fields: [appointment_id], references: [id])
  changed_by_user UserProfiles? @relation("StatusLogChangedBy", fields: [changed_by_user_id], references: [id])

  @@index([appointment_id, created_at])
}

// REQ020 (Phase 1, slice 2) — consultation workspace / clinical records
// (EMR), P0 subset. One Encounter per Appointment (US-EMR-01's "clinician
// opens the encounter" from an existing booking). client_org_id is its own
// column, denormalized from the appointment's clinic at creation -- Patients
// has no client_org_id of its own (confirmed), so this table needs one for
// direct orgScope() the same way Resources (REQ017) does.
//
// Immutability (US-EMR-06/PRD §14.2, "write-protected by trigger"): once
// locked=true, EncounterNotes/Diagnoses rows for this encounter are rejected
// at the DATABASE layer by a BEFORE UPDATE OR DELETE trigger (this model's
// own migration -- Prisma has no trigger syntax, and this is the first
// trigger in this codebase). The service layer's own lock check is the fast,
// friendly-error path in front of it, not a substitute for it -- the PRD
// explicitly names the trigger as the actual guarantee, not the application
// check. Correcting a signed encounter goes through EncounterAddenda
// instead, which is append-only and untouched by the trigger.
model Encounters {
  id             String    @id @default(uuid())
  client_org_id  String
  appointment_id String    @unique
  patient_id     String
  clinician_id   String
  status         String    @default("in_progress") // in_progress | signed
  locked         Boolean   @default(false)
  signed_at      DateTime?
  signed_by_id   String?
  // REQ026 (P1-16, US-TEL-05) — denormalized from Appointments.type at
  // getOrCreateEncounter() time, the same pattern REQ017's booking_mode
  // uses. prescriptions.service.ts's TPG guard reads this field directly
  // rather than inferring it, per that requirement's own acceptance
  // criterion.
  consultation_mode String @default("in_person") // in_person|video|audio|text
  // REQ172 — obstetric-specific, set only by an OB/GYN clinician via
  // setEncounterLmpDate(); every other specialty leaves this null forever.
  // Estimated Due Date and Gestational Age are deliberately NOT stored
  // columns -- both are always computed at render time from this one
  // date (lmp_date + 280 days / today - lmp_date), matching this schema's
  // own "store the minimum, derive at read time" convention already used
  // for chronic-registry recall status and immunisation due-status.
  lmp_date       DateTime?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  client_organization ClientOrganizations @relation(fields: [client_org_id], references: [id])
  appointment         Appointments        @relation(fields: [appointment_id], references: [id])
  patient             Patients            @relation(fields: [patient_id], references: [id])
  clinician           Clinicians          @relation(fields: [clinician_id], references: [id])
  signed_by           UserProfiles?       @relation("EncounterSignedBy", fields: [signed_by_id], references: [id])
  notes               EncounterNotes[]
  addenda             EncounterAddenda[]
  diagnoses           Diagnoses[]
  attachments         Attachments[]
  prescriptions       Prescriptions[]
  investigationOrders TestResults[]
  referrals           Referrals[]
  vitals              Vitals[]
  aiTranscriptionSessions AiTranscriptionSessions[]
  telemedicineSession TelemedicineSessions?
  escalatedAppointments Appointments[] @relation("EscalatedFromEncounter")
  // REQ167 (P2-11) — optional: a vaccination is often given outside a
  // formal consultation (an immunization camp, a walk-in), so this is not
  // required the way investigationOrders/referrals are.
  immunizationRecords ImmunizationRecords[]

  @@index([client_org_id, patient_id])
  @@index([clinician_id])
  @@index([patient_id, created_at])

  // REQ179 (IPD slice 1) — a planned admission converted from this encounter.
  sourcedAdmissions Admissions[]
}

// One row per structured section per encounter (US-EMR-02) -- "vitals" is
// one of these section values, not a separate discrete-reading table this
// slice (that granular, trendable model is the explicitly-P1 "growth
// charts" half of FR-EMR-05, see PLAN### for this slice). Upserted on
// [encounter_id, section]; version increments on every save so a future
// audit view can show edit history without needing full row versioning.
model EncounterNotes {
  id          String   @id @default(uuid())
  encounter_id String
  section     String   // complaints|history|exam|vitals|diagnosis|investigations|advice|follow_up
  content     String   @default("")
  version     Int      @default(1)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  // P1-11 (FR-AI-06) — "every AI-derived field is visibly flagged, diff-able
  // and clinician-editable before sign-off". true only from the moment an
  // AI structuring pass writes/overwrites this section until the clinician
  // saves it again through the existing saveEncounterNote() path (which
  // flips it back to false — see that method's own comment) — a genuine
  // human edit, even of AI-authored content, is no longer "AI-derived,
  // unreviewed".
  ai_generated Boolean  @default(false)
  ai_source_session_id String?

  encounter Encounters @relation(fields: [encounter_id], references: [id], onDelete: Cascade)

  @@unique([encounter_id, section])
}

// Append-only. The only way to add information to a signed (locked)
// encounter -- never updated or deleted, so the trigger on EncounterNotes/
// Diagnoses has no equivalent need here.
model EncounterAddenda {
  id           String   @id @default(uuid())
  encounter_id String
  author_id    String
  content      String
  reason       String?
  created_at   DateTime @default(now())

  encounter Encounters   @relation(fields: [encounter_id], references: [id], onDelete: Cascade)
  author    UserProfiles @relation("AddendumAuthor", fields: [author_id], references: [id])

  @@index([encounter_id, created_at])
}

// Also backs the allergy banner (US-EMR-04): type='allergy' rows, queried
// across every encounter for the patient (not scoped to the current one) --
// the requirement's own Data Model Impact section names no separate
// Allergies table, so this is the specified model doing double duty, not an
// invented one. icd10_code is nullable/free-text-fallback at MVP per the
// requirement's own note -- real coding (FR-EMR-03) is P1.
//
// REQ154 (P2-02) -- 'procedure' added as a third `type`, same double-duty
// reasoning as 'allergy' above: a coded procedure performed during an
// encounter is a clinical annotation of the identical shape (a code, a
// free-text description, a status), not a genuinely different entity that
// would justify its own table. procedure_code is the equivalent free-text/
// soft-validated column icd10_code already is for a diagnosis row -- kept
// as its own column rather than overloading icd10_code, since a procedure
// code is not an ICD-10 code and storing one under that name would mislead
// any future reader of raw data.
model Diagnoses {
  id             String   @id @default(uuid())
  encounter_id   String
  type           String   @default("diagnosis") // diagnosis | allergy | procedure
  icd10_code     String?
  procedure_code String?
  text           String
  status         String   @default("active") // active | resolved
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  encounter Encounters @relation(fields: [encounter_id], references: [id], onDelete: Cascade)

  @@index([encounter_id])
}

// REQ128 (FR-EMR-10) -- a clinician referring a patient onward to another
// specialty/clinician from within a consultation. referred_to_clinician_id
// is nullable: a referral to "Cardiology" in general is valid even when no
// specific in-org clinician is named yet (e.g. referring out of network).
// No client_org_id column, same reasoning as Diagnoses -- scoped entirely
// via the parent encounter, which already carries it.
model Referrals {
  id                      String   @id @default(uuid())
  encounter_id            String
  patient_id              String
  referred_to_specialty   String
  referred_to_clinician_id String?
  reason                  String
  urgency                 String   @default("routine") // routine | urgent
  status                  String   @default("pending")  // pending | scheduled | completed | declined
  created_at              DateTime @default(now())
  updated_at              DateTime @updatedAt

  encounter           Encounters @relation(fields: [encounter_id], references: [id], onDelete: Cascade)
  patient             Patients   @relation(fields: [patient_id], references: [id])
  referred_to_clinician Clinicians? @relation(fields: [referred_to_clinician_id], references: [id])

  @@index([encounter_id])
  @@index([patient_id])
  @@index([referred_to_clinician_id])
}

// REQ130 (FR-EMR-05) -- one row per discrete vital-sign reading, not one
// wide "vitals" row per encounter: a code/value/unit shape (matching this
// requirement's own Data Model Impact section verbatim) lets a growth chart
// query one code (e.g. weight_kg) across every encounter for a patient
// without a schema change per new vital type. No patient_id column, same
// reasoning as Diagnoses/Referrals -- a cross-encounter query joins via
// encounter.patient_id (see EncountersService#patientVitals).
model Vitals {
  id           String   @id @default(uuid())
  // REQ179 (IPD slice 2) — made nullable, admission_id added alongside, so a
  // BP trend is one series across a patient's OPD follow-ups AND their IPD
  // stay (the whole clinical point of a trend). Exactly one of the two is
  // ever set, enforced by a DB CHECK (vitals_exactly_one_parent, see the
  // migration) — never both, never neither. Audited before this change:
  // no resolver dereferences .encounter_id directly, and the frontend's own
  // GraphQL selections never request it, so widening to nullable is additive
  // for every existing caller (encounters.service.ts's audit, REQ179).
  encounter_id String?
  admission_id String?
  code         String   // height_cm | weight_kg | temperature_c | pulse_bpm | bp_systolic | bp_diastolic | spo2_percent
  value        Float
  unit         String
  recorded_by_user_id String
  recorded_at  DateTime @default(now())
  // Which nursing shift recorded this — IPD ward charting only; null for
  // every OPD (encounter-linked) row, which has no shift concept.
  shift        String?
  // P1-11 (FR-AI-05, FR-AI-06) — same flagging convention as
  // EncounterNotes.ai_generated; recorded_by_user_id is still always the
  // clinician (never a service account), extracted readings are pending
  // clinician confirmation, not confirmed automatically.
  ai_generated Boolean  @default(false)
  ai_source_session_id String?

  encounter   Encounters?  @relation(fields: [encounter_id], references: [id], onDelete: Cascade)
  admission   Admissions?  @relation(fields: [admission_id], references: [id], onDelete: Cascade)
  recorded_by UserProfiles @relation(fields: [recorded_by_user_id], references: [id])

  @@index([encounter_id])
  @@index([admission_id, recorded_at])
  @@index([code])
}

// file_ref is a local-filesystem URL under /uploads/attachments/, written by
// a REST controller (this codebase's established pattern for uploads --
// GqlAuthGuard doesn't cover REST routes, so that controller verifies its
// own bearer token directly, mirroring org-branding.controller.ts) and then
// persisted here via a separate GraphQL mutation, matching that same
// controller's two-step split rather than the avatar controller's
// inline-persist (this row carries more metadata than one column).
model Attachments {
  id                String   @id @default(uuid())
  encounter_id      String
  file_ref          String
  mime_type         String
  original_filename String
  uploaded_by_id    String
  created_at        DateTime @default(now())

  encounter   Encounters   @relation(fields: [encounter_id], references: [id], onDelete: Cascade)
  uploaded_by UserProfiles @relation("AttachmentUploadedBy", fields: [uploaded_by_id], references: [id])

  @@index([encounter_id])
}

// US-EMR-03: one-click templates. client_org_id null + clinician_id set
// would be meaningless (a personal favourite with no owning org) in
// practice every clinician has an org, but both are nullable per the
// requirement's own spec (a future platform-seeded default set could have
// client_org_id null too) -- clinician_id set means a personal favourite,
// null means org-shared.
model EncounterTemplates {
  id            String   @id @default(uuid())
  client_org_id String?
  clinician_id  String?
  specialty     String?
  name          String
  sections_json Json // { [section]: defaultContent }
  created_at    DateTime @default(now())

  client_organization ClientOrganizations? @relation(fields: [client_org_id], references: [id])
  clinician           Clinicians?          @relation(fields: [clinician_id], references: [id])

  @@index([client_org_id])
  @@index([clinician_id])
}

// REQ021 (Phase 1, slice 3) -- prescription builder, print view, and
// repeat-Rx, P0 subset. Issued from within an Encounter (REQ020's own
// dependency). Has no client_org_id of its own -- scoped indirectly via
// encounter.client_org_id, same reasoning as every other model here that
// hangs off Encounters rather than duplicating the column.
//
// Never updated after creation: no lock/trigger needed the way Encounters
// does, since there is no edit mutation to guard against in the first
// place. reprint_count distinguishes the original print (count stays 0 on
// first fetch) from a later reprint (incremented on every fetch after the
// first), which the frontend reads to render a "DUPLICATE" watermark.
model Prescriptions {
  id               String    @id @default(uuid())
  encounter_id     String
  patient_id       String
  clinician_id     String
  mode             String    @default("in_person") // in_person|video|audio|text
  issued_at        DateTime  @default(now())
  language         String    @default("en")
  repeated_from_id String?
  reprint_count    Int       @default(0)
  // REQ129 (US-RX-08) -- SHA-256 over the prescription's own canonical
  // clinical content (patient/clinician/encounter/issued_at + every item),
  // computed once at issue time. Not a hash of rendered PDF bytes: pdfkit
  // embeds a wall-clock CreationDate in every PDF it produces, which would
  // make two renders of identical content hash differently -- content
  // hashing is the deterministic, verifiable choice. Nullable: rows created
  // before this column existed have none.
  pdf_hash         String?

  encounter      Encounters      @relation(fields: [encounter_id], references: [id])
  patient        Patients        @relation(fields: [patient_id], references: [id])
  clinician      Clinicians      @relation(fields: [clinician_id], references: [id])
  repeated_from  Prescriptions?  @relation("PrescriptionRepeat", fields: [repeated_from_id], references: [id])
  repeats        Prescriptions[] @relation("PrescriptionRepeat")
  items          PrescriptionItems[]
  shareOtps      PrescriptionShareOtps[]
  // REQ177
  pharmacyPayments PharmacyPayments[]

  @@index([patient_id, issued_at])
  @@index([encounter_id])

  // REQ179 (IPD slice 2)
  dischargeSummaries DischargeSummaries[]
}

model PrescriptionItems {
  id              String   @id @default(uuid())
  prescription_id String
  drug_id         String
  dose            String
  frequency       String   // OD|BD|TDS|QID|HS|SOS
  route           String?
  duration_days   Int?
  qty             Int?     // server-calculated from frequency x duration; null for SOS (as-needed)
  instructions    String?
  substitutable   Boolean  @default(true)

  prescription Prescriptions @relation(fields: [prescription_id], references: [id], onDelete: Cascade)
  drug         Drugs         @relation(fields: [drug_id], references: [id])

  @@index([prescription_id])
}

// REQ109 — a dedicated table, not Redis (unlike the login-OTP stub),
// because this OTP gates a REST download that must survive a Redis
// restart within its TTL, and because attempts/consumed_at double as the
// audit trail for "was this ever shared, did the recipient retrieve it" —
// a real clinical-safety question worth persisting durably.
model PrescriptionShareOtps {
  id              String    @id @default(uuid())
  prescription_id String
  phone           String
  otp_code        String
  attempts        Int       @default(0)
  expires_at      DateTime
  consumed_at     DateTime?
  created_at      DateTime  @default(now())

  prescription Prescriptions @relation(fields: [prescription_id], references: [id])

  @@index([prescription_id])
}

// US-RX-02: saved drug-set favourites. Mirrors EncounterTemplates' exact
// shape (client_org_id/clinician_id both nullable, clinician_id set = a
// personal favourite, null = org-shared) -- the requirement's own Data
// Model Impact section lists no favourites table at all, the identical gap
// EncounterTemplates had in REQ020, resolved the same way. Structured
// SetItems rather than a JSON blob (unlike EncounterTemplates.sections_json)
// because each line needs a real drug_id FK, not free text.
model PrescriptionSets {
  id            String   @id @default(uuid())
  client_org_id String?
  clinician_id  String?
  specialty     String?
  name          String
  created_at    DateTime @default(now())

  client_organization ClientOrganizations?    @relation(fields: [client_org_id], references: [id])
  clinician           Clinicians?             @relation(fields: [clinician_id], references: [id])
  items               PrescriptionSetItems[]

  @@index([client_org_id])
  @@index([clinician_id])
}

model PrescriptionSetItems {
  id                  String  @id @default(uuid())
  prescription_set_id String
  drug_id             String
  dose                String
  frequency           String
  route               String?
  duration_days       Int?
  instructions        String?

  set  PrescriptionSets @relation(fields: [prescription_set_id], references: [id], onDelete: Cascade)
  drug Drugs            @relation(fields: [drug_id], references: [id])

  @@index([prescription_set_id])
}

// REQ019 (Phase 1, slice 4) -- check-in, live queue board, and queue
// actions, P0 subset. No client_org_id of its own -- scoped via
// clinic.client_org_id, the same precedent Appointments itself uses (this
// table is genuinely runtime state for an Appointment, not a standalone
// clinical/tenant record like Encounters). One row per checked-in
// appointment (created at check-in, not at booking).
model QueueEntries {
  id                String    @id @default(uuid())
  appointment_id    String    @unique
  clinic_id         String
  clinician_id      String
  token_no          Int?
  // waiting | called | in_progress | done | skipped | no_show. Free-text,
  // matching Appointments.status' own established additive-convention style
  // rather than a Postgres enum (REQ042's precedent).
  status            String    @default("waiting")
  checked_in_at     DateTime  @default(now())
  called_at         DateTime?
  // US-QUE-05: set when skipped/parked; null otherwise. served_since_skip
  // counts other patients served on this clinician's queue since the skip,
  // and the entry auto-returns to 'waiting' once it reaches
  // skip_return_after -- see queue.service.ts's recordServed().
  skip_return_after Int?
  served_since_skip Int       @default(0)
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  appointment Appointments @relation(fields: [appointment_id], references: [id])
  clinic      Clinics      @relation(fields: [clinic_id], references: [id])
  clinician   Clinicians   @relation(fields: [clinician_id], references: [id])
  events      QueueEvents[]

  @@index([clinic_id, status])
  @@index([clinician_id, status])
}

// Append-only audit trail for queue actions, mirroring AppointmentStatusLogs.
model QueueEvents {
  id                 String   @id @default(uuid())
  queue_entry_id     String
  // checked_in | called | recalled | skipped | auto_recalled | transferred |
  // started | completed | no_show
  action             String
  reason             String?
  changed_by_user_id String?
  created_at         DateTime @default(now())

  queue_entry QueueEntries  @relation(fields: [queue_entry_id], references: [id], onDelete: Cascade)
  changed_by  UserProfiles? @relation("QueueEventChangedBy", fields: [changed_by_user_id], references: [id])

  @@index([queue_entry_id, created_at])
}

model AuditLogs {
  id         String   @id @default(uuid())
  user_id    String?
  action     String
  resource   String
  resource_id String?
  details    Json     @default("{}")
  ip_address String?
  // Nullable: existing rows predate both columns and genuinely have no
  // known value -- null means "not recorded", not a backfilled guess.
  outcome    String?
  user_agent String?
  is_deleted Boolean  @default(false)
  created_at DateTime @default(now())
  // REQ053 (US-SEC-06) — set only while user_id's session is an active
  // impersonation. user_id is the REAL actor (AuditLogInterceptor logs
  // real_actor_id ?? sub, never the impersonated identity); this column
  // records who was being impersonated, satisfying "tagged with both the
  // agent's and the target user's identity" without a schema rewrite.
  acting_as_user_id String?

  user      Users? @relation("AuditLogUser", fields: [user_id], references: [id])
  acting_as Users? @relation("AuditLogActingAs", fields: [acting_as_user_id], references: [id])

  @@index([user_id, created_at])
  @@index([resource, resource_id])
  @@index([created_at])
}

model ClientOrganizations {
  id            String   @id @default(uuid())
  name          String
  code          String   @unique
  contact_email String
  contact_phone String?
  address       String?
  // Structured India address ({line1, line2, city, state, pincode, country}) —
  // same shape as Patients.address_structured. TC-ADMIN-UNIT-013/API-011 spec
  // this explicitly; the legacy flat `address` column above is kept unused
  // rather than dropped, since nothing else in the schema reads it.
  address_structured Json?
  is_active     Boolean  @default(true)
  is_deleted    Boolean  @default(false)
  settings      Json     @default("{}")
  // Self-serve SaaS onboarding
  owner_user_id     String?          // the user who signed up / owns billing for this tenant
  onboarding_status OnboardingStatus @default(pending)
  onboarding_step   String?          // e.g. "org_details" | "plan_selected" | "first_clinic_added" | "team_invited" — resumable wizard
  trial_ends_at     DateTime?
  onboarded_at      DateTime?
  // admin/Communications.jsx "Global Settings" tab — Email half only. The
  // SMS half (provider select + raw API key) is deliberately not modeled:
  // it contradicts CLAUDE.md's fixed-vendor rule (MSG91/Gupshup, not an
  // org-configurable Twilio/Vonage) -- see context/open-questions.md #6.
  // These configure the sender identity used *within* the fixed AWS SES
  // pipeline, not an alternate vendor.
  email_from_name        String  @default("HealthSync")
  email_from_address     String? // falls back to the platform default (noreply@) when null
  email_reply_to         String?
  email_include_branding Boolean @default(true)
  // P1-01/REQ144 — admin/Communications.jsx "Global Settings" tab, WhatsApp
  // conversation-spend card. Null means no cap configured (spend is tracked
  // and shown, but nothing is ever blocked) -- this is a visibility control
  // for now, not an enforcement point; P1-04's entitlement guard is the
  // future consumer that would actually act on it. Paise, same convention
  // as no_show_fee_paise above; NotificationBillingService converts its own
  // internal micro-rupee spend total to paise-comparable rupees only at
  // this same resolver boundary when computing "remaining".
  whatsapp_monthly_cap_paise Int?
  // admin/Policies.jsx "Booking Policies" tab. Cancellation Policy/Late Fee
  // sliders are deliberately not modeled here -- they conceptually overlap
  // with ProductCancellationRules' global-rule support, see
  // context/open-questions.md #7. No-show is a genuinely distinct trigger
  // (non-attendance, not cancellation) with no equivalent there.
  no_show_fee_paise         Int @default(8500)
  slot_buffer_minutes       Int @default(10)
  max_reschedules_per_month Int @default(3)
  data_retention_years      Int @default(7)
  // REQ052 (US-BOOK-04) — the auto-no-show sweep's own configurable grace
  // period, and the repeat-no-show count that forces prepayment on a
  // patient's next booking regardless of the service's own
  // prepayment_policy. See appointments.service.ts's create().
  no_show_grace_minutes        Int @default(30)
  no_show_prepayment_threshold Int @default(3)
  // REQ056 (US-BIL-03) — a counter-payment discount at or below this
  // amount is applied inline by recordCounterPayment (self-service, no
  // approval needed); above it, the discount is queued as a
  // DiscountApprovalRequests row instead, requiring a distinct
  // manager+-gated approveDiscountRequest call before any payment is
  // recorded. Default ₹1000 (100000 paise).
  discount_approval_threshold_paise Int @default(100000)
  // admin/Policies.jsx "Security & Privacy" tab (REQ012). All five toggles
  // now have real enforcement, not just persisted config:
  // - mfa_required: checked in auth.service.ts's issueTokens() for every
  //   non-patient role in this org; flags AuthPayload.mfa_setup_required
  //   rather than blocking login outright (a user who can't log in at all
  //   has no way to reach the 2FA enrollment screen that requires being
  //   logged in -- see PLAN021).
  // - session_timeout_minutes: read by the frontend once after login
  //   (myOrgSecuritySettings) to drive a real client-side idle-activity
  //   timer -- distinct from the JWT's own fixed access/refresh TTLs.
  // - audit_log_enabled: gates the new global AuditLogInterceptor (logs
  //   every GraphQL mutation) per-org; org-less callers (admin/super_admin)
  //   are always logged regardless, matching this schema's existing
  //   "org-less caller sees/does everything" precedent.
  // - patient_data_export_enabled: gates a real GDPR Art.20 data-export
  //   query for patient callers.
  // - ip_whitelist_enabled/ip_whitelist: enforced by IpWhitelistGuard
  //   against manager-role callers of this same org (admin/super_admin are
  //   platform-wide/org-less and can't be scoped to any one org's list).
  mfa_required                 Boolean @default(false)
  session_timeout_minutes      Int?
  audit_log_enabled            Boolean @default(false)
  patient_data_export_enabled  Boolean @default(false)
  ip_whitelist_enabled         Boolean @default(false)
  ip_whitelist                 String? // newline- or comma-separated IPs/CIDR ranges
  // Settings -> Clinic -> Branding (REQ002/PLAN022). Propagated to AppShell's
  // sidebar/top-nav header (logo + org name) for every JWT with a non-null
  // client_org_id -- see PLAN022 for why email/invoice/favicon propagation
  // and plan-tier gating are explicitly not built yet. Colors default to the
  // platform's own existing teal (AppShell.jsx TEAL/TEAL_LIGHT) so an org
  // that never customizes branding renders identically to today.
  logo_url        String?
  primary_color   String  @default("#006D77")
  // #00858F (the platform's own decorative TEAL_LIGHT, used widely in
  // frontend gradients) fails this pass's own WCAG AA contrast check
  // against white by a hair (4.42:1, needs 4.5:1) -- found live while
  // testing updateMyOrgBranding against a never-customized org. #007680 is
  // the nearest passing shade (5.38:1); this column's default is the only
  // thing changed, not the sitewide TEAL_LIGHT constant, since
  // secondary_color isn't wired into any rendered surface this pass (see
  // PLAN022) -- purely a stored value a manager must be able to re-save
  // without hitting a rejection on a default they never touched.
  secondary_color String  @default("#007680")
  // REQ170 — the letterhead subtitle shown under the clinic/org name on
  // both the printed prescription and its PDF (e.g. "ORTHO & GYNAE CARE"),
  // matching a real competitor prescription's own header structure. Null
  // means no tagline renders -- purely additive, no change for an org that
  // never sets one.
  tagline String?
  // REQ024 (US-MSG-04) — org-configurable clinical hours for the
  // patient<->clinic messaging auto-responder. "HH:MM" strings, same shape
  // and IST-implicit convention as NotificationPreferences' own
  // quiet_hours_start/end (see notification-trigger.service.ts). Null
  // start/end or a null auto-reply message means the auto-responder is
  // off — an org must explicitly configure all three before anything
  // fires, matching this schema's own "off by default" convention for
  // every optional behavioral toggle.
  clinical_hours_start             String?
  clinical_hours_end               String?
  clinical_hours_auto_reply_message String?
  // P1-04 — the entitlement guard's own read path. Nullable: today, no
  // real org has one assigned yet (this is a new mechanism, not a
  // backfilled one), and EntitlementsService treats a null plan_id as
  // "ungated" (every feature flag true, no quota enforced) rather than
  // "blocked" — the same fail-open-for-legacy-rows precedent this
  // schema already uses for pre-org-linkage records elsewhere (see
  // orgScope()'s own doc comment). This is distinct from the OLDER
  // OrganizationSubscriptions/SubscriptionPlans pair above (the
  // self-serve-onboarding billing record) — this links to the newer,
  // versioned Plans/PlanVersions catalog (REQ032) that actually carries
  // feature_flags_json/quotas_json, the real entitlement source.
  plan_id       String?
  // REQ179 — the tenant's own business GSTIN, for their B2B input-tax-
  // credit claim on the platform invoices they receive. Distinct from
  // Clinics.gstin, which is about the clinic billing ITS OWN patients.
  gstin         String?
  created_at    DateTime @default(now())
  updated_at    DateTime @default(now())

  plan                   Plans?    @relation(fields: [plan_id], references: [id])
  owner                  Users?    @relation("OrganizationOwner", fields: [owner_user_id], references: [id])
  clinics                Clinics[]
  organizationSubs       OrganizationSubscriptions[]
  user_profiles          UserProfiles[]
  stripe_configurations  StripeConfigurations?
  paymentTransactions    PaymentTransactions[]
  messageThreads         MessageThreads[]
  customRoles            UserRoles[]
  cancellationRules      ProductCancellationRules[]
  appointmentPayments    AppointmentPayments[]
  discountApprovalRequests DiscountApprovalRequests[]
  cashDrawerCloseouts    CashDrawerCloseouts[]
  platformSubscriptions  PlatformSubscriptions[]
  platformInvoices       PlatformInvoices[]
  products               Products[]
  patients               Patients[]
  productCategories      ProductCategories[]
  productSubcategories   ProductSubcategories[]
  drugs                  Drugs[]
  notificationProviderConfigs NotificationProviderConfig[]
  aiProviderConfigs      AiProviderConfig[]
  aiTranscriptionSessions AiTranscriptionSessions[]
  telemedicineSessions   TelemedicineSessions[]
  resources              Resources[]
  departments            Departments[]
  encounters             Encounters[]
  encounterTemplates     EncounterTemplates[]
  prescriptionSets       PrescriptionSets[]
  bookingWidgetConfigs   BookingWidgetConfig[]
  consents               Consents[]
  rightsRequests         RightsRequests[]
  retentionPolicies      RetentionPolicies[]
  payerTariffs           PayerTariffs[]
  webhookEndpoints       WebhookEndpoints[]
  payerEmpanelments      PayerEmpanelments[]
  patientInsurancePolicies PatientInsurancePolicies[]
  apiKeys                ApiKeys[]
  scheduledReports       ScheduledReports[]
  drugBatches            DrugBatches[]
  breakGlassGrants       BreakGlassGrants[]
  impersonationSessions  ImpersonationSessions[]
  packages               Packages[]
  patientPackages        PatientPackages[]
  membershipPlans        MembershipPlans[]
  patientMemberships     PatientMemberships[]
  productBranchOverrides ProductBranchOverrides[]
  cannedReplies          CannedReplies[]
  tasks                  Tasks[]
  importJobs             ImportJobs[]
  revenueShareRules      RevenueShareRules[]
  payouts                Payouts[]
  appointmentSeries      AppointmentSeries[]
  // REQ175/176/177
  paymentGatewayConfigs  PaymentGatewayConfig[]
  refundRequests         RefundRequests[]
  pharmacyPayments       PharmacyPayments[]

  // REQ179 (IPD slice 1)
  wards              Wards[]
  beds               Beds[]
  bedOccupancies     BedOccupancies[]
  admissions         Admissions[]
  admissionEvents    AdmissionEvents[]
  mlcRegisters       MlcRegisters[]
  ipdBillingSettings IpdBillingSettings[]

  // REQ179 (IPD slice 2)
  ipdMedicationOrders IpdMedicationOrders[]
  medicationAdministrations MedicationAdministrations[]
  intakeOutputRecords IntakeOutputRecords[]
  admissionNotes AdmissionNotes[]
  shiftHandovers ShiftHandovers[]
  dischargeSummaryTemplates DischargeSummaryTemplates[]
  dischargeSummaries DischargeSummaries[]

  // REQ179 (IPD slice 3)
  operationTheatres OperationTheatres[]
  otBookings        OtBookings[]
  otNotes           OtNotes[]
  otConsumables     OtConsumables[]

  // REQ179 (IPD slice 4)
  ipdBills          IpdBills[]
  ipdCharges        IpdCharges[]
  ipdPayments       IpdPayments[]
  ipdPackages       IpdPackages[]

  // REQ179 (IPD slice 5)
  preAuthorizations     PreAuthorizations[]
  ipdClaims             IpdClaims[]
  ipdInsuranceDocuments IpdInsuranceDocuments[]
}

model ClinicianAvailability {
  id                String   @id @default(uuid())
  clinician_id      String
  clinic_id         String
  day_of_week       Int?     // 0-6 (Sunday-Saturday) for weekly recurring
  start_time        String   // HH:MM format
  end_time          String   // HH:MM format
  recurrence_type   String   @default("weekly") // daily, weekly, monthly, custom
  custom_dates      String?  // JSON array of dates for custom recurrence
  exclude_weekends  Boolean  @default(false)
  exclude_saturday  Boolean  @default(false)
  exclude_sunday    Boolean  @default(false)
  excluded_days     String?  // JSON array of day numbers (0-6) to exclude
  valid_from        DateTime @default(now())
  valid_until       DateTime?
  is_active         Boolean  @default(true)
  is_deleted        Boolean  @default(false)
  created_at        DateTime @default(now())
  updated_at        DateTime @default(now()) @updatedAt
  room_id           String?
  // REQ017 (dual-mode scheduling): 'slot' (existing, default, unchanged
  // behavior) | 'session' | 'hybrid'. capacity/overbook_allowance only
  // apply to session/hybrid; walkin_ratio is schema-only for now — the
  // hybrid walk-in interleaving algorithm itself is P1, not built yet.
  mode               String  @default("slot")
  capacity           Int?
  overbook_allowance Int     @default(0)
  walkin_ratio       Int?

  clinician Clinicians @relation(fields: [clinician_id], references: [id])
  clinic    Clinics    @relation(fields: [clinic_id], references: [id])
  room      Rooms?     @relation(fields: [room_id], references: [id])

  @@index([clinician_id, is_deleted])
  @@index([clinic_id, is_deleted])
  @@index([room_id])
}


model Clinicians {
  id             String   @id @default(uuid())
  clinic_id      String
  first_name     String
  last_name      String
  clinician_type String
  gender         String?
  email          String   @unique
  phone          String
  // frontend/src/graphql/queries.js CLINICIAN_FIELDS fragment — none of these
  // three existed on this model before this increment (context/backend-hard-rules.md Rule 9).
  bio               String?
  avatar_url        String?
  consultation_fee  Int?     // paise — GraphQL exposes this as rupees, converted at the resolver
  // REQ021 — absent from this model entirely before this slice; needed on
  // a printed prescription's letterhead per the requirement's own
  // acceptance criteria. Both nullable: most seeded clinicians won't have
  // one set yet, matching bio/avatar_url's own nullability.
  registration_number String?
  qualifications       String?
  // REQ170 — newline-separated bullet list of sub-specialty/fellowship
  // lines shown under `qualifications` on the letterhead (e.g. "Diploma
  // in IVF & Reproductive Medicine\nFellowship in Laparoscopy
  // (Gynaecology)"), matching a real competitor prescription's own
  // two-line-per-doctor header. `qualifications` itself is untouched --
  // still the short degree string only.
  specialty_highlights String?
  // REQ015 (US-SEC-07) — the council registration_number was captured for
  // (e.g. "Delhi Medical Council"); free text, no council master table yet.
  medical_council      String?
  // unverified (default) | pending | verified | rejected. Only 'verified'
  // renders the public-profile badge — this is an admin-attested interim
  // path (REQ015's own acceptance criteria), not real HPR/NMC API
  // verification, which the requirement doc explicitly defers.
  verification_status  String    @default("unverified")
  verified_at          DateTime?
  // Plain UUID, no Prisma relation — see PLAN065's "actor-reference fields"
  // note: this batch of 8 slices deliberately skips formal Users relations
  // for audit-actor columns to keep the schema change tractable.
  verified_by_user_id  String?
  is_active      Boolean  @default(true)
  is_deleted     Boolean  @default(false)
  created_at     DateTime @default(now())
  // REQ014 (US-ORG-03) — optional specialty grouping, nullable since most
  // existing clinicians predate departments existing at all.
  department_id  String?

  clinic     Clinics      @relation(fields: [clinic_id], references: [id])
  department Departments? @relation(fields: [department_id], references: [id])

  availability        ClinicianAvailability[]
  appointments        Appointments[]
  lunchBreaks         LunchBreaks[]
  spacerBlocks        SpacerBlocks[]
  userProfiles        UserProfiles[]
  clinicianLanguages  ClinicianLanguages[]
  clinicianServices   ClinicianServices[]
  reviews             Reviews[]
  encounters          Encounters[]
  encounterTemplates  EncounterTemplates[]
  prescriptions       Prescriptions[]
  prescriptionSets    PrescriptionSets[]
  // REQ173 -- a personal single-drug quick-pick list, distinct from
  // prescriptionSets' own multi-drug bundles above.
  favouriteDrugs      ClinicianFavouriteDrugs[]
  queueEntries        QueueEntries[]
  waitlistEntries     WaitlistEntries[]
  // REQ128 -- referrals naming this clinician as the target, not one they authored.
  referralsReceived   Referrals[]
  revenueShareRules   RevenueShareRules[]
  payouts             Payouts[]

  @@index([clinic_id, is_deleted, is_active])
  @@index([department_id])

  // REQ179 (IPD slice 1)
  admissionsAsAdmitting Admissions[]   @relation("AdmittingClinician")
  admissionsAsAttending Admissions[]   @relation("AttendingClinician")
  mlcRegistersExamined  MlcRegisters[] @relation("MlcExaminedBy")

  // REQ179 (IPD slice 2)
  ipdMedicationOrdersOrdered IpdMedicationOrders[] @relation("IpdOrderOrderedBy")
  admissionNotesAuthored     AdmissionNotes[]      @relation("AdmissionNoteAuthorClinician")
  dischargeSummariesSigned   DischargeSummaries[]  @relation("DsSignedBy")

  // REQ179 (IPD slice 3)
  otBookingsAsPrimarySurgeon OtBookings[] @relation("OtPrimarySurgeon")
  otBookingsAsAnesthetist    OtBookings[] @relation("OtAnesthetist")
  otNotesAuthored            OtNotes[]    @relation("OtNoteAuthor")
}

// CLINICIAN_FIELDS wants `services{id name duration_minutes price}` per clinician
// and SERVICES_QUERY wants `clinicians{id full_name}` per service — no join
// existed between Clinicians and Products before this increment.
model ClinicianServices {
  id           String   @id @default(uuid())
  clinician_id String
  product_id   String
  is_deleted   Boolean  @default(false)
  created_at   DateTime @default(now())

  clinician Clinicians @relation(fields: [clinician_id], references: [id], onDelete: Cascade)
  product   Products   @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([clinician_id, product_id])

  @@index([product_id])
}

// REQ041 -- a partial unique index (migration 20260823040000_clinics_one_
// primary_per_org) enforces at most one is_primary=true, is_deleted=false
// clinic per client_org_id, not expressible declaratively here (Prisma has
// no partial-index/WHERE-clause syntax for @@unique).
model Clinics {
  id           String   @id @default(uuid())
  name         String
  address      String
  // frontend/src/graphql/queries.js CLINICS_QUERY requests these as flat scalar
  // fields (not a structured JSON blob like Patients.address_structured) — matched
  // exactly per context/backend-hard-rules.md Rule 9. `postcode` naming and the
  // frontend form's 'Europe/London' timezone default are flagged as a follow-up
  // fix, not silently changed here (see context/phase4-catalog-modules-implementation-plan.md).
  city         String?
  postcode     String?
  // REQ101 — supplier-side GST fields. Both null until an admin configures
  // them; AppointmentPayments' own GST split stays null (not guessed)
  // until both this clinic's gstin AND the paid product's gst_rate are
  // set. `state` is also place_of_supply's only source — Clinics has
  // never had one before this.
  state        String?
  gstin        String?
  timezone     String?  @default("Asia/Kolkata")
  phone        String
  email        String
  // REQ170 — prescription-letterhead footer fields, matching a real
  // competitor prescription's own footer (full address already covered by
  // address/city/postcode/state above; these three fill the remaining
  // gap). All null-default, purely additive.
  website           String?
  alternate_phone   String?
  appointment_note  String? // e.g. "Sunday by appointment"
  // REQ170 — an ordered list of Clinicians.id always shown on this
  // clinic's own prescription letterhead, regardless of which clinician
  // actually issued a given prescription (the reference's two-doctor
  // co-branding pattern -- common for partner-run clinics). Null/empty
  // falls back to showing only the issuing clinician, matching today's
  // behaviour exactly. A short admin-curated list, not a first-class
  // many-to-many domain -- same Json-for-small-ordered-config convention
  // as address_structured/ClientOrganizations.settings elsewhere in this
  // schema, deliberately not a new join table.
  letterhead_clinician_ids Json?
  is_primary   Boolean  @default(false)
  is_active    Boolean  @default(true)
  is_deleted   Boolean  @default(false)
  created_at   DateTime @default(now())
  client_org_id String?

  client_organization ClientOrganizations? @relation(fields: [client_org_id], references: [id])

  clinicians         Clinicians[]
  rooms              Rooms[]
  resources          Resources[]
  departments        Departments[]
  availability       ClinicianAvailability[]
  lunchBreaks        LunchBreaks[]
  spacerBlocks       SpacerBlocks[]
  blocks             RoomBlocks[]
  appointments       Appointments[]
  appointmentSeries  AppointmentSeries[]
  userProfiles       UserProfiles[]
  products           Products[]
  productCategories  ProductCategories[]
  productSubcategories ProductSubcategories[]
  reviews            Reviews[]
  cancellationRules  ProductCancellationRules[]
  payments           AppointmentPayments[]
  discountApprovalRequests DiscountApprovalRequests[]
  cashDrawerCloseouts CashDrawerCloseouts[]
  invoiceSequences   InvoiceSequences[]
  queueEntries       QueueEntries[]
  drugBatches        DrugBatches[]
  payerEmpanelments  PayerEmpanelments[]
  bookingWidgetConfigs BookingWidgetConfig[]
  scheduledReports   ScheduledReports[]
  checklistItems     ChecklistItems[]
  intakeFieldConfigs ClinicIntakeFieldConfig[]
  packages           Packages[]
  patientPackages    PatientPackages[]
  membershipPlans    MembershipPlans[]
  patientMemberships PatientMemberships[]
  productBranchOverrides ProductBranchOverrides[]
  messageThreads     MessageThreads[]
  waitlistEntries    WaitlistEntries[]
  revenueShareRules  RevenueShareRules[]
  payouts            Payouts[]
  // REQ175/176/177
  paymentGatewayConfig PaymentGatewayConfig?
  refundRequests       RefundRequests[]
  pharmacyPayments     PharmacyPayments[]

  @@index([client_org_id, is_deleted])

  // REQ179 (IPD slice 1)
  wards              Wards[]
  beds               Beds[]
  bedOccupancies     BedOccupancies[]
  admissions         Admissions[]
  mlcRegisters       MlcRegisters[]
  ipdBillingSettings IpdBillingSettings[]

  // REQ179 (IPD slice 2)
  dischargeSummaryTemplates DischargeSummaryTemplates[]

  // REQ179 (IPD slice 3)
  operationTheatres OperationTheatres[]
  otBookings        OtBookings[]

  // REQ179 (IPD slice 4)
  ipdBills    IpdBills[]
  ipdCharges  IpdCharges[]
  ipdPayments IpdPayments[]
  ipdPackages IpdPackages[]

  // REQ179 (IPD slice 5)
  preAuthorizations PreAuthorizations[]
  ipdClaims         IpdClaims[]
}

model EmailTemplates {
  id            String       @id @default(uuid())
  name          String
  template_type TemplateType
  subject       String
  body          String
  // admin/EmailTemplates.jsx — the allowed {{variable}} tokens for this template;
  // updateEmailTemplate rejects a subject/body using a token outside this list
  // (TC-ADMIN-UNIT-004/API-009). Didn't exist on this model before this increment.
  variables     String[]     @default([])
  is_active     Boolean      @default(true)
  is_deleted    Boolean      @default(false)
  created_at    DateTime     @default(now())
  updated_at    DateTime     @default(now())
}

model LunchBreaks {
  id             String        @id @default(uuid())
  clinician_id   String
  clinic_id      String
  day_of_week    Int?
  start_time     DateTime
  end_time       DateTime
  is_recurring   Boolean       @default(true)
  specific_date  DateTime?
  is_deleted     Boolean       @default(false)
  created_at     DateTime      @default(now())
  recurrence_type RecurrenceType @default(single)
  recurrence_days Json?
  end_date       DateTime?

  clinician Clinicians @relation(fields: [clinician_id], references: [id])
  clinic    Clinics    @relation(fields: [clinic_id], references: [id])

  @@index([clinician_id, is_deleted])
  @@index([clinic_id])
}

model Notifications {
  id         String              @id @default(uuid())
  user_id    String
  title      String
  message    String
  type       NotificationType
  priority   NotificationPriority @default(medium)
  is_read    Boolean             @default(false)
  is_deleted Boolean             @default(false)
  action_url String?
  metadata   Json                @default("{}")
  created_at DateTime            @default(now())

  user Users @relation(fields: [user_id], references: [id])

  @@index([user_id, is_deleted, created_at])
}

// REQ008/PLAN017 — admin-configurable OTP/SMS provider per org. Deliberately
// its own model, not columns bolted onto ClientOrganizations, since the
// credential shape varies per provider (see backend/src/notifications/providers/)
// and doesn't belong flattened into the org's own row. `channel` is a plain
// string ('sms' today) rather than an enum so a future channel (whatsapp,
// etc.) needs zero schema change — same reasoning for `provider` being a
// registry key, not an enum, so adding a provider is a code change only.
model NotificationProviderConfig {
  id                    String   @id @default(uuid())
  client_org_id         String
  channel               String
  provider              String
  credentials_encrypted String   // AES-256-GCM JSON blob, shape owned by the provider's registry entry
  sender_id             String?  // common display field across most SMS providers; kept denormalized
  is_active             Boolean  @default(true)
  created_at            DateTime @default(now())
  updated_at            DateTime @default(now())

  client_org ClientOrganizations @relation(fields: [client_org_id], references: [id])

  @@unique([client_org_id, channel])
}

// P1-11 (FR-AI-12) — swappable per org, same shape/precedent as
// NotificationProviderConfig above (encrypted credentials, one row per
// org+purpose). purpose is 'transcription' today; a second AI purpose
// (e.g. a future structuring-LLM provider) adds a value here, not a
// second table.
model AiProviderConfig {
  id                    String   @id @default(uuid())
  client_org_id         String
  purpose               String   @default("transcription")
  provider              String
  credentials_encrypted String
  is_active             Boolean  @default(true)
  created_at            DateTime @default(now())
  updated_at            DateTime @default(now())

  client_org ClientOrganizations @relation(fields: [client_org_id], references: [id])

  @@unique([client_org_id, purpose])
}

// P1-11 (FR-AI-01, FR-AI-07, FR-AI-11) — one row per record-and-transcribe
// attempt. consented_at is the logged proof FR-AI-01 requires ("refuse to
// record without it") — startTranscriptionSession() will not create this
// row at all without it, so a row's mere existence is part of that proof.
// Audio bytes are never columns here (FR-AI-07's "never persisted beyond
// transcription unless the org opts in") — they pass through to the
// provider and are discarded server-side the moment transcription
// returns; duration_seconds is the only trace, and only for metering.
model AiTranscriptionSessions {
  id                  String    @id @default(uuid())
  client_org_id       String
  encounter_id        String
  patient_id          String
  consented_by_user_id String
  consented_at        DateTime
  status              String    @default("pending_consent") // pending_consent|recording|transcribing|transcribed|structured|failed
  provider            String?
  raw_transcript       String?
  duration_seconds     Int?      // metering input (FR-AI-11) — real audio length, not wall-clock session time
  error_message        String?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  client_organization ClientOrganizations @relation(fields: [client_org_id], references: [id])
  encounter           Encounters          @relation(fields: [encounter_id], references: [id])
  patient              Patients            @relation(fields: [patient_id], references: [id])
  consented_by         UserProfiles        @relation(fields: [consented_by_user_id], references: [id])

  @@index([client_org_id, created_at])
  @@index([encounter_id])
}

// REQ026 (P1-16) — one real video-consultation session per encounter.
// Fixed vendor (Daily.co, Hard Rule 9 — video is not one of the
// admin-configurable-per-org exceptions OTP/notification channels are),
// so unlike AiProviderConfig/NotificationProviderConfig there is no
// per-org credential row: a single platform-wide API key from env.
model TelemedicineSessions {
  id                   String    @id @default(uuid())
  client_org_id        String
  encounter_id         String    @unique
  room_name            String    @unique
  room_url             String
  status               String    @default("pending") // pending|active|ended
  valid_from           DateTime
  valid_to             DateTime
  // US-TEL-03 — recording is opt-in, never default-on. Null until the
  // clinician (the only @Auth('clinician')-gated caller of
  // consentToRecording) explicitly consents, per call.
  recording_consent_at DateTime?
  recording_consent_by_user_id String?
  recording_ref        String?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  client_organization ClientOrganizations @relation(fields: [client_org_id], references: [id])
  encounter           Encounters          @relation(fields: [encounter_id], references: [id])
  recording_consent_by UserProfiles?      @relation(fields: [recording_consent_by_user_id], references: [id])

  @@index([client_org_id, created_at])
}

model OrganizationSubscriptions {
  id                   String              @id @default(uuid())
  client_org_id        String
  plan_id              String
  status               SubscriptionStatus
  billing_cycle        BillingCycle
  current_period_start DateTime @default(now())
  current_period_end   DateTime
  is_deleted           Boolean  @default(false)
  stripe_customer_id   String?
  stripe_subscription_id String?
  created_at           DateTime @default(now())
  updated_at           DateTime @default(now())

  client_org          ClientOrganizations @relation(fields: [client_org_id], references: [id])
  plan                SubscriptionPlans   @relation(fields: [plan_id], references: [id])
  paymentTransactions PaymentTransactions[] @relation("SubscriptionTransactions")

  @@index([client_org_id])
  @@index([plan_id])
}

model Patients {
  id                    String   @id @default(uuid())
  // F-04 (project-plans/02-findings-register.md) — Patients had no
  // client_org_id of its own; org-scoping fell back to a relation through
  // Appointments.clinic, and a patient with zero appointments (freshly
  // registered, before their first booking) was visible to any
  // authenticated staff caller regardless of org. Nullable, backfilled
  // from appointment history, same shape as BUG001's Products.client_org_id.
  client_org_id         String?
  first_name            String
  last_name             String
  date_of_birth         DateTime
  email                 String
  phone                 String
  phone_country_code    String?
  address               String
  medical_notes         String   @default("")
  title                 String?
  status                String?
  birth_surname         String?
  birth_name            String?
  birth_names           String?
  social_security_number String?
  gender                String?
  sex                   String?
  google_client_id      String?
  payment_reference     String?
  occupation            String?
  place_of_birth        Json?    // JSON: { city, country }
  phones                Json?    // JSON array: [{ countryCode, number }]
  address_structured    Json?    // JSON: { line1, line2, city, state, pincode, country } — India address format
  // REQ016 (US-CAT-04) — general | corporate | staff | camp, per the
  // requirement doc's own examples. Free-text validated via @IsIn() at the
  // DTO layer, matching this model's existing loose-string convention
  // (status/gender) rather than a hard Prisma enum.
  patient_category      String?
  // REQ029 (US-RPT-02) — how this patient was acquired (referral | online_search
  // | walk_in | other), free text validated at the DTO layer per this model's
  // existing loose-string convention. Nullable: most existing patients predate
  // this field.
  acquisition_source    String?
  // REQ052 (US-BOOK-04) — incremented by the auto-no-show sweep each time
  // one of this patient's appointments is auto-marked no_show. Read by
  // appointments.service.ts's create() to force prepayment on their next
  // booking once it reaches the org's configured threshold.
  no_show_count         Int      @default(0)
  is_deleted            Boolean  @default(false)
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  client_organization ClientOrganizations? @relation(fields: [client_org_id], references: [id])
  // REQ110 — a patient can appear as either side of a package transfer
  // across different transfers, hence two named relations.
  packageTransfersFrom PackageTransferLog[] @relation("PackageTransferFrom")
  packageTransfersTo   PackageTransferLog[] @relation("PackageTransferTo")
  // REQ106
  waitlistEntries      WaitlistEntries[]

  appointments Appointments[]
  appointmentSeries AppointmentSeries[]
  userProfiles UserProfiles[]
  reviews      Reviews[]
  testResults  TestResults[]
  payments     AppointmentPayments[]
  encounters   Encounters[]
  prescriptions Prescriptions[]
  referrals    Referrals[]
  claims       Claims[]
  dependantsOwned    PatientRelations[] @relation("PatientRelationOwner")
  dependantOf        PatientRelations[] @relation("PatientRelationDependant")
  mergesSurvived     PatientMerges[]    @relation("PatientMergeSurvivor")
  mergesAbsorbed     PatientMerges[]    @relation("PatientMergeMerged")
  consents                 Consents[]
  rightsRequests           RightsRequests[]
  insurancePolicies        PatientInsurancePolicies[]
  patientPackages          PatientPackages[]
  patientMemberships       PatientMemberships[]
  tasks                    Tasks[]
  aiTranscriptionSessions  AiTranscriptionSessions[]
  // REQ167 (P2-11)
  immunizationRecords      ImmunizationRecords[]
  // REQ168 (P2-12)
  chronicRegistryEnrollments ChronicRegistryEnrollments[]
  // REQ174
  documents                  PatientDocuments[]
  // REQ177
  pharmacyPayments           PharmacyPayments[]

  @@index([is_deleted, created_at])
  @@index([email])
  @@index([phone])
  @@index([client_org_id])

  // REQ179 (IPD slice 1)
  admissions Admissions[]

  // REQ179 (IPD slice 5)
  preAuthorizations PreAuthorizations[]
  ipdClaims         IpdClaims[]
}

// REQ018 (Phase 1, slice 5) P0 -- US-BOOK-02: one phone-verified login
// managing multiple patient profiles with a relationship label.
// `patient_id` is the owning/managing patient (the JWT's own patient_id);
// `related_patient_id` is the dependant. Both point at Patients, so a
// self-relation table needs two distinctly-named relations to disambiguate.
model PatientRelations {
  id                 String   @id @default(uuid())
  patient_id         String
  related_patient_id String
  relation           String
  created_at         DateTime @default(now())

  patient         Patients @relation("PatientRelationOwner", fields: [patient_id], references: [id])
  related_patient Patients @relation("PatientRelationDependant", fields: [related_patient_id], references: [id])

  @@unique([patient_id, related_patient_id])
  @@index([patient_id])
}

// REQ018 P0 -- US-BOOK-01: irreversible-in-the-UI, reversible-in-principle
// (per the requirement's own non-functional note) patient-merge audit
// trail. One row per merge; the merged patient survives as an is_deleted
// row rather than being hard-deleted, so this table's own FKs stay valid.
model PatientMerges {
  id                  String   @id @default(uuid())
  surviving_patient_id String
  merged_patient_id   String
  merged_by_user_id   String?
  reason              String?
  merged_at           DateTime @default(now())

  surviving_patient Patients      @relation("PatientMergeSurvivor", fields: [surviving_patient_id], references: [id])
  merged_patient    Patients      @relation("PatientMergeMerged", fields: [merged_patient_id], references: [id])
  merged_by         UserProfiles? @relation("PatientMergePerformedBy", fields: [merged_by_user_id], references: [id])

  @@index([surviving_patient_id])
  @@index([merged_patient_id])
}

// pages/test-results/index.jsx — built from scratch (zero pre-existing GraphQL
// contract, unlike every other module this session). patient_name/ordered_by_name
// are denormalized because the current Order-Test dialog is a free-text field,
// not a real patient picker; patient_id/ordered_by_user_id are optional FKs added
// for forward compatibility once a Patients module (Phase 6) and a real picker
// exist — see context/test-results-backend-implementation-plan.md.
model TestResults {
  id               String            @id @default(uuid())
  patient_name     String
  patient_id       String?
  test_name        String
  test_type        String
  ordered_by_name  String
  ordered_by_user_id String?
  date_ordered     DateTime          @default(now())
  date_completed   DateTime?
  status           TestResultStatus  @default(pending)
  values           Json              @default("[]") // [{name, value, ref, flag}]
  is_deleted       Boolean           @default(false)
  created_at       DateTime          @default(now())
  // REQ127 (FR-EMR-08) — nullable: most existing rows predate this and were
  // never ordered from within a specific encounter (walk-in lab work, the
  // standalone orderTest() mutation). Set only by the new orderInvestigation()
  // path, the actual "investigation order" concept -- a test explicitly
  // requested during a consultation, not just any lab result on file.
  encounter_id     String?
  urgency          String            @default("routine") // routine | urgent | stat

  patient       Patients?     @relation(fields: [patient_id], references: [id])
  ordered_by    UserProfiles? @relation(fields: [ordered_by_user_id], references: [id])
  encounter     Encounters?   @relation(fields: [encounter_id], references: [id])

  @@index([patient_id, date_ordered])
  @@index([ordered_by_user_id])
  @@index([is_deleted, date_ordered])
  @@index([encounter_id])
}

// REQ174 — makes patients/detail.jsx's own pre-existing Documents tab
// real (it previously pushed to local React state only, "demo mode",
// nothing ever persisted). client_org_id is stamped from the uploader via
// orgIdForWrite() at write time, not inherited from Patients.client_org_id
// (which can itself be null for a patient with no appointment history
// yet — see that column's own F-04 note) — a document must always be
// attributable to a real org regardless of the patient row's own state.
// category is a plain validated string (DrugInput.tpg_list's own
// @IsIn() precedent), not a Prisma enum: it mirrors the frontend's
// existing small, UI-owned DOCUMENT_FOLDERS taxonomy, which does not
// warrant a migration if a label is ever renamed.
model PatientDocuments {
  id                String   @id @default(uuid())
  patient_id        String
  client_org_id     String?
  category          String
  file_ref          String
  mime_type         String
  original_filename String
  file_size_bytes   Int
  uploaded_by_id    String
  is_deleted        Boolean  @default(false)
  created_at        DateTime @default(now())

  patient     Patients     @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  uploaded_by UserProfiles @relation("PatientDocumentUploadedBy", fields: [uploaded_by_id], references: [id])

  @@index([patient_id, is_deleted])
}

// REQ167 (P2-11) — India's National Immunization Schedule. Platform-global
// reference data, like Drugs/Languages -- no client_org_id, seeded via
// seed.ts. due_age_days is days since Patients.date_of_birth.
model ImmunizationScheduleItems {
  id           String   @id @default(uuid())
  vaccine_name String
  dose_number  Int
  due_age_days Int
  sort_order   Int      @default(0)
  is_active    Boolean  @default(true)
  is_deleted   Boolean  @default(false)
  created_at   DateTime @default(now())

  immunizationRecords ImmunizationRecords[]

  @@index([is_active, due_age_days])
}

// REQ167 (P2-11) — mirrors TestResults' own shape: patient_id mandatory,
// encounter_id optional (a vaccination is often given outside a formal
// consultation), no direct client_org_id/clinic_id -- scoped transitively
// via patient_id -> Patients.client_org_id.
model ImmunizationRecords {
  id                      String   @id @default(uuid())
  patient_id              String
  schedule_item_id        String?  // soft link -- null for an off-schedule/catch-up dose
  encounter_id            String?
  vaccine_name            String   // denormalized at record time
  dose_number             Int
  administered_at         DateTime @default(now())
  administered_by_user_id String?
  batch_no                String?
  site                    String?
  notes                   String?
  is_deleted              Boolean  @default(false)
  created_at              DateTime @default(now())

  patient        Patients                   @relation(fields: [patient_id], references: [id])
  scheduleItem   ImmunizationScheduleItems?  @relation(fields: [schedule_item_id], references: [id])
  encounter      Encounters?                @relation(fields: [encounter_id], references: [id])
  administeredBy UserProfiles?              @relation(fields: [administered_by_user_id], references: [id])

  @@index([patient_id, administered_at])
  @@index([encounter_id])
  @@index([schedule_item_id])
}

// REQ168 (P2-12) — a fixed pair, not an open catalog (the slice's own
// title says "(diabetes/HTN)"); no separate reference-catalog table like
// ImmunizationScheduleItems since there is nothing here for an org to
// configure.
enum ChronicConditionType {
  diabetes
  hypertension
}

// REQ168 (P2-12) — mirrors TestResults/ImmunizationRecords' own shape:
// patient_id mandatory, no direct client_org_id/clinic_id -- scoped
// transitively via patient_id -> Patients.client_org_id. Enrollment is
// always a confirmed clinician action (never an automatic diagnosis-code
// join -- Diagnoses.icd10_code has no guaranteed cleanliness), which
// chronicRegistrySuggestions() surfaces as candidates only.
model ChronicRegistryEnrollments {
  id                  String               @id @default(uuid())
  patient_id          String
  condition           ChronicConditionType
  status              String               @default("active") // active | resolved
  enrolled_at         DateTime             @default(now())
  enrolled_by_user_id String?
  // Recall clock. Reset to now() by markRegistryReviewed() each time a
  // clinician documents a follow-up review. A fixed 90-day interval for
  // both conditions -- a stated simplification, not a per-condition
  // clinically-validated cadence this codebase has any real source for.
  last_reviewed_at    DateTime             @default(now())
  notes               String?
  is_deleted          Boolean              @default(false)

  patient    Patients      @relation(fields: [patient_id], references: [id])
  enrolledBy UserProfiles? @relation(fields: [enrolled_by_user_id], references: [id])

  @@unique([patient_id, condition])
  @@index([patient_id])
  @@index([status, last_reviewed_at])
}

model PaymentTransactions {
  id             String   @id @default(uuid())
  client_org_id  String
  subscription_id String?
  amount         Int      // stored in paise (smallest INR unit) to avoid float rounding
  currency       String   @default("INR")
  status         String
  is_deleted     Boolean  @default(false)
  stripe_payment_intent_id String?
  stripe_invoice_id String?
  razorpay_order_id   String?
  razorpay_payment_id String?
  razorpay_signature  String?
  // GST invoicing fields (India)
  gstin          String?
  hsn_sac_code   String?
  gst_rate       Float?   // e.g. 18.0 for 18%
  cgst_amount    Int?     // paise
  sgst_amount    Int?     // paise
  igst_amount    Int?     // paise
  transaction_date DateTime @default(now())
  metadata       Json     @default("{}")
  created_at     DateTime @default(now())

  client_org    ClientOrganizations        @relation(fields: [client_org_id], references: [id])
  subscription  OrganizationSubscriptions? @relation("SubscriptionTransactions", fields: [subscription_id], references: [id])

  @@index([client_org_id, created_at])
}

// REQ004 — real per-appointment PATIENT payments via Razorpay. Deliberately
// separate from PaymentTransactions above, which is scoped to
// ClientOrganizations/OrganizationSubscriptions (tenant SaaS-subscription
// billing only, per CLAUDE.md) and has no appointment_id/patient_id at all --
// retrofitting it would be the wrong shape, not a shortcut. GST fields mirror
// PaymentTransactions' own (nullable, per-transaction -- no org-level GST
// config table exists anywhere in this schema to source from automatically).
model AppointmentPayments {
  id                  String   @id @default(uuid())
  appointment_id      String
  patient_id          String
  clinic_id           String
  client_org_id       String? // derived from clinic at write time; nullable to match Clinics' own optional client_org_id
  amount              Int     // paise
  currency            String  @default("INR")
  status              String  // pending | succeeded | failed
  razorpay_order_id   String?
  razorpay_payment_id String?
  razorpay_signature  String?
  gstin               String?
  hsn_sac_code        String?
  gst_rate            Float?
  cgst_amount         Int?
  sgst_amount         Int?
  igst_amount         Int?
  // REQ047 (US-BIL-09). place_of_supply has no reliable source yet --
  // Clinics has no state column (CLAUDE.md's own documented flat-address
  // inconsistency) -- so it stays null unless supplied explicitly; nothing
  // in this slice invents one. invoice_number is always real: assigned
  // gaplessly per clinic from InvoiceSequences the moment a payment
  // succeeds, never left null for a completed payment.
  place_of_supply     String?
  invoice_number      String?
  metadata            Json     @default("{}")
  // REQ056 (US-BIL-03) — a discount applied on this specific counter
  // payment. discount_amount is 0 for the overwhelming majority of rows
  // (no discount given); approved_by_user_id stays null for a discount at
  // or below the org's configured threshold (self-service, no approval
  // needed) and is stamped with the approving manager's own id only when
  // the discount exceeded it (see DiscountApprovalRequests).
  discount_amount     Int      @default(0) // paise
  discount_reason     String?
  approved_by_user_id String?
  // REQ175 -- generic equivalents of razorpay_order_id/payment_id above,
  // written by every gateway adapter (Razorpay's own adapter dual-writes
  // both the legacy razorpay_* columns, for zero regression on any
  // existing code/report that reads them directly, and these). `gateway`
  // defaults to 'razorpay' so every pre-existing row is correctly
  // attributed with no backfill needed.
  gateway             String   @default("razorpay")
  gateway_order_id    String?
  gateway_payment_id  String?
  gateway_reference   String?
  // REQ176 -- refund state. none is the overwhelming default; a real
  // refund always passes through requested -> approved -> processing ->
  // refunded (or rejected/failed) via RefundRequests below, never set
  // directly by a mutation with no approval step.
  refund_status       String   @default("none") // none | requested | approved | rejected | processing | refunded | failed
  refund_amount       Int?
  refund_reason       String?
  refunded_at         DateTime?
  gateway_refund_id   String?
  created_at          DateTime @default(now())
  updated_at          DateTime @default(now())

  appointment Appointments        @relation(fields: [appointment_id], references: [id])
  patient     Patients            @relation(fields: [patient_id], references: [id])
  clinic      Clinics             @relation(fields: [clinic_id], references: [id])
  client_org  ClientOrganizations? @relation(fields: [client_org_id], references: [id])
  approved_by Users?              @relation("AppointmentPaymentApprovedBy", fields: [approved_by_user_id], references: [id])
  tenders     PaymentTenders[]
  refundRequests RefundRequests[]

  @@index([client_org_id, created_at])
  @@index([status, created_at])
  @@index([razorpay_order_id])
  @@index([gateway_order_id])
  @@index([appointment_id])
  @@index([patient_id])
  @@index([clinic_id])
}

// REQ023 (US-BIL-01, scoped subset) -- line items under one
// AppointmentPayments row for a front-desk-recorded split across cash/UPI/
// card/cheque tenders, as an alternative to the existing Razorpay-online-
// only path. A payment row with tenders (vs. one with razorpay_payment_id
// set) is how the two payment sources are distinguished -- matching this
// table's own existing convention of distinguishing payment shape by which
// nullable fields are populated, not a separate discriminator column.
model PaymentTenders {
  id                      String   @id @default(uuid())
  appointment_payment_id  String
  tender_type             String   // cash | upi | card | cheque
  amount                  Int      // paise
  reference                String?  // UPI txn ref / cheque number, optional
  recorded_by_user_id     String
  created_at              DateTime @default(now())

  appointment_payment AppointmentPayments @relation(fields: [appointment_payment_id], references: [id])
  recorded_by         Users               @relation(fields: [recorded_by_user_id], references: [id])

  @@index([appointment_payment_id])
}

// REQ175 -- mirrors NotificationProviderConfig's own shape exactly (REQ008):
// `provider` a plain registry-key string (not an enum -- adding a 5th
// gateway is a code change only), credentials as one AES-256-GCM-encrypted
// JSON blob (backend/src/common/crypto/secrets.ts, reused verbatim -- shape
// varies per gateway, doesn't belong flattened into columns). Clinic-scoped
// (not org-scoped like the notification registry) per the requirement's
// own explicit choice: a multi-branch org settles each branch to a
// different bank account. A clinic with no row here falls back to the
// platform's own env-var Razorpay credentials -- zero regression for every
// org that never configures this.
model PaymentGatewayConfig {
  id                    String   @id @default(uuid())
  clinic_id             String   @unique
  client_org_id         String?
  provider              String
  credentials_encrypted String
  is_active             Boolean  @default(true)
  created_at            DateTime @default(now())
  updated_at            DateTime @default(now())

  clinic     Clinics              @relation(fields: [clinic_id], references: [id])
  client_org ClientOrganizations? @relation(fields: [client_org_id], references: [id])
}

// REQ176 -- mirrors DiscountApprovalRequests' own shape field-for-field
// (REQ056): requested_amount is always computed server-side by the
// cancellation/reschedule fee-policy engine (common/scheduling/
// cancellation-fee.ts), never client-supplied; decideRefundRequest rejects
// a decider who is also the requester, even a manager+ caller, the exact
// same rule DiscountApprovalRequests already enforces.
model RefundRequests {
  id                      String    @id @default(uuid())
  appointment_payment_id  String
  clinic_id               String
  client_org_id           String?
  requested_by_user_id    String
  requested_amount        Int       // paise
  reason                  String
  status                  String    @default("pending") // pending | approved | rejected
  decided_by_user_id      String?
  decided_at              DateTime?
  created_at              DateTime  @default(now())

  appointment_payment AppointmentPayments  @relation(fields: [appointment_payment_id], references: [id])
  clinic              Clinics              @relation(fields: [clinic_id], references: [id])
  client_org          ClientOrganizations? @relation(fields: [client_org_id], references: [id])
  requested_by        Users                @relation("RefundRequestRequestedBy", fields: [requested_by_user_id], references: [id])
  decided_by          Users?               @relation("RefundRequestDecidedBy", fields: [decided_by_user_id], references: [id])

  @@index([client_org_id, status])
  @@index([clinic_id])
  @@index([appointment_payment_id])
}

// REQ177 -- a new, separate, minimal table rather than widening
// AppointmentPayments (whose appointment_id is NOT NULL) or making it
// polymorphic -- matches this schema's own established single-purpose-FK
// convention (Attachments vs. MessageAttachments were kept separate for
// the identical reason). Counter-payment only this pass (same
// cash/UPI/card/cheque tenders shape as RecordCounterPaymentInput) --
// pharmacy purchases are overwhelmingly in-person; an online-gateway path
// is deferred.
model PharmacyPayments {
  id                  String   @id @default(uuid())
  clinic_id           String
  client_org_id       String?
  patient_id          String
  prescription_id     String?
  amount              Int      // paise
  tenders_json        Json     // [{tender_type, amount, reference?}]
  gstin               String?
  hsn_sac_code        String?
  gst_rate            Float?
  cgst_amount         Int?
  sgst_amount         Int?
  igst_amount         Int?
  recorded_by_user_id String
  created_at          DateTime @default(now())

  clinic       Clinics              @relation(fields: [clinic_id], references: [id])
  client_org   ClientOrganizations? @relation(fields: [client_org_id], references: [id])
  patient      Patients             @relation(fields: [patient_id], references: [id])
  prescription Prescriptions?       @relation(fields: [prescription_id], references: [id])
  recorded_by  Users                @relation(fields: [recorded_by_user_id], references: [id])

  @@index([clinic_id])
  @@index([patient_id])
  @@index([client_org_id, created_at])
}

// REQ056 (US-BIL-03) -- a discount above the org's configured threshold
// cannot be applied inline by recordCounterPayment; it's queued here
// (status: pending) and a distinct, higher-role-gated mutation
// (approveDiscountRequest) either approves it -- replaying the stored
// tenders_json to actually create the AppointmentPayments row, stamping
// the approving manager's own id -- or rejects it, never creating a
// payment. expected_amount_paise is captured at request time so approval
// doesn't have to re-resolve pricing (a service's price could have
// changed between request and approval).
model DiscountApprovalRequests {
  id                    String    @id @default(uuid())
  appointment_id        String
  clinic_id             String
  client_org_id         String?
  requested_by_user_id  String
  discount_amount       Int       // paise
  discount_reason       String
  expected_amount_paise Int
  tenders_json          Json
  status                String    @default("pending") // pending | approved | rejected
  approved_by_user_id   String?
  decided_at            DateTime?
  resulting_payment_id  String?
  created_at            DateTime  @default(now())

  appointment Appointments         @relation(fields: [appointment_id], references: [id])
  clinic      Clinics              @relation(fields: [clinic_id], references: [id])
  client_org  ClientOrganizations? @relation(fields: [client_org_id], references: [id])
  requestedBy Users                @relation("DiscountRequestRequestedBy", fields: [requested_by_user_id], references: [id])
  approvedBy  Users?               @relation("DiscountRequestApprovedBy", fields: [approved_by_user_id], references: [id])

  @@index([client_org_id, status])
  @@index([clinic_id])
  @@index([appointment_id])
}

// REQ056 (US-BIL-04, scoped subset) -- one closeout per (clinic,
// business_date): expected totals are computed server-side from real
// succeeded AppointmentPayments/PaymentTenders rows for that clinic and
// date, never trusted from the caller. breakdown_json is keyed by tender
// type ({ [tender_type]: { expected_paise, counted_paise } }), matching
// this schema's own convention for a small, tender-type-keyed map
// (Products.channel_pricing_json) rather than a fixed column per type.
// Denomination-level breakdown and formal shift handover are explicitly
// deferred -- see REQ056's own "out of scope" section.
model CashDrawerCloseouts {
  id                   String   @id @default(uuid())
  clinic_id            String
  client_org_id        String?
  closed_by_user_id    String
  business_date        DateTime
  breakdown_json       Json
  total_expected_paise Int
  total_counted_paise  Int
  variance_paise       Int
  notes                String?
  created_at           DateTime @default(now())

  clinic     Clinics              @relation(fields: [clinic_id], references: [id])
  client_org ClientOrganizations? @relation(fields: [client_org_id], references: [id])
  closedBy   Users                @relation(fields: [closed_by_user_id], references: [id])

  @@unique([clinic_id, business_date])
  @@index([client_org_id])
}

// REQ047 (US-BIL-09) -- gapless, per-branch invoice numbering ("PRD §14.2's
// explicit constraint"). One row per (clinic, series, financial_year);
// `last_number` only ever increments via a single atomic UPDATE/upsert, so
// two concurrent payments for the same clinic can never be assigned the same
// number or leave a gap. `series` defaults to "APPT" (this slice's own
// numbering stream) so a future pharmacy invoice stream (REQ022) can share
// this same table under a different series without colliding.
model InvoiceSequences {
  id             String   @id @default(uuid())
  clinic_id      String
  series         String   @default("APPT")
  financial_year String   // e.g. "2026-27" (April-March)
  last_number    Int      @default(0)
  updated_at     DateTime @updatedAt

  clinic Clinics @relation(fields: [clinic_id], references: [id])

  @@unique([clinic_id, series, financial_year])
}

model Reviews {
  id             String   @id @default(uuid())
  appointment_id String
  patient_id     String
  clinician_id   String?
  clinic_id      String?
  stars          Int      // 1-5
  comment        String
  response       String?
  responded_at   DateTime?
  is_deleted     Boolean  @default(false)
  created_at     DateTime @default(now())

  appointment Appointments @relation(fields: [appointment_id], references: [id])
  patient     Patients     @relation(fields: [patient_id], references: [id])
  clinician   Clinicians?  @relation(fields: [clinician_id], references: [id])
  clinic      Clinics?     @relation(fields: [clinic_id], references: [id])

  @@unique([appointment_id]) // P1-06 — one review per appointment; supersedes the plain index this replaces
  @@index([clinic_id, is_deleted])
  @@index([clinician_id])
  @@index([patient_id])
}

model MessageThreads {
  id            String   @id @default(uuid())
  client_org_id String
  last_message  String?
  last_activity DateTime @default(now())
  created_at    DateTime @default(now())
  // REQ043/REQ024 -- shared-inbox assignment + SLA timer. Both nullable: an
  // unassigned thread has no owner and no clock running yet. sla_due_at is
  // set once, on first assignment (see assignThread()), not recomputed on
  // reassignment -- reassigning a thread doesn't buy the org more time.
  assigned_to_user_id String?
  sla_due_at          DateTime?
  // REQ058 (US-MSG-01) — staff_internal (default, matches every thread
  // this module has ever created before this slice) | patient_clinic
  // (a future, still-P1 story per REQ024's own doc — not built here).
  // department_id/clinic_id are both nullable: an unscoped thread (the
  // default, both null) is visible only to its explicit participants,
  // exactly like every thread today; a scoped thread additionally has
  // every department/clinic member auto-added as a participant at create
  // time (see createThread()'s own comment on why this is create-time
  // membership, not a dynamic read-time visibility rule).
  thread_type   String  @default("staff_internal")
  department_id String?
  clinic_id     String?

  client_org   ClientOrganizations   @relation(fields: [client_org_id], references: [id])
  assigned_to  Users?                @relation("MessageThreadAssignee", fields: [assigned_to_user_id], references: [id])
  department   Departments?          @relation(fields: [department_id], references: [id])
  clinic       Clinics?              @relation(fields: [clinic_id], references: [id])
  participants MessageParticipants[]
  messages     Messages[]

  @@index([client_org_id, last_activity])
  @@index([assigned_to_user_id])
  @@index([department_id])
  @@index([clinic_id])
}

model MessageParticipants {
  id         String   @id @default(uuid())
  thread_id  String
  user_id    String
  unread_count Int    @default(0)

  thread MessageThreads @relation(fields: [thread_id], references: [id])
  user   Users          @relation(fields: [user_id], references: [id])

  @@unique([thread_id, user_id])

  @@index([user_id])
}

model Messages {
  id         String   @id @default(uuid())
  thread_id  String
  from_id    String
  body       String
  read_at    DateTime?
  sent_at    DateTime @default(now())

  thread      MessageThreads      @relation(fields: [thread_id], references: [id])
  from        Users               @relation(fields: [from_id], references: [id])
  attachments MessageAttachments[]

  @@index([thread_id, sent_at])
  @@index([from_id])
}

// REQ058 (US-MSG-01) — one row per file, always attached to a specific
// message (not the thread itself), matching how a real chat attachment
// works. Reuses attachments.controller.ts's exact upload pattern (multer
// in-memory, magic-byte signature allow-list, manual bearer verify) via a
// new sibling REST controller in this module rather than widening
// Attachments' own hard-required, single-purpose encounter_id FK — every
// other FK in this schema is single-purpose the same way (e.g.
// Departments.clinic_id), not polymorphic.
model MessageAttachments {
  id                String   @id @default(uuid())
  message_id        String
  file_ref          String
  mime_type         String
  original_filename String
  uploaded_by_id    String
  created_at        DateTime @default(now())

  message     Messages @relation(fields: [message_id], references: [id])
  uploaded_by Users    @relation(fields: [uploaded_by_id], references: [id])

  @@index([message_id])
}

// REQ058 (US-MSG-03) — org-scoped, staff-authored. Inserting one populates
// the compose body client-side (frontend, deferred per this batch's own
// confirmed direction) -- this is CRUD + list only.
model CannedReplies {
  id                String   @id @default(uuid())
  client_org_id     String
  created_by_user_id String
  title             String
  body              String
  is_deleted        Boolean  @default(false)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  client_org  ClientOrganizations @relation(fields: [client_org_id], references: [id])
  created_by  Users               @relation(fields: [created_by_user_id], references: [id])

  @@index([client_org_id, is_deleted])
}

model Permissions {
  id          String   @id @default(uuid())
  name        String   @unique
  description String   @default("")
  resource    String
  action      String
  created_at  DateTime @default(now())

  rolePermissions RolePermissions[]
}

// A rule is either clinic-scoped (a clinic-wide default policy) or
// product-scoped (a per-service override) -- exactly one of product_id/
// clinic_id is set, enforced by a CHECK constraint added in this model's
// extension migration (Prisma doesn't model CHECK constraints declaratively,
// so it's hand-written in the migration.sql, not expressed here). Originally
// product-only; admin/Policies.jsx's real, already-written GraphQL contract
// (name/description/priority/clinic_id, no product_id at all) needed the
// clinic-scoped half added rather than building a second, parallel model.
model ProductCancellationRules {
  id                     String      @id @default(uuid())
  name                   String
  description            String?
  product_id             String?
  clinic_id              String?
  client_org_id          String?
  rule_type              RuleType    @default(cancellation)
  hours_before_appointment Int      @default(24)
  fee_type               FeeType
  fee_amount             Int      // paise
  priority               Int        @default(1)
  is_active              Boolean    @default(true)
  is_deleted             Boolean    @default(false)
  created_at             DateTime   @default(now())
  updated_at             DateTime   @default(now())

  product     Products?          @relation(fields: [product_id], references: [id])
  clinic      Clinics?           @relation(fields: [clinic_id], references: [id])
  clientOrg   ClientOrganizations? @relation(fields: [client_org_id], references: [id])

  @@index([client_org_id, is_deleted])
  @@index([product_id])
  @@index([clinic_id])
}

model ProductCategories {
  id           String   @id @default(uuid())
  clinic_id    String?
  // BUG001 — Products/Categories/Subcategories never had a client_org_id of
  // their own; every create path left clinic_id null too, so the old
  // clinic-relation tenant filter silently matched nothing for a caller's own
  // rows and skipped the check entirely on findOne. Stamped from the JWT at
  // create time, decoupled from any specific clinic — see BUG001 for why an
  // org-wide catalog is the right model here, not a per-clinic one.
  client_org_id String?
  name         String
  description  String   @default("")
  is_active    Boolean  @default(true)
  is_deleted   Boolean  @default(false)
  created_at   DateTime @default(now())

  clinic            Clinics? @relation(fields: [clinic_id], references: [id])
  client_org        ClientOrganizations? @relation(fields: [client_org_id], references: [id])
  subcategories     ProductSubcategories[]
  products          Products[]

  @@index([client_org_id, is_deleted])
}

model ProductSubcategories {
  id           String   @id @default(uuid())
  clinic_id    String?
  client_org_id String?  // BUG001 — see ProductCategories.client_org_id
  category_id  String
  name         String
  description  String   @default("")
  is_active    Boolean  @default(true)
  is_deleted   Boolean  @default(false)
  created_at   DateTime @default(now())

  clinic    Clinics? @relation(fields: [clinic_id], references: [id])
  client_org ClientOrganizations? @relation(fields: [client_org_id], references: [id])
  category  ProductCategories @relation(fields: [category_id], references: [id])
  products  Products[]

  @@index([client_org_id, is_deleted])
  @@index([category_id])
}

model ProductVariations {
  id              String   @id @default(uuid())
  product_id      String
  variation_name  String
  sku             String   @unique
  price           Int      // paise
  duration_minutes Int?    // overrides the parent Product's duration for this variation (e.g. "30 min" vs "60 min" session)
  stock_quantity  Int      @default(0)
  is_active       Boolean  @default(true)
  is_deleted      Boolean  @default(false)
  created_at      DateTime @default(now())

  product Products @relation(fields: [product_id], references: [id])
  appointments Appointments[]

  @@index([product_id])
}

// REQ044/REQ016 -- first slice of catalog-master-data's drug master.
// client_org_id null = platform-seeded reference data, visible to every
// tenant; non-null = a tenant's own custom addition, visible only to that
// tenant (never leaking into another org's catalogue, per REQ016's own
// acceptance criteria). No real licensed drug database is wired up yet --
// PRD §19 Open Question 4 (sourcing) is unresolved -- so this ships the
// schema plus a small manually-curated seed set, matching REQ016's own
// explicit fallback recommendation for the interim.
model Drugs {
  id             String   @id @default(uuid())
  client_org_id  String?
  name           String
  composition    String?
  strength       String?
  form           String?
  schedule_class String?
  // REQ026 (US-RX-06, FR-RX-10/11) — Telemedicine Practice Guidelines
  // list membership: 'O' (OTC, any tele mode) | 'A' (safe for first
  // video consult or any-mode follow-up) | 'B' (follow-up only, blocked
  // on a first teleconsultation) | 'prohibited' (NDPS/Schedule X, never
  // teleconsult-prescribable, no override). Deliberately a SEPARATE
  // classification from schedule_class (India's Drugs and Cosmetics Act
  // schedule, a different regulatory dimension) — nullable and
  // fail-closed: an unclassified drug is blocked in any tele mode until
  // an admin explicitly reviews it against the real published TPG
  // annexures, not guessed at from schedule_class. The one seed backfill
  // this migration performs (OTC → 'O') is the one mapping direction
  // that's genuinely unambiguous.
  tpg_list       String?
  hsn            String?
  gst_rate       Float?
  manufacturer   String?
  // REQ022 (US-PHR-09, scoped) — a per-drug reorder threshold. Null means
  // no low-stock alert is configured for this drug (fail-safe default,
  // matching every other optional-behavior-toggle field in this schema) —
  // an org must explicitly set one before the alert can ever fire.
  // Deliberately org-wide per drug, not per-clinic: a drug's own reasonable
  // reorder point doesn't usually vary by branch, and per-clinic overrides
  // can be added later without a breaking change if that assumption proves
  // wrong.
  reorder_level  Int?
  // REQ179 (IPD slice 3) -- drug | consumable | implant | surgical_item |
  // oxygen. Defaults to 'drug' so every existing drug picker (prescription
  // builder, MAR order search) keeps working unchanged: none of them pass
  // this filter explicitly, and the resolver defaults it to 'drug' when
  // omitted -- gauze/implants never silently appear in a prescription
  // autocomplete just because this column now exists.
  item_type      String   @default("drug")
  is_deleted     Boolean  @default(false)
  created_at     DateTime @default(now())
  updated_at     DateTime @default(now())

  client_organization ClientOrganizations? @relation(fields: [client_org_id], references: [id])
  prescriptionItems    PrescriptionItems[]
  prescriptionSetItems PrescriptionSetItems[]
  batches              DrugBatches[]
  // REQ173 -- clinicians who have starred this drug for quick re-selection.
  favouritedBy         ClinicianFavouriteDrugs[]

  @@index([client_org_id, is_deleted])
  @@index([item_type])

  // REQ179 (IPD slice 2)
  ipdMedicationOrders IpdMedicationOrders[]
  medicationAdministrations MedicationAdministrations[]

  // REQ179 (IPD slice 3)
  otConsumables OtConsumables[]
}

// REQ173 -- a clinician's own single-drug quick-pick list ("don't make me
// re-search this every time"), distinct from PrescriptionSets above (a
// named multi-drug bundle/preset). The unique constraint makes favouriting
// an already-favourited drug a harmless no-op at the DB level, not just an
// application-level check.
model ClinicianFavouriteDrugs {
  id           String   @id @default(uuid())
  clinician_id String
  drug_id      String
  created_at   DateTime @default(now())

  clinician Clinicians @relation(fields: [clinician_id], references: [id])
  drug      Drugs      @relation(fields: [drug_id], references: [id])

  @@unique([clinician_id, drug_id])
  @@index([clinician_id])
}

model Products {
  id                String   @id @default(uuid())
  clinic_id         String?
  client_org_id     String?  // BUG001 — see ProductCategories.client_org_id
  category_id       String?
  subcategory_id    String?
  name              String
  description       String   @default("")
  product_type      ProductType
  sku               String   @unique
  price             Int?     // paise
  // manager/products/{create,edit}.jsx's real "Stock Qty" field — no column
  // existed for it at all before (context/frontend-integration-audit.md #17-19).
  stock_quantity    Int?     @default(0)
  duration_minutes  Int?     // required for a bookable service (test-cases/08-products-services flagged this as missing — a clinical service needs a duration to generate slots)
  order_by          Int      @default(0)
  is_active         Boolean  @default(true)
  is_deleted        Boolean  @default(false)
  created_at        DateTime @default(now())
  // REQ046 (US-CAT-06) — GST classification. hsn is free text (no HSN master
  // table yet); is_tax_exempt defaults per creation path, not per row: a
  // clinical service (services.service.ts) defaults true (healthcare
  // consultations are GST-exempt under current Indian tax treatment), a
  // retail/pharmacy product (products.service.ts) defaults false — either is
  // explicitly overridable per item, the default only fills in what an admin
  // didn't set.
  hsn               String?
  is_tax_exempt     Boolean  @default(false)
  // REQ014 (US-ORG-03) — same optional specialty grouping as Clinicians.
  department_id     String?
  // REQ016 (US-CAT-04) — { [patient_category]: paise } / { online?, walkin?: paise }.
  // Both nullable Json, matching price's own paise unit -- resolved via the
  // one shared resolveServicePrice() helper (backend/src/common/pricing/),
  // never read directly at a call site.
  category_pricing_json Json?
  channel_pricing_json  Json?
  // REQ018 (US-BOOK-03) — required | optional | none. "required": a booking
  // for this service does not confirm until AppointmentPayments succeeds
  // (createAppointment leaves status: 'requested', not 'confirmed'); "none"
  // (the default) preserves today's behaviour — a booking confirms
  // immediately regardless of payment. Free text, not a Prisma enum, matching
  // this model's own patient_category/product_type convention.
  prepayment_policy String @default("none")
  // REQ101 — mirrors Drugs.gst_rate's own convention (e.g. 18.0 for 18%).
  // Null until an admin sets it; AppointmentPayments' own GST split stays
  // null (never guessed) until both this AND the paying clinic's gstin
  // are set — see invoiceDetailsForSuccess()'s own comment.
  gst_rate          Float?

  clinic            Clinics? @relation(fields: [clinic_id], references: [id])
  client_org        ClientOrganizations? @relation(fields: [client_org_id], references: [id])
  category          ProductCategories? @relation(fields: [category_id], references: [id])
  subcategory       ProductSubcategories? @relation(fields: [subcategory_id], references: [id])
  department        Departments? @relation(fields: [department_id], references: [id])
  variations        ProductVariations[]
  appointments      Appointments[]
  cancellationRules ProductCancellationRules[]
  clinicianServices ClinicianServices[]
  checklistItems    ChecklistItems[]
  intakeFieldConfigs ClinicIntakeFieldConfig[]
  packageItems      PackageItems[]
  branchOverrides   ProductBranchOverrides[]
  priceHistory      PriceHistory[]
  payerTariffs      PayerTariffs[]

  @@index([client_org_id, is_deleted])
  @@index([category_id])
  @@index([subcategory_id])
  @@index([clinic_id])
  @@index([department_id])

  // REQ179 (IPD slice 1) — a ward/bed room-day tariff is a Products row,
  // so it inherits resolveServicePrice()/PayerTariffs/GST for free.
  wardsBedCharge     Wards[] @relation("WardBedChargeProduct")
  wardsNursingCharge Wards[] @relation("WardNursingChargeProduct")
  bedsBedCharge      Beds[]  @relation("BedChargeProduct")

  // REQ179 (IPD slice 4)
  ipdBillingSettingsDoctorVisit IpdBillingSettings[]
  ipdCharges                    IpdCharges[]
  operationTheatresUsageCharge  OperationTheatres[] @relation("OtUsageChargeProduct")
  ipdPackageInclusions          IpdPackageInclusions[]
}

// REQ016 (US-CAT-05) — every price change logged with who/when/old/new. A
// change with a future effective_from is recorded immediately but not
// applied to Products.price until that date arrives (applied flips to true
// when PriceHistorySweepService's own cron applies it) — the acceptance
// criterion's own "prior price remains visible in the audit history for
// bills issued before the change" is satisfied by this row never being
// mutated after creation, only ever appended to.
model PriceHistory {
  id             String   @id @default(uuid())
  product_id     String
  client_org_id  String?
  old_price      Int? // paise; null for the very first price ever set on a product
  new_price      Int  // paise
  effective_from DateTime @default(now())
  applied        Boolean  @default(true) // false only while effective_from is still in the future
  changed_by_user_id String
  created_at     DateTime @default(now())

  product   Products @relation(fields: [product_id], references: [id])
  changedBy Users    @relation(fields: [changed_by_user_id], references: [id])

  @@index([product_id, created_at])
  @@index([applied, effective_from])
}

// REQ055 (US-ORG-05) — "masters cascade". A clinical service created via
// ServiceInput (services.service.ts) is already, today, an org-level
// master: it's created with clinic_id: null and every branch of the org
// sees it identically (findAll's clinic_id filter is optional). What was
// missing is a per-branch deviation: this table lets one specific clinic
// either inherit the master unchanged (the default — no row at all, exactly
// today's existing behaviour, zero migration risk for the ~all existing
// services), override its price/category/channel pricing for that branch
// only, or skip offering it there entirely. Deliberately NOT a second
// pricing lookup: resolveServicePrice() (common/pricing/resolve-price.ts)
// takes this row as an optional 4th argument and resolves it inline, same
// as ProductCancellationRules' own "most specific row wins" precedent but
// keyed 1:1 per (product, clinic) rather than priority-ordered, since a
// clinic can only ever have one stance (inherit/override/skip) per master
// service.
model ProductBranchOverrides {
  id                              String   @id @default(uuid())
  product_id                      String
  clinic_id                       String
  client_org_id                   String?
  mode                            String   @default("inherit") // inherit | override | skip
  override_price                  Int?     // paise; required by the service layer when mode = 'override'
  override_category_pricing_json  Json?
  override_channel_pricing_json   Json?
  created_at                      DateTime @default(now())
  updated_at                      DateTime @default(now())

  product    Products             @relation(fields: [product_id], references: [id])
  clinic     Clinics              @relation(fields: [clinic_id], references: [id])
  clientOrg  ClientOrganizations? @relation(fields: [client_org_id], references: [id])

  @@unique([product_id, clinic_id])
  @@index([client_org_id])
  @@index([clinic_id])
}

model RolePermissions {
  id            String   @id @default(uuid())
  role_id       String
  permission_id String
  is_deleted    Boolean  @default(false)
  created_at    DateTime @default(now())

  role       UserRoles   @relation(fields: [role_id], references: [id])
  permission Permissions @relation(fields: [permission_id], references: [id])

  @@index([role_id])
  @@index([permission_id])
}

model RoomBlocks {
  id          String   @id @default(uuid())
  room_id     String
  clinic_id   String
  block_date  DateTime
  start_time  DateTime
  end_time    DateTime
  reason      String   @default("")
  is_recurring Boolean @default(false)
  is_deleted  Boolean  @default(false)
  created_at  DateTime @default(now())
  // manager/Blocks.jsx's roomBlocks query requests these three — mirrors
  // SpacerBlocks' already-existing fields exactly (backend-hard-rules.md Rule 9).
  recurrence_type RecurrenceType @default(single)
  recurrence_days Json?
  end_date        DateTime?

  room   Rooms   @relation(fields: [room_id], references: [id])
  clinic Clinics @relation(fields: [clinic_id], references: [id])

  @@index([room_id, block_date])
  @@index([clinic_id, is_deleted])
}

model Rooms {
  id          String   @id @default(uuid())
  clinic_id   String
  room_number String
  room_type   String   @default("consultation")
  clinician_type String?
  capacity    Int?     // frontend Create/Edit Room forms require this (test-cases/07-clinics-rooms) — was missing from schema
  is_active   Boolean  @default(true)
  is_deleted  Boolean  @default(false)
  created_at  DateTime @default(now())

  clinic Clinics @relation(fields: [clinic_id], references: [id])
  availability ClinicianAvailability[]
  appointments Appointments[]
  roomBlocks   RoomBlocks[]
  spacerBlocks SpacerBlocks[]

  @@index([clinic_id, is_deleted])
}

// REQ017 multi-resource booking. Unlike Rooms (scoped only via its clinic
// relation), Resources owns client_org_id directly, matching REQ014's own
// spec for this table -- a resource (e.g. an ECG machine) is an org-level
// asset assigned to one clinic, not a clinic-owned concept the way a room
// is. `type` is free text (e.g. 'equipment'|'chair'|'machine'|'bay'),
// following the same "lookup value stored as text" convention already used
// for Rooms.room_type/Clinicians.clinician_type, not a Prisma relation.
model Resources {
  id            String   @id @default(uuid())
  client_org_id String
  clinic_id     String
  name          String
  type          String   @default("equipment")
  is_bookable   Boolean  @default(true)
  is_deleted    Boolean  @default(false)
  created_at    DateTime @default(now())

  client_organization ClientOrganizations     @relation(fields: [client_org_id], references: [id])
  clinic              Clinics                 @relation(fields: [clinic_id], references: [id])
  appointmentResources AppointmentResources[]

  @@index([client_org_id, clinic_id])
  @@index([clinic_id, is_bookable, is_deleted])
}

// REQ014 (US-ORG-03) — specialty grouping (Cardiology, Dental, Physio) so
// clinicians/services can be organized and reported on by department.
// Owns client_org_id directly, same shape as Resources above (an org-level
// concept assigned to one clinic), not Rooms' via-relation-only pattern.
model Departments {
  id            String   @id @default(uuid())
  client_org_id String
  clinic_id     String
  name          String
  is_deleted    Boolean  @default(false)
  created_at    DateTime @default(now())

  client_organization ClientOrganizations @relation(fields: [client_org_id], references: [id])
  clinic              Clinics             @relation(fields: [clinic_id], references: [id])
  clinicians          Clinicians[]
  products            Products[]
  messageThreads      MessageThreads[]
  staffMembers        UserProfiles[]

  @@index([client_org_id, clinic_id])

  // REQ179 (IPD slice 1)
  admissions Admissions[]

  // REQ179 (IPD slice 2)
  dischargeSummaryTemplates DischargeSummaryTemplates[]
}

// Join table for multi-resource intersection booking (REQ017 US-CAL-05).
// start_at/end_at are a denormalized copy of the parent appointment's own
// time range, set at insert time -- Postgres EXCLUDE predicates can only
// reference the constrained table's own columns, so this table needs its
// own range rather than joining to Appointments inside the constraint.
// Rows are deleted (not status-filtered) when the parent appointment is
// cancelled/no_show'd/soft-deleted, so "no row for this resource at this
// time" needs no status column at all. Resource assignment is immutable
// after creation in this slice; a reschedule that changes the parent
// appointment's time also updates these rows' start_at/end_at in the same
// transaction so the exclusion constraint stays meaningful (see
// appointments.service.ts and open question #14, the same already-accepted
// gap for room reassignment on reschedule).
//
// The actual `EXCLUDE USING gist (resource_id WITH =, tsrange(start_at,
// end_at, '[)') WITH &&)` constraint is added in this model's own
// migration (Prisma has no EXCLUDE-constraint syntax) -- see
// backend/prisma/migrations/<ts>_scheduling_engine_session_mode.
model AppointmentResources {
  id             String   @id @default(uuid())
  appointment_id String
  resource_id    String
  start_at       DateTime
  end_at         DateTime

  appointment Appointments @relation(fields: [appointment_id], references: [id], onDelete: Cascade)
  resource    Resources    @relation(fields: [resource_id], references: [id])

  @@unique([appointment_id, resource_id])
  @@index([resource_id])
}

// REQ106 — one of REQ017's four deferred P1 items (waitlist for a fully-
// booked clinician/date). One row per (clinician, date, patient); notified
// with a time-boxed claim window on cancellation/no-show, never auto-booked.
enum WaitlistStatus {
  waiting
  notified
  claimed
  expired
  cancelled
}

model WaitlistEntries {
  id               String         @id @default(uuid())
  client_org_id    String
  clinic_id        String
  clinician_id     String
  patient_id       String
  waitlist_date    DateTime
  status           WaitlistStatus @default(waiting)
  position         Int
  notified_at      DateTime?
  claim_expires_at DateTime?
  created_at       DateTime       @default(now())
  updated_at       DateTime       @default(now())

  clinic    Clinics    @relation(fields: [clinic_id], references: [id])
  clinician Clinicians @relation(fields: [clinician_id], references: [id])
  patient   Patients   @relation(fields: [patient_id], references: [id])

  @@index([clinician_id, waitlist_date, status])
  @@index([client_org_id])
  @@index([patient_id])
}

model SpacerBlocks {
  id             String        @id @default(uuid())
  clinician_id   String
  clinic_id      String
  room_id        String?
  block_date     DateTime?
  start_time     DateTime
  end_time       DateTime
  reason         String         @default("")
  is_deleted     Boolean        @default(false)
  created_at     DateTime       @default(now())
  recurrence_type RecurrenceType @default(single)
  recurrence_days Json?
  end_date       DateTime?

  clinician Clinicians @relation(fields: [clinician_id], references: [id])
  clinic    Clinics    @relation(fields: [clinic_id], references: [id])
  room      Rooms?     @relation(fields: [room_id], references: [id])

  @@index([clinician_id, block_date])
  @@index([clinic_id, is_deleted])
  @@index([room_id])
}

model StripeConfigurations {
  id                 String   @id @default(uuid())
  client_org_id      String   @unique
  stripe_account_id  String?
  stripe_publishable_key String?
  stripe_webhook_secret String?
  is_active          Boolean  @default(true)
  is_deleted         Boolean  @default(false)
  created_at         DateTime @default(now())
  updated_at         DateTime @default(now())

  client_organization ClientOrganizations @relation(fields: [client_org_id], references: [id])
}

model SubscriptionPlans {
  id            String   @id @default(uuid())
  name          String   @unique
  description   String
  price_monthly Int      @default(0) // paise
  price_yearly  Int      @default(0) // paise
  max_clinics   Int      @default(1)
  max_users     Int      @default(5)
  features      Json     @default("{}")
  is_active     Boolean  @default(true)
  is_deleted    Boolean  @default(false)
  created_at    DateTime @default(now())

  subscriptions OrganizationSubscriptions[]
}

//
// USERS FROM auth.users TABLE
//

model Users {
  id String @id @default(uuid())

  auditLogs    AuditLogs[] @relation("AuditLogUser")
  auditLogsActingAs AuditLogs[] @relation("AuditLogActingAs")
  breakGlassGrants BreakGlassGrants[]
  impersonationSessionsAsActor ImpersonationSessions[] @relation("ImpersonationRealActor")
  impersonationSessionsAsTarget ImpersonationSessions[] @relation("ImpersonationTarget")
  notifications Notifications[]
  userProfiles  UserProfiles?
  messageParticipants MessageParticipants[]
  messages      Messages[]
  ownedOrganizations ClientOrganizations[] @relation("OrganizationOwner")
  notificationPreferences NotificationPreferences[]
  notificationSendLogs    NotificationSendLog[]
  paymentTendersRecorded  PaymentTenders[]
  assignedMessageThreads MessageThreads[] @relation("MessageThreadAssignee")
  appointmentPaymentsApproved AppointmentPayments[] @relation("AppointmentPaymentApprovedBy")
  discountRequestsMade        DiscountApprovalRequests[] @relation("DiscountRequestRequestedBy")
  discountRequestsApproved    DiscountApprovalRequests[] @relation("DiscountRequestApprovedBy")
  cashDrawerCloseouts         CashDrawerCloseouts[]
  messageAttachmentsUploaded  MessageAttachments[]
  cannedRepliesCreated        CannedReplies[]
  priceChangesRecorded        PriceHistory[]
  tasksAssigned               Tasks[] @relation("TaskAssignee")
  tasksCreated                Tasks[] @relation("TaskCreatedBy")
  // REQ176/177
  refundRequestsMade    RefundRequests[] @relation("RefundRequestRequestedBy")
  refundRequestsDecided RefundRequests[] @relation("RefundRequestDecidedBy")
  pharmacyPaymentsRecorded PharmacyPayments[]
}

// REQ005 Notifications tab. No code path in this codebase currently reads
// these to decide whether to actually send anything (NotificationsService.create()
// has zero callers today, and there's no real email/SMS sending infra beyond
// the OTP-SMS stub) -- see context/open-questions.md. This table is real,
// persisted storage for the preference itself, not yet wired to a trigger.
model NotificationPreferences {
  id            String                @id @default(uuid())
  user_id       String
  event_type    NotificationEventType
  email_enabled Boolean               @default(true)
  sms_enabled   Boolean               @default(false)
  app_enabled   Boolean               @default(true)
  // REQ025 (US-NOT-01 remainder) — mirrors email_enabled/sms_enabled/
  // app_enabled's own nullability/default style exactly.
  whatsapp_enabled Boolean            @default(true)
  // REQ025 (US-NOT-04) — "HH:MM", matching ClinicianAvailability's own
  // string time-of-day convention already used elsewhere in this schema.
  // Per-user, not per-org: a patient's own quiet hours, not a clinic's
  // operating hours (a different, already-existing concept).
  quiet_hours_start String?
  quiet_hours_end   String?
  created_at    DateTime              @default(now())
  updated_at    DateTime              @default(now())

  user Users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, event_type])
}

// REQ025 (US-NOT-04) — minimal per-user daily send count, just enough to
// enforce a frequency cap. Not a full delivery-analytics table (that's
// US-NOT-05, P1, out of scope here) -- one row per actual external send
// (WhatsApp/SMS only, not the in-app notification, which isn't disruptive).
model NotificationSendLog {
  id         String   @id @default(uuid())
  user_id    String
  event_type String
  channel    String
  sent_at    DateTime @default(now())
  // REQ025 (US-NOT-05) — this row used to be written only on a confirmed
  // successful external send (see notification-trigger.service.ts's own
  // history); a failed attempt left no record at all, so "delivery
  // analytics" had no failures to show. Now written on every attempt.
  // client_org_id is denormalized from the recipient at write time (the
  // same trade-off orgScopeVia's own sibling denormalized columns make
  // elsewhere in this schema) so the analytics query is a single indexed
  // WHERE, not a join through Users for every row.
  status        String  @default("sent") // sent | failed
  error_message String?
  client_org_id String?

  // P1-01/REQ144 — Meta's WhatsApp Business API prices per-conversation by
  // category, not per-notification-type, and from 1 Oct 2026 utility/service
  // conversations inside the 24h window stop being free (PRD-v2-CareOS.md
  // §pricing). template_category is resolved server-side from a fixed
  // event-type map (resolveTemplateCategory() in
  // notification-trigger.service.ts) -- never caller-supplied -- so a
  // transactional event can never be sent, even deliberately, as the 7.5x
  // more expensive 'marketing' category. Only set for channel='whatsapp';
  // null for app/sms/email, which this table also logs but which this
  // Meta-specific pricing model doesn't apply to.
  template_category String? // utility | marketing | authentication
  billable           Boolean @default(false)
  // Meta's real per-message rates are sub-paise (utility ₹0.1150 = 11.50
  // paise), so the schema's usual "money as Int paise" convention
  // (CLAUDE.md Hard Rule 9) has no precision to represent them. This column
  // uses micro-rupees (1 rupee = 1,000,000) instead, the smallest scaled-
  // integer unit that makes ₹0.1150 and ₹0.8631 both exact integers
  // (115000 and 863100) -- converted to rupees only at the resolver
  // boundary, same discipline as every other money field, just a different
  // scale for this one Meta-billing table.
  cost_micro_rupees Int?

  user Users @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, sent_at])
  @@index([client_org_id, event_type, sent_at])
  @@index([client_org_id, channel, template_category, sent_at])
}

model UserProfiles {
  id            String   @id
  role_id       String
  first_name    String
  last_name     String
  email         String   @unique
  password      String
  phone         String?  @unique // OTP login requires an unambiguous phone→account lookup
  phone_country_code String?
  address_line1 String?
  address_line2 String?
  city          String?
  postal_code   String?
  country       String?
  user_image    String?
  clinic_id     String?
  clinician_id  String?
  patient_id    String?
  is_active     Boolean  @default(true)
  is_deleted    Boolean  @default(false)
  created_at    DateTime @default(now())
  updated_at    DateTime @default(now())
  client_org_id String?
  // admin/users/index.jsx's getUsers requests lastLoginAt/profile{avatarUrl} —
  // neither existed before the Users/RBAC increment.
  last_login_at DateTime?
  avatar_url    String?
  // staff/{index,edit,new}.jsx — Staff is UserProfiles scoped to non-clinician,
  // non-patient roles, reusing the Users/RBAC module rather than a dedicated
  // Staff table (next-10-features-implementation-plan.md #7). department/
  // job_title/notes/staff_status have no other home in the existing schema.
  department    String?
  job_title     String?
  notes         String?
  staff_status  String?  @default("active")
  // context/open-questions.md #3 — real, backdatable employment start date,
  // distinct from created_at (the row's actual creation timestamp). Null for
  // every staff row created before this column existed; toGraphQL() falls
  // back to created_at for those so `since` is never null in the API.
  staff_since   DateTime?

  // add these for forgot-password
  password_reset_token   String?
  password_reset_expires DateTime?

  email_verified           Boolean   @default(false)
  email_verification_token String?
  email_verification_expires DateTime?

  // PLAN016 (REQ005 remainder) — settings/index.jsx's Profile tab. address_structured
  // matches Patients/ClientOrganizations' exact {line1, line2, city, state, pincode,
  // country} shape (the modern, actively-used convention project-wide) rather than
  // this model's older address_line1/postal_code/no-state columns above, which are
  // never exposed in any GraphQL entity today — no compatibility surface to preserve.
  date_of_birth DateTime?
  gender        String?
  bio           String?
  address_structured Json?

  // BUG047 follow-up -- the caller's own light/dark/system preference,
  // synced across devices. `context/ThemeContext.jsx` still keeps a
  // localStorage copy for instant apply and logged-out/offline use; this
  // column is the cross-device source of truth once a session is
  // authenticated. Validated at the DTO layer (IsIn), not a DB enum, to
  // match every other free-text-ish preference column on this model.
  theme_mode String?

  // PLAN016 Slice C — real TOTP 2FA. Secret and backup codes are always
  // encrypted/hashed at rest, never stored or returned in plaintext.
  totp_secret_encrypted String?
  totp_enabled          Boolean  @default(false)
  totp_backup_codes     Json?    // array of bcrypt-hashed one-time codes

  // REQ102 — a separate, real FK to the clinical Departments entity, used
  // for message-thread auto-participant-add. Distinct from the free-text
  // `department` column above (an administrative label, e.g. "Front
  // Desk") — a staff member's administrative team and their clinical
  // department assignment are independent by design; see REQ102's own doc.
  department_id_ref String?

  user        Users                @relation(fields: [id], references: [id])
  role        UserRoles            @relation(fields: [role_id], references: [id])
  clinic      Clinics?             @relation(fields: [clinic_id], references: [id])
  clinician   Clinicians?          @relation(fields: [clinician_id], references: [id])
  patient     Patients?            @relation(fields: [patient_id], references: [id])
  departmentRef Departments?       @relation(fields: [department_id_ref], references: [id])
  client_org  ClientOrganizations? @relation(fields: [client_org_id], references: [id])
  orderedTestResults TestResults[]
  bookedAppointments Appointments[] @relation("AppointmentBookedBy")
  createdAppointmentSeries AppointmentSeries[]
  appointmentStatusLogs AppointmentStatusLogs[] @relation("StatusLogChangedBy")
  signedEncounters   Encounters[]            @relation("EncounterSignedBy")
  encounterAddenda   EncounterAddenda[]      @relation("AddendumAuthor")
  queueEvents        QueueEvents[]           @relation("QueueEventChangedBy")
  patientMergesPerformed PatientMerges[]     @relation("PatientMergePerformedBy")
  uploadedAttachments Attachments[]          @relation("AttachmentUploadedBy")
  recordedVitals     Vitals[]
  submittedClaims    Claims[]
  aiTranscriptionConsents AiTranscriptionSessions[]
  telemedicineRecordingConsents TelemedicineSessions[]
  importJobsCreated  ImportJobs[]
  // REQ167 (P2-11)
  administeredImmunizations ImmunizationRecords[]
  // REQ168 (P2-12)
  enrolledChronicRegistrations ChronicRegistryEnrollments[]
  // REQ174
  uploadedPatientDocuments PatientDocuments[] @relation("PatientDocumentUploadedBy")

  @@index([client_org_id, is_deleted])
  @@index([role_id])
  @@index([clinic_id])
  @@index([patient_id])
  @@index([clinician_id])
  @@index([department_id_ref])

  // REQ179 (IPD slice 1)
  bedOccupanciesCreated BedOccupancies[]  @relation("OccupancyCreatedBy")
  bedOccupanciesEnded   BedOccupancies[]  @relation("OccupancyEndedBy")
  admissionsCreated     Admissions[]      @relation("AdmissionCreatedBy")
  admissionEventsActed  AdmissionEvents[] @relation("AdmissionEventActor")
  mlcRegistersRecorded  MlcRegisters[]    @relation("MlcRecordedBy")
  mlcPoliceIntimated    MlcRegisters[]    @relation("MlcPoliceIntimatedBy")
  mlcAmendmentsMade     MlcAmendments[]   @relation("MlcAmendedBy")

  // REQ179 (IPD slice 2)
  medicationAdministrationsGiven   MedicationAdministrations[] @relation("MarAdministeredBy")
  medicationAdministrationsWitnessed MedicationAdministrations[] @relation("MarWitness")
  intakeOutputRecordsRecorded      IntakeOutputRecords[]        @relation("IoRecordedBy")
  admissionNotesAuthored           AdmissionNotes[]             @relation("AdmissionNoteAuthor")
  admissionNoteAddendaAuthored     AdmissionNoteAddenda[]       @relation("AdmissionNoteAddendumAuthor")
  shiftHandoversFrom               ShiftHandovers[]             @relation("HandoverFrom")
  shiftHandoversTo                 ShiftHandovers[]             @relation("HandoverTo")
  dischargeSummariesPrepared       DischargeSummaries[]         @relation("DsPreparedBy")

  // REQ179 (IPD slice 3)
  otBookingStaffAssignments OtBookingStaff[]
  otChecklistsCompleted     OtChecklists[]
  otConsumablesRecorded     OtConsumables[]

  // REQ179 (IPD slice 4)
  ipdBillsFinalized IpdBills[]
  ipdChargesPosted  IpdCharges[]
  ipdPaymentsRecorded IpdPayments[]

  // REQ179 (IPD slice 5)
  preAuthorizationsRequested     PreAuthorizations[]
  preAuthEnhancementsRequested   PreAuthEnhancements[]
  ipdClaimsSubmitted             IpdClaims[]
  ipdInsuranceDocumentsUploaded  IpdInsuranceDocuments[]
}

model UserRoles {
  id          String   @id @default(uuid())
  name        String
  description String   @default("")
  // null = platform-wide system role (admin/super_admin/manager/clinician/staff/patient,
  // seeded once, never org-specific); set = an org admin's own custom role
  // (requirements/custom-role-permission-management-requirements.md). Global
  // uniqueness among system roles (client_org_id IS NULL) is enforced at the
  // application layer, not this constraint — Postgres treats NULLs as distinct
  // in a composite unique index, so it wouldn't catch a duplicate among them;
  // in practice only the seed script creates those rows, via upsert.
  client_org_id String?
  is_system   Boolean  @default(false) // system roles can't be renamed/deleted by an org admin
  is_deleted  Boolean  @default(false)
  created_at  DateTime @default(now())
  // admin/users/index.jsx's getUserRoles/getUsers request roles{code} — a
  // short slug ('system_admin', 'clinic_manager', ...) distinct from the
  // display `name`, used client-side to key ROLE_STYLES. Nullable: falls back
  // to a slugified `name` at the resolver boundary when unset (users.service.ts).
  code        String?

  client_org      ClientOrganizations? @relation(fields: [client_org_id], references: [id])
  rolePermissions RolePermissions[]
  userProfiles   UserProfiles[]

  @@unique([client_org_id, name], name: "org_role_name", map: "org_role_name")

  @@index([client_org_id])
}

model Languages {
  id         String   @id @default(uuid())
  name       String   @unique
  code       String   @unique
  is_active  Boolean  @default(true)
  // admin/Languages.jsx (TC-ADMIN-UNIT-010/API-014): exactly one language is
  // ever the default — enforced in the service via a $transaction, not a DB constraint.
  is_default Boolean  @default(false)
  is_deleted Boolean  @default(false)
  created_at DateTime @default(now())

  clinicianLanguages ClinicianLanguages[]
}

// REQ108 — a curated ~100-code OPD-relevant starter set, not the full WHO
// ICD-10 (~14,000+ codes). Platform-global, like Languages above — no
// client_org_id, shared by every tenant by design. Diagnoses.icd10_code
// stays a free String? (soft validation only — a clinician can still save
// any text or leave it blank); this table exists to power the search
// dropdown, not to constrain the write.
model Icd10Codes {
  id          String  @id @default(uuid())
  code        String  @unique
  description String
  category    String
  is_active   Boolean @default(true)

  @@index([category])
}

// REQ154 (P2-02) — a curated OPD-relevant starter set of procedure/service
// codes, mirroring Icd10Codes' own shape and honesty note exactly: this is
// NOT a licensed CPT/HCPCS code set (both are proprietary US terminology
// systems this codebase has no license to redistribute) -- an internal,
// India-OPD-relevant reference list ("PR-" prefixed) covering the
// procedures a general/multi-specialty clinic actually performs. Platform-
// global, no client_org_id, same as Icd10Codes/Languages/Drugs.
model ProcedureCodes {
  id          String  @id @default(uuid())
  code        String  @unique
  description String
  category    String
  is_active   Boolean @default(true)

  @@index([category])
}

model ClinicianLanguages {
  id            String   @id @default(uuid())
  clinician_id  String
  language_id   String
  is_deleted    Boolean  @default(false)
  created_at    DateTime @default(now())

  clinician Clinicians @relation(fields: [clinician_id], references: [id], onDelete: Cascade)
  language  Languages  @relation(fields: [language_id], references: [id], onDelete: Cascade)

  @@unique([clinician_id, language_id])

  @@index([language_id])
}

// ============================================================
// REQ018 (US-BOOK-05) — embeddable booking widget per org/branch.
// booking/index.jsx already renders chrome-free for an anonymous caller
// (OptionalAuthShell, BUG011) — this table is just the allowlist/slug an
// org admin manages, not a new page.
// ============================================================
model BookingWidgetConfig {
  id              String   @id @default(uuid())
  client_org_id   String
  clinic_id       String?
  // JSON array of origin strings (e.g. ["https://acmeclinic.com"]) — the
  // widget iframe's parent origin must match one of these, checked at
  // request time by the resolver, not enforced at the DB layer.
  allowed_origins Json
  short_link_slug String   @unique
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now())

  client_organization ClientOrganizations @relation(fields: [client_org_id], references: [id])
  clinic              Clinics?            @relation(fields: [clinic_id], references: [id])

  @@index([client_org_id])
  @@index([clinic_id])
}

// ============================================================
// REQ032 (US-PLAN-01/02) — plan-builder data model and versioning only.
// Deliberately NOT wired to any entitlement guard yet (CLAUDE.md's own
// explicit caution: that integration is a separate, higher-risk future
// step). Platform-level, not tenant-scoped — a Plan is a shared catalog
// entry a super_admin manages, not a per-org record.
// ============================================================
model Plans {
  id         String   @id @default(uuid())
  name       String
  tier       String // starter | pro | enterprise, free text per this schema's own convention
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())

  versions      PlanVersions[]
  organizations ClientOrganizations[]
  subscriptions PlatformSubscriptions[]
}

model PlanVersions {
  id                String    @id @default(uuid())
  plan_id           String
  // Starts at 1, incremented per edit — US-PLAN-02's own acceptance
  // criterion: editing a live plan creates a NEW version row, never mutates
  // an existing one a subscriber may already be pinned to.
  version           Int
  effective_from    DateTime  @default(now())
  effective_until   DateTime?
  billing_period    String // monthly | annual
  price_paise       Int
  // { [featureFlag: string]: boolean } — e.g. { "pharmacy": true, "telemedicine": false }
  feature_flags_json Json
  // { [quotaName: string]: number } — e.g. { "max_clinician_seats": 10 }
  quotas_json        Json
  created_at        DateTime  @default(now())

  plan Plans @relation(fields: [plan_id], references: [id])
  subscriptions PlatformSubscriptions[]

  @@unique([plan_id, version])
  @@index([plan_id])
}

// ============================================================
// REQ178/179/180 — platform (tenant SaaS) billing. Genuinely separate
// from the OLDER, still-live-but-onboarding-only SubscriptionPlans/
// OrganizationSubscriptions/PaymentTransactions trio below (self-serve
// signup's own trial-selection record, never billed against for real) —
// this references Plans/PlanVersions (the real, versioned entitlement
// catalog, REQ032/REQ147) directly, since a tenant billed for real must
// be billed against the exact plan that actually gates their features.
// See CLAUDE.md's own "platform-billing" section for the full account.
// ============================================================
model PlatformSubscriptions {
  id                       String    @id @default(uuid())
  client_org_id            String
  plan_id                  String
  // The specific PlanVersion's price/cycle locked in at subscribe time --
  // a later plan-catalog edit (createPlanVersion) never retroactively
  // changes an existing subscriber's committed price.
  plan_version_id          String
  status                   String    @default("active") // trialing | active | past_due | grace | suspended | cancelled | non_renewing
  gateway                  String    // razorpay | stripe
  gateway_customer_id      String?
  gateway_subscription_id  String?   // Razorpay subscription_id / Stripe subscription id
  mandate_status           String?   // pending | confirmed | paused | revoked -- Razorpay UPI/eNACH only, null for Stripe
  mandate_max_amount_paise Int?
  current_period_start     DateTime
  current_period_end       DateTime
  cancel_at_period_end     Boolean   @default(false)
  cancelled_at             DateTime?
  cancelled_by_user_id     String?
  cancellation_reason      String?
  created_by_user_id       String
  created_at               DateTime  @default(now())
  updated_at               DateTime  @default(now())

  client_org    ClientOrganizations     @relation(fields: [client_org_id], references: [id])
  plan          Plans                   @relation(fields: [plan_id], references: [id])
  plan_version  PlanVersions            @relation(fields: [plan_version_id], references: [id])
  invoices      PlatformInvoices[]
  dunningEvents PlatformDunningEvents[]

  @@index([client_org_id])
  @@index([status])
  @@index([gateway_subscription_id])
}

model PlatformInvoices {
  id                             String    @id @default(uuid())
  subscription_id                String
  client_org_id                  String
  invoice_number                 String    @unique
  amount_paise                   Int
  currency                       String    @default("INR")
  status                         String    @default("pending") // pending | paid | failed | void | refunded
  due_date                       DateTime
  paid_at                        DateTime?
  gateway                        String
  gateway_invoice_id             String?
  gateway_payment_id             String?
  // RBI 24h pre-debit-notice audit trail -- one notice per charge cycle,
  // inlined here rather than a separate join table (matches
  // AppointmentPayments' own precedent of inlining GST fields).
  pre_debit_notice_sent_at       DateTime?
  pre_debit_notice_amount_paise  Int?
  afa_required                   Boolean   @default(false) // amount > ₹15,000
  // GST here is NOT the AppointmentPayments/PaymentTransactions shape
  // (one gstin = the seller's) -- platform billing has a genuinely
  // different GST direction: CareOS is the seller, the tenant org is the
  // buyer, and a B2B tenant needs the SELLER's GSTIN on the invoice to
  // claim input tax credit, while the platform separately records the
  // BUYER's GSTIN for its own filings. Both sides explicit, never one
  // ambiguous "gstin" field.
  platform_gstin                 String?   // CareOS's own GSTIN (seller) -- from PLATFORM_GSTIN env var, not per-org
  client_org_gstin               String?   // the tenant's own GSTIN (buyer), if supplied -- ClientOrganizations.gstin
  hsn_sac_code                   String?
  gst_rate                       Float?
  cgst_amount_paise              Int?
  sgst_amount_paise              Int?
  igst_amount_paise              Int?
  metadata                       Json      @default("{}")
  created_at                     DateTime  @default(now())

  subscription PlatformSubscriptions @relation(fields: [subscription_id], references: [id])
  client_org   ClientOrganizations   @relation(fields: [client_org_id], references: [id])

  @@index([subscription_id])
  @@index([client_org_id, created_at])
  @@index([status])
}

// Same atomic-upsert-increment shape as InvoiceSequences, minus the
// clinic_id dimension -- platform billing has no clinic to key by (the
// platform itself is the single "seller"), just a global sequence per
// financial year.
model PlatformInvoiceSequences {
  id             String   @id @default(uuid())
  financial_year String   @unique
  last_number    Int      @default(0)
  updated_at     DateTime @updatedAt
}

model PlatformDunningEvents {
  id              String    @id @default(uuid())
  subscription_id String
  invoice_id      String?
  event_type      String    // payment_failed | retry_scheduled | retry_attempted | grace_started | suspended | reactivated | mandate_paused | mandate_revoked
  attempt_number  Int?
  occurred_at     DateTime  @default(now())
  metadata        Json      @default("{}")

  subscription PlatformSubscriptions @relation(fields: [subscription_id], references: [id])

  @@index([subscription_id])
}

// ============================================================
// REQ034 — DPDP consent capture and data-subject rights requests.
// RightsRequests is a request-queued-for-review row, never an instant
// self-service hard-delete — see PLAN068's own note on why (clinical
// records commonly have a statutory retention floor that overrides an
// erasure request; the code's job here is capturing and SLA-tracking the
// request, not performing an automated purge).
// ============================================================
model Consents {
  id            String    @id @default(uuid())
  patient_id    String
  client_org_id String
  // treatment | communications | marketing | record_sharing
  purpose       String
  granted       Boolean
  granted_at    DateTime  @default(now())
  revoked_at    DateTime?
  notice_version String
  // REQ113 — the one purely mechanical blocker of the three RetentionPurgeService
  // named as not-yet-enforced (clinical_records has a real legal-review
  // tension, messages has a real two-party deletion-scoping question;
  // consents just had no column to soft-delete through).
  is_deleted    Boolean   @default(false)

  patient             Patients             @relation(fields: [patient_id], references: [id])
  client_organization ClientOrganizations  @relation(fields: [client_org_id], references: [id])

  @@index([patient_id])
  @@index([client_org_id])
}

// REQ034 (US-DPDP-06) — a documented retention schedule per data class,
// with automated purge. No policy exists for a data class until an admin
// explicitly creates one (fail-safe default — REQ034's own doc flags that
// statutory retention periods need legal review, so this codebase does not
// invent one). legal_hold suspends purging for that class org-wide without
// deleting the policy itself — a coarser, org-level hold, not a per-record
// one; a genuinely per-record legal hold (e.g. one patient's records under
// active litigation while the rest of that data class purges normally) is
// out of scope for this slice, logged as a real, stated scope-cut.
model RetentionPolicies {
  id              String   @id @default(uuid())
  client_org_id   String
  // clinical_records | test_results | consents | messages — see
  // retention-policies.service.ts's own SUPPORTED_DATA_CLASSES for which
  // of these the purge job actually acts on today; a policy for an
  // unsupported class is stored (so the schedule is documented) but never
  // purged against, and is surfaced as such to the admin, not silently
  // ignored.
  data_class      String
  retention_years Int
  legal_hold      Boolean  @default(false)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  client_organization ClientOrganizations @relation(fields: [client_org_id], references: [id])

  @@unique([client_org_id, data_class])
  @@index([client_org_id])
}

model RightsRequests {
  id            String    @id @default(uuid())
  patient_id    String
  client_org_id String
  // access | correction | erasure
  type          String
  // pending (default) | approved | rejected | completed
  status        String    @default("pending")
  sla_due_at    DateTime
  resolved_at   DateTime?
  resolved_by_user_id String?
  notes         String?
  created_at    DateTime  @default(now())

  patient             Patients             @relation(fields: [patient_id], references: [id])
  client_organization ClientOrganizations  @relation(fields: [client_org_id], references: [id])

  @@index([patient_id])
  @@index([client_org_id, status])
}

// ============================================================
// REQ022 — pharmacy P0: per-clinic batch/stock ledger. StockMovements is
// append-only (the requirement doc's own explicit non-functional note) —
// DrugBatches.quantity_remaining is a maintained running total, never the
// only record of what happened.
// ============================================================
model DrugBatches {
  id                 String   @id @default(uuid())
  drug_id            String
  clinic_id          String
  client_org_id      String
  batch_number       String
  expiry_date        DateTime
  quantity_received  Int
  quantity_remaining Int
  mrp_paise          Int?
  created_at         DateTime @default(now())

  drug                Drugs               @relation(fields: [drug_id], references: [id])
  clinic              Clinics             @relation(fields: [clinic_id], references: [id])
  client_organization ClientOrganizations @relation(fields: [client_org_id], references: [id])
  movements           StockMovements[]

  @@index([drug_id])
  @@index([clinic_id, client_org_id])
  @@index([expiry_date])

  // REQ179 (IPD slice 2)
  medicationAdministrations MedicationAdministrations[]

  // REQ179 (IPD slice 3)
  otConsumables OtConsumables[]
}

model StockMovements {
  id               String   @id @default(uuid())
  batch_id         String
  // receipt | dispense | adjustment | expiry_writeoff
  movement_type    String
  // signed: positive for receipt, negative for dispense/writeoff
  quantity_delta   Int
  reference_type   String? // e.g. "prescription_item"
  reference_id     String?
  created_by_user_id String
  created_at       DateTime @default(now())
  notes            String?

  batch DrugBatches @relation(fields: [batch_id], references: [id])

  @@index([batch_id])
}

// ============================================================
// REQ030 (US-INT-02, scoped down) — signed outbound webhook delivery,
// best-effort/synchronous. Retry with exponential backoff is the
// requirement doc's own P1 acceptance criterion — deliberately deferred
// past this slice (no new queue/worker infra), logged not silently
// dropped: WebhookDeliveryLog records every attempt's outcome so a failed
// delivery is visible and re-triggerable by hand, just not auto-retried.
// ============================================================
model WebhookEndpoints {
  id             String   @id @default(uuid())
  client_org_id  String
  url            String
  // AES-256-GCM encrypted via common/crypto/secrets.ts, matching the OTP
  // provider credential convention — never stored plaintext.
  secret         String
  // JSON array of event-type strings this endpoint subscribes to, e.g.
  // ["appointment.created", "appointment.confirmed", "payment.succeeded"]
  event_types_json Json
  is_active      Boolean  @default(true)
  created_by_user_id String
  created_at     DateTime @default(now())

  client_organization ClientOrganizations @relation(fields: [client_org_id], references: [id])
  deliveries          WebhookDeliveryLog[]

  @@index([client_org_id])
}

model WebhookDeliveryLog {
  id            String   @id @default(uuid())
  endpoint_id   String
  event_type    String
  payload_json  Json
  // succeeded | failed | exhausted
  status        String
  http_status   Int?
  attempted_at  DateTime @default(now())
  response_snippet String?
  // REQ112 — retry tracking. attempt_number is 1 for the original
  // synchronous attempt, 2-6 for sweep-driven retries. next_retry_at is
  // set only on a 'failed' row that still has retries remaining; null
  // once a row is 'succeeded' or 'exhausted'.
  attempt_number Int      @default(1)
  next_retry_at  DateTime?

  endpoint WebhookEndpoints @relation(fields: [endpoint_id], references: [id])

  @@index([endpoint_id, attempted_at])
  @@index([status, next_retry_at])
}

// ============================================================
// REQ031 — insurance P1 scope, payer/tariff master + patient policy
// capture only (no claim/pre-auth state machine — that's the requirement
// doc's own explicit P2 follow-on). Payers is global reference data (like
// Languages, no client_org_id) since insurers/TPAs are shared across every
// tenant, not owned by one.
// ============================================================
model Payers {
  id         String   @id @default(uuid())
  name       String
  // insurer | tpa | corporate | government_scheme
  payer_type String
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())

  empanelments PayerEmpanelments[]
  policies     PatientInsurancePolicies[]
  tariffs      PayerTariffs[]
  claims       Claims[]

  // REQ179 (IPD slice 1)
  admissions Admissions[]

  // REQ179 (IPD slice 5)
  preAuthorizations PreAuthorizations[]
  ipdClaims         IpdClaims[]
}

// REQ031 (US-INS-02) — a payer-specific contracted rate for a service/
// package, master data only. Deliberately NOT wired into
// resolveServicePrice()/billing yet: whether a payer tariff should
// outrank a branch override or a patient-category override (both already
// resolution-order decisions in that shared helper) is a genuine billing
// judgment call this slice does not make unilaterally — logged as a real,
// stated follow-on, not guessed at. This table gives the Insurance Desk
// Executive a real place to maintain the master, matching this codebase's
// own precedent of shipping master data ahead of its own billing
// integration when the integration itself needs a decision (see REQ022's
// own "receive/dispense/adjust before purchase orders" phasing).
model PayerTariffs {
  id            String @id @default(uuid())
  payer_id      String
  product_id    String
  client_org_id String
  tariff_price  Int // paise, same unit as Products.price
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  payer               Payers              @relation(fields: [payer_id], references: [id])
  product             Products            @relation(fields: [product_id], references: [id])
  client_organization ClientOrganizations @relation(fields: [client_org_id], references: [id])

  @@unique([payer_id, product_id])
  @@index([client_org_id])
  @@index([product_id])
}

model PayerEmpanelments {
  id             String    @id @default(uuid())
  payer_id       String
  clinic_id      String
  client_org_id  String
  // active | de_empanelled | blacklisted
  status         String    @default("active")
  start_date     DateTime
  end_date       DateTime?
  renewal_reminder_date DateTime?

  payer               Payers              @relation(fields: [payer_id], references: [id])
  clinic              Clinics             @relation(fields: [clinic_id], references: [id])
  client_organization ClientOrganizations @relation(fields: [client_org_id], references: [id])

  @@unique([payer_id, clinic_id])
  @@index([client_org_id])
}

model PatientInsurancePolicies {
  id                 String    @id @default(uuid())
  patient_id         String
  client_org_id      String
  payer_id           String
  policy_number      String
  policy_holder_name String
  valid_from         DateTime
  valid_until        DateTime?
  is_active          Boolean   @default(true)
  created_at         DateTime  @default(now())

  patient             Patients             @relation(fields: [patient_id], references: [id])
  payer               Payers               @relation(fields: [payer_id], references: [id])
  client_organization ClientOrganizations  @relation(fields: [client_org_id], references: [id])
  claims              Claims[]

  @@index([patient_id])
  @@index([client_org_id])

  // REQ179 (IPD slice 1)
  admissions Admissions[]

  // REQ179 (IPD slice 5)
  preAuthorizations PreAuthorizations[]
  ipdClaims         IpdClaims[]
}

// REQ131 (REQ031's own explicit P2 follow-on) -- a basic OPD cashless
// claim-tracking state machine (submitted -> under_review -> approved |
// rejected; approved -> settled). Deliberately manual/portal-assist per
// the PRD's own R11 risk mitigation ("most insurers/TPAs still work
// through bespoke portals and email") -- no real payer API, no
// benefit-wallet auto-adjudication (that needs REQ023's bill-split
// mechanism as its own foundation, per REQ031's own dependency note).
// No client_org_id/clinic_id column of its own -- scoped via
// appointment.clinic.client_org_id, the same 2-level-nesting idiom
// pharmacy.service.ts's pendingDispenseItems() already established.
// patient_id is still stored directly (denormalized, matching
// Referrals' own precedent) purely for query ergonomics.
model Claims {
  id                    String    @id @default(uuid())
  appointment_id        String
  patient_id            String
  payer_id              String
  policy_id             String?
  claim_amount          Int       // paise
  approved_amount       Int?      // paise, set only once a decision is made
  status                String    @default("submitted") // submitted | under_review | approved | rejected | settled
  rejection_reason      String?
  submitted_by_user_id  String
  submitted_at          DateTime  @default(now())
  decided_at            DateTime?
  settled_at            DateTime?
  notes                 String?
  // REQ154 (P2-02) -- optional, auto-populated at submission time from
  // suggestEncounterCodes() when the caller accepts a suggestion; each
  // element is {code, description}. Json, not a relation table, matching
  // this schema's own established convention for structured-but-not-
  // independently-queried side data (recipients_json, category_pricing_json).
  diagnosis_codes_json  Json?
  procedure_codes_json  Json?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  appointment  Appointments               @relation(fields: [appointment_id], references: [id])
  patient      Patients                   @relation(fields: [patient_id], references: [id])
  payer        Payers                     @relation(fields: [payer_id], references: [id])
  policy       PatientInsurancePolicies?  @relation(fields: [policy_id], references: [id])
  submitted_by UserProfiles               @relation(fields: [submitted_by_user_id], references: [id])
  appeal       ClaimAppeals?

  @@index([status])
  @@index([patient_id])
  @@index([appointment_id])
  @@index([payer_id])
}

// P2-03 -- the "agent" step of the claim lifecycle: the moment a claim is
// rejected (updateClaimStatus), a draft appeal is auto-generated from a
// deterministic denial classifier (denial-classification.ts) plus the
// claim's own already-real evidence (REQ137's claimEvidencePrescriptions).
// This row IS the audit trail Hard Rule "every agent action audited and
// reversible" asks for: created unattributed (the agent's own draft),
// approved_by_user_id/approved_at populated only once a real human
// reviews and approves it (approveClaimAppeal) -- never auto-submitted to
// a payer anywhere in this codebase, matching the phase plan's own "never
// auto-submit without a human decision point" constraint and this
// environment's honest lack of a real payer API to submit to.
// @unique claim_id -- one live draft per claim; re-rejecting a claim
// (a real, if unusual, path back through the state machine) regenerates
// it in place rather than accumulating stale drafts.
model ClaimAppeals {
  id                   String    @id @default(uuid())
  claim_id             String    @unique
  denial_category      String    // missing_documentation | coding_mismatch | not_covered | authorization_required | duplicate_claim | other
  draft_content        String
  status               String    @default("draft") // draft | approved
  approved_by_user_id  String?
  approved_at          DateTime?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  claim Claims @relation(fields: [claim_id], references: [id], onDelete: Cascade)

  @@index([claim_id])
}

// P2-05 — a completed (or failed) bulk patient import's own audit
// record. Deliberately a result-log only, not an input cache: the raw
// CSV content and the chosen column mapping are never persisted here
// (or anywhere) -- commitImport() takes both as direct mutation
// arguments, the same content already in the browser from the file the
// user picked, re-validated fresh rather than trusted from an earlier
// dry-run. row_errors_json is capped (see imports.service.ts) rather
// than storing an error for every one of a potentially very large
// file's bad rows.
model ImportJobs {
  id                  String    @id @default(uuid())
  client_org_id       String
  created_by_user_id  String
  total_rows          Int
  imported_rows       Int
  error_rows          Int
  row_errors_json     Json?
  created_at          DateTime  @default(now())

  client_organization ClientOrganizations @relation(fields: [client_org_id], references: [id])
  created_by          UserProfiles        @relation(fields: [created_by_user_id], references: [id])

  @@index([client_org_id])
}

// ============================================================
// REQ015 (US-SEC-08, scoped down) — org-scoped API keys. Key hashing
// mirrors the password convention (bcrypt via common/crypto/bcrypt-cost.ts),
// never storing the raw key — only key_prefix (shown once at issuance for
// the admin to identify it) plus the hash.
// ============================================================
model ApiKeys {
  id             String    @id @default(uuid())
  client_org_id  String
  key_prefix     String
  key_hash       String
  name           String
  is_active      Boolean   @default(true)
  last_used_at   DateTime?
  created_by_user_id String
  revoked_at     DateTime?
  created_at     DateTime  @default(now())

  client_organization ClientOrganizations @relation(fields: [client_org_id], references: [id])

  @@index([client_org_id])
  @@index([key_prefix])
}

// ============================================================
// REQ029 (US-RPT-03) — scheduled report delivery, reusing REQ025's
// dispatch infrastructure (NotificationTriggerService) for the actual
// send, and the existing @nestjs/schedule ScheduleModule (already used by
// AppointmentPaymentsReconciliationService) for the cron trigger.
// ============================================================
model ScheduledReports {
  id             String    @id @default(uuid())
  client_org_id  String
  clinic_id      String?
  // e.g. "daily_collections" | "patient_report_group" | "utilisation"
  report_type    String
  // JSON array of {type: 'email'|'whatsapp', value: string}
  recipients_json Json
  // daily | weekly | monthly
  cadence        String
  // email | whatsapp | app — matches NotificationTriggerService's own channel vocabulary
  channel        String
  last_sent_at   DateTime?
  is_active      Boolean   @default(true)
  created_by_user_id String
  created_at     DateTime  @default(now())

  client_organization ClientOrganizations @relation(fields: [client_org_id], references: [id])
  clinic              Clinics?             @relation(fields: [clinic_id], references: [id])

  @@index([client_org_id, is_active])
}

// REQ051 (US-QUE-06) — a clinic-scoped, optionally product-scoped, ordered
// list of items that must be completed before QueueService.callNext() will
// call a given patient in. Deliberately keyed by clinic (via client_org_id
// indirection is not needed — Clinics has no own client_org_id column on
// every row, matching Rooms/QueueEntries' existing indirect-scoping
// precedent), not by encounter — an Encounters row for a given appointment
// usually doesn't exist yet at call-next time (it's created on the same
// transitionStatus('in_consultation') path callNext participates in).
model ChecklistItems {
  id           String   @id @default(uuid())
  clinic_id    String
  product_id   String?
  label        String
  is_required  Boolean  @default(true)
  sort_order   Int      @default(0)
  is_deleted   Boolean  @default(false)
  created_at   DateTime @default(now())

  clinic      Clinics      @relation(fields: [clinic_id], references: [id])
  product     Products?    @relation(fields: [product_id], references: [id])
  completions ChecklistCompletions[]

  @@index([clinic_id, product_id])
}

// One row per (appointment, item) — completion is scoped to a single visit,
// not a standing patient-level flag (a "consent obtained" checkbox from a
// prior visit does not carry forward).
model ChecklistCompletions {
  id                  String   @id @default(uuid())
  checklist_item_id   String
  appointment_id      String
  completed_by_user_id String
  completed_at        DateTime @default(now())

  checklist_item ChecklistItems @relation(fields: [checklist_item_id], references: [id])
  appointment    Appointments   @relation(fields: [appointment_id], references: [id])

  @@unique([checklist_item_id, appointment_id])
  @@index([appointment_id])
}

// REQ052 (US-BOOK-06) — clinic-scoped, optionally product-scoped, ordered
// custom booking-form fields. Same shape/scoping precedent as
// ChecklistItems (REQ051) -- a flat per-clinic list, no cross-clinic
// template reuse in this slice.
model ClinicIntakeFieldConfig {
  id          String   @id @default(uuid())
  clinic_id   String
  product_id  String?
  key         String
  label       String
  // text | textarea | number | boolean -- free text, matching this
  // codebase's established loose-string convention for a small closed
  // vocabulary (validated at the DTO layer, not a Postgres enum).
  field_type  String   @default("text")
  is_required Boolean  @default(false)
  sort_order  Int      @default(0)
  is_deleted  Boolean  @default(false)
  created_at  DateTime @default(now())

  clinic  Clinics   @relation(fields: [clinic_id], references: [id])
  product Products? @relation(fields: [product_id], references: [id])

  @@index([clinic_id, product_id])
}

// REQ053 (US-SEC-05) — time-boxed, reason-mandatory elevated-access grant.
// The grant lifecycle itself (request, alert, auto-expire) is real; wiring
// it into specific resource-access checks is a deferred follow-on slice
// per domain (see the requirement doc's own scope note).
model BreakGlassGrants {
  id              String    @id @default(uuid())
  client_org_id   String
  grantee_user_id String
  reason          String
  granted_at      DateTime  @default(now())
  expires_at      DateTime
  revoked_at      DateTime?

  client_organization ClientOrganizations @relation(fields: [client_org_id], references: [id])
  grantee              Users               @relation(fields: [grantee_user_id], references: [id])

  @@index([grantee_user_id, expires_at])
  @@index([client_org_id, granted_at])
}

// REQ053 (US-SEC-06, scoped down — see the requirement doc's own note on
// why the full Support-Agent/org-approval governance layer is deferred).
// expires_at drives the impersonation JWT's own expiresIn, so reversion is
// automatic -- no separate expiry sweep needed.
model ImpersonationSessions {
  id                 String    @id @default(uuid())
  client_org_id      String
  real_actor_user_id String
  target_user_id     String
  reason             String
  started_at         DateTime  @default(now())
  expires_at         DateTime
  ended_at           DateTime?

  client_organization ClientOrganizations @relation(fields: [client_org_id], references: [id])
  real_actor           Users               @relation("ImpersonationRealActor", fields: [real_actor_user_id], references: [id])
  target                Users               @relation("ImpersonationTarget", fields: [target_user_id], references: [id])

  @@index([real_actor_user_id, expires_at])
  @@index([target_user_id])
}

// REQ054 (US-CAT-01) — a sellable multi-sitting bundle. price_paise/
// total_sittings/validity_days are the catalog defaults; a purchased
// PatientPackages instance denormalizes its own copy so a later catalog
// edit never retroactively changes an already-sold package.
model Packages {
  id             String   @id @default(uuid())
  client_org_id  String
  clinic_id      String
  name           String
  description    String?
  total_sittings Int
  price_paise    Int
  validity_days  Int      @default(90)
  is_active      Boolean  @default(true)
  is_deleted     Boolean  @default(false)
  created_at     DateTime @default(now())

  client_organization ClientOrganizations @relation(fields: [client_org_id], references: [id])
  clinic               Clinics             @relation(fields: [clinic_id], references: [id])
  items                PackageItems[]
  patientPackages      PatientPackages[]

  @@index([client_org_id, clinic_id])
}

// REQ110 — append-only transfer history, matching StockMovements' own
// established append-only-ledger convention (this codebase has no generic
// domain-action audit log write, per REQ056's own note).
model PackageTransferLog {
  id                      String   @id @default(uuid())
  patient_package_id      String
  from_patient_id         String
  to_patient_id           String
  transferred_by_user_id  String
  sittings_at_transfer    Int
  client_org_id           String
  created_at              DateTime @default(now())

  patientPackage PatientPackages @relation(fields: [patient_package_id], references: [id])
  fromPatient    Patients        @relation("PackageTransferFrom", fields: [from_patient_id], references: [id])
  toPatient      Patients        @relation("PackageTransferTo", fields: [to_patient_id], references: [id])

  @@index([patient_package_id])
  @@index([client_org_id])
}

// Patient Membership Plans -- built for real 2026-08-30 (BUG-058-class
// requirement), replacing a page that was previously 100% local useState
// with zero backend at all (context/open-questions.md #13). Deliberately
// scoped like Packages/PatientPackages (REQ054) -- an org+clinic catalog
// plus a per-patient enrollment record -- rather than the platform's own
// versioned Plans/PlanVersions (REQ032, a different concept: MediBook's
// SaaS billing, not a patient's recurring plan with the clinic). No
// discount/pricing-integration field yet -- resolveServicePrice() has no
// membership parameter and where a member discount would rank against
// payer-tariff/branch-override/category/channel pricing is a genuine,
// separate open design question, not decided here.
model MembershipPlans {
  id                  String   @id @default(uuid())
  client_org_id       String
  clinic_id           String
  name                String
  description         String?
  price_monthly_paise Int
  is_active           Boolean  @default(true)
  is_deleted          Boolean  @default(false)
  created_at          DateTime @default(now())

  client_organization ClientOrganizations  @relation(fields: [client_org_id], references: [id])
  clinic              Clinics              @relation(fields: [clinic_id], references: [id])
  patientMemberships  PatientMemberships[]

  @@index([client_org_id, clinic_id])
}

// price_monthly_paise denormalizes from the plan at enroll time (matches
// PatientPackages.purchase_amount_paise's own precedent) so a later catalog
// price change never silently changes what an existing member is shown as
// paying. status is free text ('active'|'cancelled'), validated at the DTO
// layer -- matches this pair's own no-Prisma-enum convention. The
// migration's own partial unique index (WHERE status='active') is the real
// "one active membership per patient" guarantee; enrollPatientMembership
// itself already cancels any prior active row in the same transaction, so
// this index is a safety net, not the primary mechanism.
model PatientMemberships {
  id                  String    @id @default(uuid())
  membership_plan_id  String
  patient_id          String
  client_org_id       String
  clinic_id           String
  price_monthly_paise Int
  status              String    @default("active")
  enrolled_at         DateTime  @default(now())
  cancelled_at        DateTime?
  is_deleted          Boolean   @default(false)

  membershipPlan      MembershipPlans      @relation(fields: [membership_plan_id], references: [id])
  patient             Patients             @relation(fields: [patient_id], references: [id])
  client_organization ClientOrganizations  @relation(fields: [client_org_id], references: [id])
  clinic              Clinics              @relation(fields: [clinic_id], references: [id])

  @@index([patient_id, status])
  @@index([client_org_id, clinic_id])
}

// Which service(s)/product(s) a sitting from this package may be redeemed
// against — a package bundles one or more, per US-CAT-01's own wording.
model PackageItems {
  id         String @id @default(uuid())
  package_id String
  product_id String

  package Packages @relation(fields: [package_id], references: [id])
  product Products @relation(fields: [product_id], references: [id])

  @@unique([package_id, product_id])
}

// A purchased instance. sittings_total/purchase_amount_paise are
// denormalized from Packages at purchase time (see the model comment
// above). sittings_remaining follows DrugBatches.quantity_remaining's
// established "maintained running total, decremented inside the same
// transaction as its triggering write" pattern (REQ022), not computed.
model PatientPackages {
  id                     String    @id @default(uuid())
  package_id             String
  patient_id             String
  client_org_id          String
  clinic_id              String
  sittings_total         Int
  sittings_remaining     Int
  purchase_amount_paise  Int
  purchase_tender_type   String
  purchase_reference     String?
  purchased_at           DateTime  @default(now())
  expires_at             DateTime
  is_deleted             Boolean   @default(false)

  package             Packages            @relation(fields: [package_id], references: [id])
  patient             Patients            @relation(fields: [patient_id], references: [id])
  client_organization ClientOrganizations @relation(fields: [client_org_id], references: [id])
  clinic              Clinics             @relation(fields: [clinic_id], references: [id])
  transferLogs        PackageTransferLog[]

  @@index([patient_id, expires_at])
  @@index([client_org_id, clinic_id])
}

// REQ080 (project-plans/09-next-15-slice-roadmap.md #1) — internal staff
// follow-up tasks (Semble's Task object). Org-wide shared visibility for
// every staff/clinician/manager/admin in the org, matching the internal
// coordination-tool pattern this codebase already uses for the queue
// board rather than a per-caller mailbox. task_type/priority/status are
// plain validated strings, not Prisma enums — their real values contain
// spaces ("Follow-up call", "In Progress"), and modelling them as
// Postgres enums would need a @map on every value for no behavioural
// gain over class-validator's @IsIn() at the DTO layer, which every other
// write path already goes through.
model Tasks {
  id                  String    @id @default(uuid())
  client_org_id       String
  subject             String
  task_type           String    @default("General")
  priority             String    @default("Medium")
  status              String    @default("Open")
  due_date            DateTime?
  assigned_to_user_id String?
  patient_id          String?
  created_by_user_id  String
  is_deleted          Boolean   @default(false)
  created_at          DateTime  @default(now())
  updated_at          DateTime  @default(now())

  client_organization ClientOrganizations @relation(fields: [client_org_id], references: [id])
  assigned_to         Users?               @relation("TaskAssignee", fields: [assigned_to_user_id], references: [id])
  created_by          Users                @relation("TaskCreatedBy", fields: [created_by_user_id], references: [id])
  patient             Patients?            @relation(fields: [patient_id], references: [id])

  @@index([client_org_id, status])
  @@index([assigned_to_user_id])
  @@index([patient_id])
}

// REQ158 (P2-06) -- doctor revenue-share & payouts. `scope` mirrors
// resolveServicePrice()'s own most-specific-wins pattern
// (resolve-price.ts, REQ055/REQ100): a clinician-level rule is checked
// before a clinic-level rule, which is checked before the org-level
// default. clinic_id/clinician_id are only ever set together with the
// scope that names them ('clinic' sets clinic_id only; 'clinician' sets
// both, since a clinician's own rule is naturally attached to the branch
// they're at today -- see the schema note on Clinicians.clinic_id being
// singular, not a many-to-many). No DB-level uniqueness across the
// nullable scope columns (Postgres treats NULL as distinct per row, so a
// plain @@unique can't express "at most one org-default row"); the
// service enforces "at most one active rule per scope key" via a
// find-then-upsert, the same division of labour PayerTariffs' own
// setPayerTariff uses for its own natural key.
model RevenueShareRules {
  id                  String   @id @default(uuid())
  client_org_id       String
  scope               String   // org | clinic | clinician
  clinic_id           String?
  clinician_id        String?
  share_percentage    Float    // 0-100; the clinician's own cut
  created_by_user_id  String?
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  clientOrg ClientOrganizations @relation(fields: [client_org_id], references: [id])
  clinic    Clinics?            @relation(fields: [clinic_id], references: [id])
  clinician Clinicians?         @relation(fields: [clinician_id], references: [id])

  @@index([client_org_id])
  @@index([clinic_id])
  @@index([clinician_id])
}

// REQ158 (P2-06) -- one row per clinician per clinic per calendar month.
// share_percentage_used is a snapshot at computation time, deliberately
// independent of RevenueShareRules going forward -- US-REV-03's own
// invariant is that an approved payout can never be silently altered by
// a later rate change or a re-run of the computation; only a
// pending_approval row is ever recomputed in place.
model Payouts {
  id                    String    @id @default(uuid())
  client_org_id         String
  clinic_id             String
  clinician_id          String
  period_start          DateTime // first day of the month, UTC midnight
  period_end            DateTime // first day of the FOLLOWING month, UTC midnight (exclusive upper bound)
  gross_amount          Int      // paise, sum of succeeded AppointmentPayments in period
  share_percentage_used Float
  payout_amount         Int      // paise
  appointment_count     Int      @default(0)
  status                String   @default("pending_approval") // pending_approval | approved
  approved_by_user_id   String?
  approved_at           DateTime?
  computed_by_user_id   String?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  clientOrg ClientOrganizations @relation(fields: [client_org_id], references: [id])
  clinic    Clinics             @relation(fields: [clinic_id], references: [id])
  clinician Clinicians          @relation(fields: [clinician_id], references: [id])

  @@unique([clinician_id, clinic_id, period_start])
  @@index([client_org_id, period_start])
  @@index([clinic_id, period_start])
  @@index([clinician_id])
}

// ============================================================
// REQ179 (IPD slice 1) — in-patient ADT core: wards, beds, bed
// occupancy, admissions, the ADT event log, and the statutory MLC
// register.
//
// WHY THESE ARE NET-NEW RATHER THAN EXTENSIONS. Every clinical,
// scheduling and billing model in this schema is anchored to a single
// `appointment_id` representing one bounded visit:
//   - `Rooms` is one consultation room, referenced by Appointments.room_id
//     as a single required FK, with no bed/occupancy concept. A ward room
//     holds many beds, each occupied and vacated on its own timeline.
//   - `Resources`/`AppointmentResources` model "borrow this asset for one
//     appointment's window", with no standalone lifecycle.
//   - `Encounters` is `appointment_id @unique`, 1:1, trigger-locked on sign.
//     A stay is multi-day and multi-author (nurses + doctors on rounds).
//   - `Claims`/`AppointmentPayments` both require an appointment that, for
//     an emergency admission, never exists.
// The stay — `Admissions` — is the IPD aggregate root, exactly as
// `appointment_id` is the OPD one.
// ============================================================

model Wards {
  id                        String   @id @default(uuid())
  client_org_id             String
  clinic_id                 String
  name                      String
  // Free text, matching Rooms.room_type / Clinicians.clinician_type /
  // Resources.type — this schema's established "lookup value as text"
  // convention. Deliberately NOT a Prisma enum: every new hospital invents
  // a ward class nobody enumerated.
  // general | semi_private | private | deluxe | suite | icu | hdu | nicu
  // | picu | maternity | isolation | day_care
  ward_type                 String   @default("general")
  floor                     String?
  gender_policy             String   @default("mixed") // male | female | mixed
  // The room-day tariff is a Products row, NOT a price column here. That one
  // FK buys resolveServicePrice()'s whole resolution chain (payer tariff >
  // branch override > patient category > channel > base), PayerTariffs, GST
  // classification via Products.hsn/gst_rate, and product-revenue reporting —
  // all for free. A `bed_charge_paise Int` column would mean rebuilding every
  // one of those for beds alone.
  bed_charge_product_id     String?
  // Nursing/RMO charge auto-posted per day alongside the bed charge.
  // Null = bundled into the bed rate (the common case for general wards).
  nursing_charge_product_id String?
  is_active                 Boolean  @default(true)
  is_deleted                Boolean  @default(false)
  created_at                DateTime @default(now())
  updated_at                DateTime @updatedAt

  client_organization    ClientOrganizations @relation(fields: [client_org_id], references: [id])
  clinic                 Clinics             @relation(fields: [clinic_id], references: [id])
  bed_charge_product     Products?           @relation("WardBedChargeProduct", fields: [bed_charge_product_id], references: [id])
  nursing_charge_product Products?           @relation("WardNursingChargeProduct", fields: [nursing_charge_product_id], references: [id])
  beds                   Beds[]
  occupancies            BedOccupancies[]
  // REQ179 (IPD slice 2)
  shiftHandovers         ShiftHandovers[]

  @@index([client_org_id, clinic_id, is_deleted])
  @@index([clinic_id, ward_type, is_active])
}

model Beds {
  id                    String   @id @default(uuid())
  // client_org_id and clinic_id are denormalised from the ward: the bed board
  // ("every bed in this clinic with live status") is the hottest IPD query and
  // orgScope() must not have to join two levels to answer it.
  client_org_id         String
  clinic_id             String
  ward_id               String
  bed_number            String
  bed_type              String?  // optional per-bed override of ward_type
  bed_charge_product_id String?  // per-bed tariff override; null falls back to the ward
  // DENORMALISED CACHE, not the source of truth — BedOccupancies is. Maintained
  // in the same transaction as every occupancy write, exactly the
  // DrugBatches.quantity_remaining / StockMovements relationship. A nightly
  // reconcile sweep re-derives it and logs divergence: this cache is allowed
  // to be wrong, never allowed to be *silently* wrong.
  // available | occupied | reserved | cleaning | blocked
  status                String   @default("available")
  is_active             Boolean  @default(true)
  is_deleted            Boolean  @default(false)
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  client_organization ClientOrganizations @relation(fields: [client_org_id], references: [id])
  clinic              Clinics             @relation(fields: [clinic_id], references: [id])
  ward                Wards               @relation(fields: [ward_id], references: [id])
  bed_charge_product  Products?           @relation("BedChargeProduct", fields: [bed_charge_product_id], references: [id])
  occupancies         BedOccupancies[]

  @@unique([ward_id, bed_number])
  @@index([client_org_id, clinic_id, status])
  @@index([ward_id, status, is_deleted])
}

// THE load-bearing table of the IPD design.
//
// One table covers occupied / reserved / cleaning / blocked, because a
// Postgres EXCLUDE constraint protects exactly ONE table. Split the timeline
// across BedOccupancies/BedReservations/BedBlocks and the database physically
// cannot stop a reservation colliding with an admission — you are back to
// check-then-insert across two statements, which is precisely the race
// 20260823030000_appointments_no_overlap_exclusion_constraint was written to
// kill ("N concurrent requests for the same slot could all pass the check
// before any of them wrote"). A double-booked bed is discovered by a patient
// standing in a corridor, so that mistake is worse here than on appointments.
//
// The cost, stated: admission_id is nullable, so this models "bed timeline
// entry" rather than "patient occupancy". A CHECK constraint ties
// occupancy_kind='occupied' to admission_id being present.
model BedOccupancies {
  id                 String    @id @default(uuid())
  client_org_id      String
  clinic_id          String
  bed_id             String
  ward_id            String    // denormalised from bed, for ward-level day-charge rating
  admission_id       String?   // NULL for a hold/cleaning/blocked row
  occupancy_kind     String    @default("occupied") // occupied | reserved | cleaning | blocked
  start_at           DateTime
  // NULL = open-ended / currently occupied. tsrange(start, NULL) is an
  // unbounded-upper range and works correctly inside a GiST EXCLUDE.
  end_at             DateTime?
  end_reason         String?   // transfer | discharge | ot_transfer | upgrade | downgrade | cancelled
  reason             String?   // free text: "ICU step-down", "AC not working"
  // Set instead of deleting a mistaken row — the EXCLUDE predicate filters on
  // this, so voiding a hold genuinely frees the bed without losing history.
  is_cancelled       Boolean   @default(false)
  created_by_user_id String
  ended_by_user_id   String?
  created_at         DateTime  @default(now())

  client_organization ClientOrganizations @relation(fields: [client_org_id], references: [id])
  clinic     Clinics       @relation(fields: [clinic_id], references: [id])
  bed        Beds          @relation(fields: [bed_id], references: [id])
  ward       Wards         @relation(fields: [ward_id], references: [id])
  admission  Admissions?   @relation(fields: [admission_id], references: [id])
  created_by UserProfiles  @relation("OccupancyCreatedBy", fields: [created_by_user_id], references: [id])
  ended_by   UserProfiles? @relation("OccupancyEndedBy", fields: [ended_by_user_id], references: [id])

  // REQ179 (IPD slice 4)
  ipdCharges IpdCharges[]

  @@index([bed_id, start_at])
  @@index([admission_id, start_at])
  @@index([client_org_id, clinic_id, end_at])
  @@index([ward_id, start_at])
}

model Admissions {
  id               String @id @default(uuid())
  client_org_id    String
  clinic_id        String
  patient_id       String
  // Gapless per clinic per financial year, via InvoiceSequences series 'ADM'.
  // Globally @unique rather than @@unique([clinic_id, ...]) because the number
  // already embeds a clinic prefix — a global unique is strictly stronger.
  admission_number String @unique

  // pending | admitted | discharge_initiated | discharged | cancelled
  // | lama (left against medical advice) | absconded | expired
  status                 String    @default("pending")
  // Drives the billing mode default and whether a pre-auth is required.
  // general | insurance | corporate | emergency | day_care | maternity
  admission_type         String    @default("general")
  admitted_at            DateTime
  expected_discharge_at  DateTime?
  discharge_initiated_at DateTime?
  discharged_at          DateTime?
  discharge_type         String?   // routine | dama | transfer_out | expired | absconded

  admitting_clinician_id String
  // Changes on handover; the history lives in AdmissionEvents, not a separate
  // assignment table.
  attending_clinician_id String
  department_id          String?

  // Provenance for a planned admission converted from an OPD consult. Both
  // NULLABLE — an emergency/direct admission has neither, which is exactly why
  // Encounters (appointment_id @unique) and Claims (appointment_id required)
  // cannot be reused for a stay.
  source_appointment_id String?
  source_encounter_id   String?

  provisional_diagnosis String  @default("")
  final_diagnosis       String?
  admission_notes       String  @default("")

  // Billing intent, decided at admission, overridable until the bill finalises.
  // Consumed by slice 4; carried here from slice 1 so admission never needs a
  // second migration to become billable.
  billing_mode   String  @default("itemized") // itemized | package
  ipd_package_id String?

  payer_id  String?
  policy_id String?

  // Denormalised board flags so the bed board and the MLC register never need
  // a subquery.
  is_mlc      Boolean @default(false)
  is_critical Boolean @default(false)

  created_by_user_id String
  is_deleted         Boolean  @default(false)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  client_organization ClientOrganizations       @relation(fields: [client_org_id], references: [id])
  clinic              Clinics                   @relation(fields: [clinic_id], references: [id])
  patient             Patients                  @relation(fields: [patient_id], references: [id])
  admitting_clinician Clinicians                @relation("AdmittingClinician", fields: [admitting_clinician_id], references: [id])
  attending_clinician Clinicians                @relation("AttendingClinician", fields: [attending_clinician_id], references: [id])
  department          Departments?              @relation(fields: [department_id], references: [id])
  source_appointment  Appointments?             @relation(fields: [source_appointment_id], references: [id])
  source_encounter    Encounters?               @relation(fields: [source_encounter_id], references: [id])
  payer               Payers?                   @relation(fields: [payer_id], references: [id])
  policy              PatientInsurancePolicies? @relation(fields: [policy_id], references: [id])
  created_by          UserProfiles              @relation("AdmissionCreatedBy", fields: [created_by_user_id], references: [id])

  occupancies BedOccupancies[]
  events      AdmissionEvents[]
  mlc         MlcRegisters?
  // REQ179 (IPD slice 2)
  vitals                Vitals[]
  medicationOrders      IpdMedicationOrders[]
  medicationAdministrations MedicationAdministrations[]
  intakeOutputRecords   IntakeOutputRecords[]
  notes                 AdmissionNotes[]
  handovers             ShiftHandovers[]
  dischargeSummary      DischargeSummaries?
  // REQ179 (IPD slice 3)
  otBookings            OtBookings[]
  // REQ179 (IPD slice 4)
  bill                  IpdBills?
  charges               IpdCharges[]
  payments              IpdPayments[]
  // REQ179 (IPD slice 5) -- nullable/optional since an admission with no
  // insurance routing has neither; @unique on the FK side (PreAuthorizations
  // .admission_id / IpdClaims.admission_id) makes each 1:1 for real.
  preAuthorization      PreAuthorizations?
  claim                 IpdClaims?

  @@index([client_org_id, clinic_id, status])
  @@index([patient_id, admitted_at])
  @@index([attending_clinician_id, status])
  @@index([clinic_id, admitted_at])
}

// The clinically-visible stay timeline the ADT board and (slice 2) the
// discharge summary render from. NOT the compliance log — the global
// AuditLogInterceptor already records every mutation automatically.
model AdmissionEvents {
  id            String   @id @default(uuid())
  admission_id  String
  client_org_id String
  // admitted | transferred | ward_class_changed | attending_changed
  // | leave_of_absence | returned | discharge_initiated | discharged
  // | cancelled | mlc_flagged | reactivated
  event_type    String
  occurred_at   DateTime @default(now())
  // {from_bed_id, to_bed_id, from_ward_id, to_ward_id, reason, ...} — the
  // diagnosis_codes_json / recipients_json convention for structured-but-not-
  // independently-queried side data.
  payload_json  Json?
  notes         String?
  actor_user_id String
  created_at    DateTime @default(now())

  admission           Admissions          @relation(fields: [admission_id], references: [id], onDelete: Cascade)
  client_organization ClientOrganizations @relation(fields: [client_org_id], references: [id])
  actor               UserProfiles        @relation("AdmissionEventActor", fields: [actor_user_id], references: [id])

  @@index([admission_id, occurred_at])
  @@index([client_org_id, event_type, occurred_at])
}

// Statutory medico-legal case register. Ships in slice 1, not later, because
// it is an *admission-register* obligation: the register must exist the moment
// a road-accident case is admitted, not when nursing charting ships.
//
// Legally: recorded in duplicate, no abbreviations, no unexplained
// overwriting, police notified within 24h, no patient consent required.
// Enforced by a DB trigger (reject_mlc_mutation) modelled on
// reject_write_if_encounter_locked() — corrections are appended, attributed
// MlcAmendments rows, never in-place edits.
model MlcRegisters {
  id            String @id @default(uuid())
  client_org_id String
  clinic_id     String
  admission_id  String @unique
  mlc_number    String @unique // InvoiceSequences series 'MLC'
  // road_accident | poisoning | assault | burns | sexual_assault | child_abuse
  // | unnatural_death | industrial_accident | attempted_suicide | other
  mlc_category  String

  incident_datetime   DateTime?
  incident_place      String?
  brought_by_name     String?
  brought_by_relation String?
  brought_by_contact  String?
  brought_by_id_proof String?

  // Two identification marks are the statutory minimum, hence non-null.
  identification_mark_1 String
  identification_mark_2 String
  injury_details        String @default("")

  // The 24h police-intimation obligation. These are the ONLY columns the
  // immutability trigger allows to be filled in after creation, and only once
  // (from NULL) — everything else is frozen.
  police_station              String?
  police_intimated_at         DateTime?
  police_intimated_by_user_id String?
  receiving_officer_name      String?
  receiving_officer_buckle_no String?
  intimation_mode             String? // in_person | phone | written | email

  examined_by_clinician_id String
  recorded_by_user_id      String
  recorded_at              DateTime @default(now())
  // Deliberately NO is_deleted and NO updated_at: this row is immutable and
  // must be preserved for life.
  created_at               DateTime @default(now())

  client_organization ClientOrganizations @relation(fields: [client_org_id], references: [id])
  clinic              Clinics             @relation(fields: [clinic_id], references: [id])
  admission           Admissions          @relation(fields: [admission_id], references: [id])
  examined_by         Clinicians          @relation("MlcExaminedBy", fields: [examined_by_clinician_id], references: [id])
  recorded_by         UserProfiles        @relation("MlcRecordedBy", fields: [recorded_by_user_id], references: [id])
  police_intimated_by UserProfiles?       @relation("MlcPoliceIntimatedBy", fields: [police_intimated_by_user_id], references: [id])
  amendments          MlcAmendments[]

  @@index([client_org_id, clinic_id, recorded_at])
  @@index([police_intimated_at])
  @@index([mlc_category])
}

// "Recorded in duplicate, no unexplained overwriting" — a correction is an
// appended, attributed amendment. Same shape and same reasoning as an
// addendum against a signed encounter.
model MlcAmendments {
  id                 String   @id @default(uuid())
  mlc_register_id    String
  field_name         String
  previous_value     String
  corrected_value    String
  reason             String
  amended_by_user_id String
  amended_at         DateTime @default(now())

  mlc_register MlcRegisters @relation(fields: [mlc_register_id], references: [id], onDelete: Cascade)
  amended_by   UserProfiles @relation("MlcAmendedBy", fields: [amended_by_user_id], references: [id])

  @@index([mlc_register_id, amended_at])
}

// Per-clinic IPD billing policy. Created in slice 1 (table only, unwired) so
// slice 4 needs no second migration. Every column here is a real conversation
// a hospital has with its software: making them columns means the conversation
// ends in a settings screen, not a code change.
model IpdBillingSettings {
  id            String @id @default(uuid())
  client_org_id String
  clinic_id     String @unique
  // calendar_day: the day rolls at discharge_cutoff_hour (the Indian norm).
  // rolling_24h:  the day rolls 24h after admitted_at.
  day_boundary_mode        String   @default("calendar_day")
  discharge_cutoff_hour    Int      @default(12)
  charge_admission_day     Boolean  @default(true)
  charge_discharge_day     Boolean  @default(false)
  minimum_billable_days    Int      @default(1)
  // Which ward's rate applies on a transfer day.
  transfer_day_rate_policy String   @default("higher_of") // higher_of | new_ward | old_ward
  package_excess_policy    String   @default("bill_extra") // bill_extra | absorb
  default_deposit_paise    Int      @default(0)
  auto_post_room_charges   Boolean  @default(true)
  // REQ179 (IPD slice 4) -- the Products row charged once per clinician per
  // day a doctor_round AdmissionNote is created (nursing.service.ts). Null
  // means doctor-visit charges are not auto-posted for this clinic -- the
  // same fail-safe "an admin must explicitly configure this before it
  // fires" convention as reorder_level/tpg_list nullability elsewhere in
  // this schema.
  doctor_visit_charge_product_id String?
  created_at               DateTime @default(now())
  updated_at               DateTime @updatedAt

  client_organization ClientOrganizations @relation(fields: [client_org_id], references: [id])
  clinic              Clinics             @relation(fields: [clinic_id], references: [id])
  doctor_visit_charge_product Products?   @relation(fields: [doctor_visit_charge_product_id], references: [id])

  @@index([client_org_id])
}

// ============================================================
// REQ179 (IPD slice 2) — nursing charting: medication orders and the
// medication administration record (MAR), intake/output, admission notes
// (nursing progress + doctor rounds, one table with a discriminator),
// shift handover, and the discharge summary.
//
// Vitals itself was extended above (encounter_id made nullable,
// admission_id added, guarded by a DB CHECK) rather than forked into a
// parallel IpdVitals table — a patient's vitals trend must be one series
// across their OPD visits and their IPD stay, and forking the table would
// mean every chart/export/AI-extraction path UNIONs two tables forever.
// ============================================================

// An inpatient standing order, NOT a Prescriptions row. Prescriptions
// models a take-home script (dose/frequency/duration_days/qty); an inpatient
// order is a standing instruction with a stop condition that GENERATES
// MedicationAdministrations rows on a schedule, including PRN orders that
// generate none until actually given.
model IpdMedicationOrders {
  id             String   @id @default(uuid())
  client_org_id  String
  admission_id   String
  drug_id        String
  dose           String
  dose_unit      String?
  route          String   // po | iv | im | sc | sl | topical | inhaled | pr | ng
  frequency      String   // OD | BD | TDS | QID | Q4H | Q6H | HS | STAT | SOS
  // Explicit administration clock-times, e.g. ["08:00","14:00","20:00"], so
  // the MAR-generation sweep is deterministic per hospital rather than
  // inferred from `frequency` in code. Small ordered config as JSON, this
  // schema's own established convention (Clinics.letterhead_clinician_ids).
  schedule_times_json Json?
  is_prn         Boolean  @default(false) // SOS/as-needed: no scheduled MAR rows generated
  prn_indication String?
  start_at       DateTime
  stop_at        DateTime?
  status         String   @default("active") // active | held | stopped | completed
  hold_reason    String?
  // Requires a witness on administration — a real patient-safety control
  // for high-alert medications (insulin, opioids, anticoagulants, etc.),
  // not merely documentation.
  is_high_alert  Boolean  @default(false)
  instructions   String?
  ordered_by_clinician_id String
  stopped_by_user_id String?
  stopped_at     DateTime?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  client_organization ClientOrganizations @relation(fields: [client_org_id], references: [id])
  admission   Admissions @relation(fields: [admission_id], references: [id], onDelete: Cascade)
  drug        Drugs      @relation(fields: [drug_id], references: [id])
  ordered_by  Clinicians @relation("IpdOrderOrderedBy", fields: [ordered_by_clinician_id], references: [id])
  administrations MedicationAdministrations[]

  @@index([admission_id, status])
  @@index([client_org_id, status, start_at])
  @@index([drug_id])
}

// The MAR. @@unique([order_id, scheduled_at]) is the load-bearing
// constraint: it makes the MAR-generation sweep (materialising doses due in
// the next window) freely re-runnable with createMany({skipDuplicates:true})
// — re-running it, a server restart mid-sweep, and a concurrent read all
// converge on the same, non-duplicated MAR. PRN administrations insert
// directly with scheduled_at = administered_at, which cannot collide since
// two PRN doses at the same millisecond is not a real event.
model MedicationAdministrations {
  id             String   @id @default(uuid())
  client_org_id  String
  admission_id   String
  order_id       String
  drug_id        String   // denormalised from the order -- the MAR grid renders drug names directly
  scheduled_at   DateTime
  administered_at DateTime?
  status         String   @default("scheduled")
                 // scheduled | given | held | refused | missed | not_available | self_administered
  dose_given     String?
  route          String?
  site           String?  // e.g. "L deltoid"
  hold_reason    String?
  administered_by_user_id String?
  // Populated only when order.is_high_alert -- enforced in the service, not
  // the schema (a schema-level requirement can't express "conditional on a
  // sibling row's own flag").
  witness_user_id String?
  // Links the dose to real, decremented stock -- what makes the eventual IPD
  // billing charge (slice 4) real rather than notional.
  batch_id       String?
  stock_movement_id String?
  notes          String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  client_organization ClientOrganizations @relation(fields: [client_org_id], references: [id])
  admission   Admissions          @relation(fields: [admission_id], references: [id], onDelete: Cascade)
  order       IpdMedicationOrders @relation(fields: [order_id], references: [id], onDelete: Cascade)
  drug        Drugs               @relation(fields: [drug_id], references: [id])
  batch       DrugBatches?        @relation(fields: [batch_id], references: [id])
  administered_by UserProfiles?   @relation("MarAdministeredBy", fields: [administered_by_user_id], references: [id])
  witness     UserProfiles?       @relation("MarWitness", fields: [witness_user_id], references: [id])

  @@unique([order_id, scheduled_at])
  @@index([admission_id, scheduled_at])
  @@index([client_org_id, status, scheduled_at])
}

model IntakeOutputRecords {
  id            String   @id @default(uuid())
  client_org_id String
  admission_id  String
  direction     String   // intake | output
  // oral | iv | ryles_tube | blood_product | other_intake
  // urine | drain | vomitus | stool | ngt_aspirate | blood_loss | other_output
  category      String
  volume_ml     Int
  recorded_at   DateTime
  shift         String   // morning | evening | night
  notes         String?
  recorded_by_user_id String
  created_at    DateTime @default(now())

  client_organization ClientOrganizations @relation(fields: [client_org_id], references: [id])
  admission   Admissions   @relation(fields: [admission_id], references: [id], onDelete: Cascade)
  recorded_by UserProfiles @relation("IoRecordedBy", fields: [recorded_by_user_id], references: [id])

  @@index([admission_id, recorded_at])
}

// One table, note_kind discriminator. Nursing progress notes and doctor
// round notes share every field; the codebase's own market research says a
// centralized nursing module sits apart from the doctor's consult note in
// the UI (competitors ship it this way) -- so the SEPARATION is in the
// frontend surface, not the storage. Contrast deliberately with Encounters:
// no unique-per-parent constraint, many authors, `locked` is per-NOTE not
// per-record -- a signed note locks itself, the stay stays open, which
// Encounters' own single-sign-locks-everything model cannot represent.
model AdmissionNotes {
  id             String   @id @default(uuid())
  client_org_id  String
  admission_id   String
  // nursing_progress | doctor_round | nursing_assessment | incident
  // | discharge_planning | physio | dietitian
  note_kind      String
  // SOAP for doctor_round; `content` alone for nursing_progress/other kinds.
  content        String   @default("")
  subjective     String?
  objective      String?
  assessment     String?
  plan           String?
  shift          String?  // morning | evening | night -- nursing notes only
  note_datetime  DateTime
  author_user_id String
  // Set when a clinician (not just a staff user) authored this note --
  // nullable because a nurse (staff, not necessarily a Clinicians row) can
  // author a nursing_progress note.
  author_clinician_id String?
  signed_at      DateTime?
  locked         Boolean  @default(false)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  client_organization ClientOrganizations @relation(fields: [client_org_id], references: [id])
  admission        Admissions   @relation(fields: [admission_id], references: [id], onDelete: Cascade)
  author           UserProfiles @relation("AdmissionNoteAuthor", fields: [author_user_id], references: [id])
  author_clinician Clinicians?  @relation("AdmissionNoteAuthorClinician", fields: [author_clinician_id], references: [id])
  addenda          AdmissionNoteAddenda[]

  @@index([admission_id, note_datetime])
  @@index([admission_id, note_kind, note_datetime])
  @@index([client_org_id, author_user_id])
}

// Append-only, exactly the EncounterAddenda precedent: a separate table,
// its own FK to the parent, never updated or deleted, so no trigger is
// needed here the way AdmissionNotes itself needs one.
model AdmissionNoteAddenda {
  id             String   @id @default(uuid())
  admission_note_id String
  author_id      String
  content        String
  reason         String?
  created_at     DateTime @default(now())

  admission_note AdmissionNotes @relation(fields: [admission_note_id], references: [id], onDelete: Cascade)
  author         UserProfiles   @relation("AdmissionNoteAddendumAuthor", fields: [author_id], references: [id])

  @@index([admission_note_id, created_at])
}

// Per-admission, not per-ward-shift: the handover content a nurse actually
// writes is patient-specific, and a per-admission row makes "this patient's
// full stay" a single query.
model ShiftHandovers {
  id             String   @id @default(uuid())
  client_org_id  String
  admission_id   String
  ward_id        String
  from_shift     String   // morning | evening | night
  to_shift       String
  handover_at    DateTime
  // SBAR -- the standard nursing handover structure.
  situation      String   @default("")
  background     String   @default("")
  assessment     String   @default("")
  recommendation String   @default("")
  pending_tasks  String?
  from_user_id   String
  to_user_id     String?
  acknowledged_at DateTime?
  created_at     DateTime @default(now())

  client_organization ClientOrganizations @relation(fields: [client_org_id], references: [id])
  admission Admissions   @relation(fields: [admission_id], references: [id], onDelete: Cascade)
  ward      Wards        @relation(fields: [ward_id], references: [id])
  from_user UserProfiles @relation("HandoverFrom", fields: [from_user_id], references: [id])
  to_user   UserProfiles? @relation("HandoverTo", fields: [to_user_id], references: [id])

  @@index([admission_id, handover_at])
  @@index([ward_id, handover_at])
}

model DischargeSummaryTemplates {
  id            String   @id @default(uuid())
  client_org_id String
  clinic_id     String?  // null = org-wide
  name          String
  specialty     String?
  department_id String?
  // Ordered sections + default text, e.g.
  // [{key:"course_in_hospital", label:"Course in Hospital", default:""}, ...]
  sections_json Json
  is_active     Boolean  @default(true)
  is_deleted    Boolean  @default(false)
  created_at    DateTime @default(now())

  client_organization ClientOrganizations @relation(fields: [client_org_id], references: [id])
  clinic     Clinics?     @relation(fields: [clinic_id], references: [id])
  department Departments? @relation(fields: [department_id], references: [id])
  summaries  DischargeSummaries[]

  @@index([client_org_id, clinic_id, is_active])
}

model DischargeSummaries {
  id             String   @id @default(uuid())
  client_org_id  String
  admission_id   String   @unique
  template_id    String?
  chief_complaint        String @default("")
  history                String @default("")
  examination_findings   String @default("")
  final_diagnosis        String @default("")
  // Pre-filled server-side from AdmissionEvents + (slice 3) OtNotes + MAR --
  // "template-based" is real, not a blank box the clinician starts from.
  course_in_hospital     String @default("")
  procedures_performed   String @default("")
  investigations_summary String @default("")
  condition_at_discharge String @default("")
  // A real Prescriptions row when one was issued at discharge, else free
  // text -- a DAMA discharge often has neither.
  discharge_prescription_id String?
  discharge_medications  String @default("")
  diet_advice            String @default("")
  follow_up_advice       String @default("")
  follow_up_date         DateTime?
  emergency_instructions String @default("")
  // Array of Icd10Codes.code strings -- matches Diagnoses.icd10_code's own
  // established single-string-reference convention (not a formal Prisma
  // relation; not a {code,description} JSON snapshot, which has no
  // precedent anywhere else in this schema).
  icd10_codes    Json?
  prepared_by_user_id    String
  signed_by_clinician_id String?
  signed_at      DateTime?
  locked         Boolean  @default(false)
  // SHA-256 over the summary's own canonical clinical content, computed at
  // sign time -- the exact Prescriptions.pdf_hash precedent (never a hash of
  // rendered PDF bytes; pdfkit's own embedded wall-clock CreationDate makes
  // byte-hashing non-deterministic across identical content).
  pdf_hash       String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  client_organization ClientOrganizations @relation(fields: [client_org_id], references: [id])
  admission  Admissions  @relation(fields: [admission_id], references: [id])
  template   DischargeSummaryTemplates? @relation(fields: [template_id], references: [id])
  discharge_prescription Prescriptions? @relation(fields: [discharge_prescription_id], references: [id])
  prepared_by UserProfiles @relation("DsPreparedBy", fields: [prepared_by_user_id], references: [id])
  signed_by   Clinicians?  @relation("DsSignedBy", fields: [signed_by_clinician_id], references: [id])

  @@index([client_org_id, signed_at])
}

// ============================================================
// REQ179 (IPD slice 3) — operation theatre scheduling. Two GiST EXCLUDE
// constraints (theatre-overlap including turnaround, surgeon-overlap) are
// the real guarantee, same design axiom as slice 1's bed-occupancy
// constraint: the database enforces mutual exclusion, never application
// code. turnaround_minutes is snapshotted onto the OtBookings row itself
// at create time (from OperationTheatres.default_turnaround_minutes,
// overridable) because a GiST EXCLUDE constraint cannot join to another
// table -- it must be able to compute the "physically occupied" range
// from columns on the one row it protects.
// ============================================================

model OperationTheatres {
  id                          String   @id @default(uuid())
  client_org_id               String
  clinic_id                   String
  name                        String
  default_turnaround_minutes  Int      @default(30)
  is_active                   Boolean  @default(true)
  is_deleted                  Boolean  @default(false)
  // REQ179 (IPD slice 4) -- the flat per-booking theatre-usage Products row,
  // posted once when a booking completes. Null = no usage charge auto-posted
  // for this theatre (same fail-safe convention as IpdBillingSettings.
  // doctor_visit_charge_product_id above).
  usage_charge_product_id    String?
  created_at                  DateTime @default(now())

  client_organization ClientOrganizations @relation(fields: [client_org_id], references: [id])
  clinic              Clinics             @relation(fields: [clinic_id], references: [id])
  usage_charge_product Products?          @relation("OtUsageChargeProduct", fields: [usage_charge_product_id], references: [id])
  bookings            OtBookings[]

  @@index([client_org_id, clinic_id, is_active])
}

model OtBookings {
  id                            String    @id @default(uuid())
  client_org_id                 String
  clinic_id                     String
  theatre_id                    String
  admission_id                  String
  procedure_name                 String
  primary_surgeon_clinician_id  String
  anesthetist_clinician_id      String?
  start_at                      DateTime
  end_at                        DateTime
  // Snapshotted from the theatre's own default at booking time -- see the
  // file-header comment on why this must live on this row, not a join.
  turnaround_minutes            Int
  status                        String    @default("scheduled") // scheduled | in_progress | completed | cancelled
  is_cancelled                  Boolean   @default(false)
  cancel_reason                  String?
  notes                         String?
  created_by_user_id            String
  created_at                    DateTime  @default(now())
  updated_at                    DateTime  @updatedAt

  client_organization ClientOrganizations @relation(fields: [client_org_id], references: [id])
  clinic              Clinics             @relation(fields: [clinic_id], references: [id])
  theatre             OperationTheatres   @relation(fields: [theatre_id], references: [id])
  admission           Admissions          @relation(fields: [admission_id], references: [id])
  primary_surgeon     Clinicians          @relation("OtPrimarySurgeon", fields: [primary_surgeon_clinician_id], references: [id])
  anesthetist         Clinicians?         @relation("OtAnesthetist", fields: [anesthetist_clinician_id], references: [id])

  staff       OtBookingStaff[]
  checklists  OtChecklists[]
  note        OtNotes?
  consumables OtConsumables[]

  @@index([theatre_id, start_at])
  @@index([admission_id])
  @@index([client_org_id, status, start_at])
  @@index([primary_surgeon_clinician_id, start_at])
}

// Team members beyond the primary surgeon/anesthetist (both denormalised
// onto OtBookings itself -- see the file header on why). A user, not a
// clinician: scrub/circulating nurses are staff accounts, not necessarily
// Clinicians rows.
model OtBookingStaff {
  id         String   @id @default(uuid())
  booking_id String
  user_id    String
  role       String // assistant_surgeon | scrub_nurse | circulating_nurse | anesthesia_tech | other
  created_at DateTime @default(now())

  booking OtBookings   @relation(fields: [booking_id], references: [id], onDelete: Cascade)
  user    UserProfiles @relation(fields: [user_id], references: [id])

  @@index([booking_id])
}

// The WHO Surgical Safety Checklist -- exactly 3 phases, each completed
// once. @@unique makes completing an already-completed phase a clean
// application-level conflict, not a silent duplicate.
model OtChecklists {
  id                    String    @id @default(uuid())
  booking_id            String
  phase                 String // sign_in | time_out | sign_out
  items_json            Json // [{key, label, checked}]
  completed_by_user_id  String?
  completed_at          DateTime?
  created_at            DateTime  @default(now())

  booking      OtBookings    @relation(fields: [booking_id], references: [id], onDelete: Cascade)
  completed_by UserProfiles? @relation(fields: [completed_by_user_id], references: [id])

  @@unique([booking_id, phase])
}

// Operative note. Locked + SHA-256-able via the same reject_write_if_locked()
// trigger AdmissionNotes/DischargeSummaries already use (REQ179 slice 2) --
// one booking, one note, @@unique via the FK itself (booking_id is @unique).
model OtNotes {
  id                    String    @id @default(uuid())
  client_org_id         String
  booking_id            String    @unique
  pre_op_diagnosis      String    @default("")
  procedure_performed   String    @default("")
  findings              String    @default("")
  complications         String    @default("")
  post_op_diagnosis     String    @default("")
  post_op_instructions  String    @default("")
  author_clinician_id   String
  signed_at             DateTime?
  locked                Boolean   @default(false)
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  client_organization ClientOrganizations @relation(fields: [client_org_id], references: [id])
  booking OtBookings @relation(fields: [booking_id], references: [id])
  author  Clinicians @relation("OtNoteAuthor", fields: [author_clinician_id], references: [id])
}

// Consumables/implants/surgical items used during a procedure. Real stock
// consumption -- mirrors mar.service.ts's own consumeStock() transaction
// shape (decrement DrugBatches.quantity_remaining, write an append-only
// StockMovements row), not a notional count. implant_serial_no is
// traceability for implants specifically (nullable -- irrelevant for a
// consumable like gauze). charge_id stays null this slice -- nothing
// bills for OT consumption until slice 4 backfills it, a stated gap, not
// an oversight.
model OtConsumables {
  id                   String   @id @default(uuid())
  client_org_id        String
  booking_id           String
  drug_id              String
  batch_id             String?
  quantity             Int
  implant_serial_no    String?
  charge_id            String?
  stock_movement_id    String?
  recorded_by_user_id  String
  created_at           DateTime @default(now())

  client_organization ClientOrganizations @relation(fields: [client_org_id], references: [id])
  booking OtBookings   @relation(fields: [booking_id], references: [id], onDelete: Cascade)
  drug    Drugs        @relation(fields: [drug_id], references: [id])
  batch   DrugBatches? @relation(fields: [batch_id], references: [id])
  recorded_by UserProfiles @relation(fields: [recorded_by_user_id], references: [id])

  @@index([booking_id])
}

// ============================================================
// REQ179 (IPD slice 4) — the billing ledger. `IpdBills.gross_paise` is a
// MAINTAINED running total, not a view — every posting/reversal path funnels
// through IpdBillingService.postCharge() inside one transaction that updates
// both the IpdCharges row and the bill's own gross_paise together, so the
// invariant `bill.gross_paise = SUM(charges.total_paise WHERE NOT
// is_reversed)` never has a window where it can be read half-updated.
// Reversal, never deletion or in-place edit — a wrong charge gets a signed
// negative reversal row, exactly the StockMovements/AdmissionEvents
// append-only precedent already established across this schema.
// ============================================================

model IpdBills {
  id                    String    @id @default(uuid())
  client_org_id         String
  clinic_id             String
  admission_id          String    @unique
  // Null until the first finalizeIpdBill() call — an open bill has no
  // number yet, matching Admissions/MlcRegisters' own "assign at the
  // moment it becomes a real document" convention.
  bill_number           String?
  status                String    @default("open") // open | finalized
  package_id            String?
  // Maintained, not derived-at-read -- see the file header above.
  gross_paise           Int       @default(0)
  paid_paise            Int       @default(0)
  finalized_at          DateTime?
  finalized_by_user_id  String?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  client_organization ClientOrganizations @relation(fields: [client_org_id], references: [id])
  clinic       Clinics      @relation(fields: [clinic_id], references: [id])
  admission    Admissions   @relation(fields: [admission_id], references: [id])
  package      IpdPackages? @relation(fields: [package_id], references: [id])
  finalized_by UserProfiles? @relation(fields: [finalized_by_user_id], references: [id])
  charges      IpdCharges[]
  payments     IpdPayments[]

  @@index([client_org_id, clinic_id, status])
}

model IpdCharges {
  id                     String   @id @default(uuid())
  client_org_id          String
  clinic_id              String
  admission_id           String
  bill_id                String
  // room_day | nursing | doctor_visit | pharmacy | ot_usage | ot_consumable
  // | investigation | package_adjustment | manual
  charge_type            String
  description            String
  // The calendar date this charge is FOR, not its created_at -- a room-day
  // charge posted late by the catch-up sweep is still dated the day it
  // covers.
  service_date           DateTime
  product_id             String?
  quantity                Int      @default(1)
  unit_price_paise        Int
  // Signed -- negative for a reversal row or a package-adjustment discount.
  total_paise             Int
  gst_rate                Float?
  gst_amount_paise        Int?
  is_reversed             Boolean  @default(false)
  is_package_inclusive    Boolean  @default(false)
  // The room-day/nursing partial-unique idempotency key (see the migration
  // for the real WHERE-scoped unique indexes Prisma's schema DSL cannot
  // express).
  bed_occupancy_id        String?
  // Generic provenance, e.g. ('clinician', clinicianId) for doctor_visit's
  // own per-clinician-per-day uniqueness, ('ot_booking', bookingId) for
  // ot_usage, ('ot_consumable', consumableId) for ot_consumable,
  // ('medication_administration', marId) for pharmacy.
  source_reference_type   String?
  source_reference_id     String?
  // Null for a system-posted charge (the room-day/nursing accrual sweep has
  // no human actor) -- the MedicationAdministrations.administered_by_user_id
  // precedent for the identical "a row can legitimately have no human yet"
  // shape.
  posted_by_user_id       String?
  created_at              DateTime @default(now())

  client_organization ClientOrganizations @relation(fields: [client_org_id], references: [id])
  clinic        Clinics          @relation(fields: [clinic_id], references: [id])
  admission     Admissions       @relation(fields: [admission_id], references: [id])
  bill          IpdBills         @relation(fields: [bill_id], references: [id])
  product       Products?        @relation(fields: [product_id], references: [id])
  bed_occupancy BedOccupancies?  @relation(fields: [bed_occupancy_id], references: [id])
  posted_by     UserProfiles?    @relation(fields: [posted_by_user_id], references: [id])
  // REQ179 (IPD slice 5)
  claimDeductions IpdClaimDeductions[]

  @@index([bill_id])
  @@index([admission_id, service_date])
  @@index([client_org_id, charge_type])
}

model IpdPayments {
  id                  String   @id @default(uuid())
  client_org_id       String
  clinic_id           String
  admission_id        String
  bill_id             String
  // deposit | interim | final | refund | payer_settlement
  payment_type        String
  // Signed -- negative for a refund.
  amount_paise        Int
  // [{tender_type, amountPaise, reference}] -- the DiscountApprovalRequests
  // .tenders_json precedent (appointment-payments), not a new child table.
  tenders_json        Json
  receipt_number      String
  notes               String?
  recorded_by_user_id String
  created_at          DateTime @default(now())

  client_organization ClientOrganizations @relation(fields: [client_org_id], references: [id])
  clinic      Clinics      @relation(fields: [clinic_id], references: [id])
  admission   Admissions   @relation(fields: [admission_id], references: [id])
  bill        IpdBills     @relation(fields: [bill_id], references: [id])
  recorded_by UserProfiles @relation(fields: [recorded_by_user_id], references: [id])

  @@index([bill_id])
  @@index([admission_id])
}

// A hospital-defined package (not a government scheme catalog -- REQ179's
// own confirmed scope decision). Settlement is one signed adjustment
// charge line at finalize time, never a mode switch on the bill itself --
// see IpdBillingService#finalizeBill.
model IpdPackages {
  id            String   @id @default(uuid())
  client_org_id String
  clinic_id     String
  name          String
  specialty     String?
  price_paise   Int
  is_active     Boolean  @default(true)
  is_deleted    Boolean  @default(false)
  created_at    DateTime @default(now())

  client_organization ClientOrganizations @relation(fields: [client_org_id], references: [id])
  clinic     Clinics                 @relation(fields: [clinic_id], references: [id])
  inclusions IpdPackageInclusions[]
  bills      IpdBills[]

  @@index([client_org_id, clinic_id, is_active])
}

// Inclusions only -- anything a package doesn't name is billable extra,
// which is how a real hospital package sheet is written (REQ179's own
// confirmed scope decision, not a government-scheme benefit table).
model IpdPackageInclusions {
  id           String   @id @default(uuid())
  package_id   String
  product_id   String
  max_quantity Int?
  created_at   DateTime @default(now())

  package IpdPackages @relation(fields: [package_id], references: [id], onDelete: Cascade)
  product Products    @relation(fields: [product_id], references: [id])

  @@unique([package_id, product_id])
}

// ============================================================
// REQ179 (IPD slice 5) — TPA cashless: pre-authorization, mid-stay
// enhancement, claim reconciliation with line-level disallowance. Payers/
// PayerTariffs/PayerEmpanelments/PatientInsurancePolicies are reused
// UNCHANGED (REQ031) — zero schema change to any of the four. Claims
// (REQ131) cannot be reused: its appointment_id is required (no
// appointment exists at pre-auth time), it has no client_org_id (an
// insurance desk queries org-wide), a single scalar claim_amount cannot
// hold a running authorization across N enhancements, and it has no
// line-level disallowance at all. Every state transition here has a real
// human decision point — no automated payer submission exists anywhere in
// this codebase, matching Claims' own established stance verbatim.
// ============================================================

// admission_id is nullable+@unique: nullable because a pre-auth is
// requested days before an admission exists at all; @unique because one
// admission has exactly one live pre-auth once bound. Binding happens via
// a dedicated bindPreAuthorizationToAdmission mutation (ipd-insurance
// module only) rather than folding it into admissions.service.ts's own
// createAdmission -- keeps this slice fully additive with zero change to
// the already-shipped, already-tested admissions module, and the @unique
// constraint itself is what makes "a second admission can't bind the same
// pre-auth" a database guarantee, not an application-level race.
model PreAuthorizations {
  id            String @id @default(uuid())
  client_org_id String
  clinic_id     String
  patient_id    String
  payer_id      String
  policy_id     String?
  admission_id  String? @unique

  // requested | approved | rejected | expired | cancelled
  status                 String    @default("requested")
  requested_amount_paise Int
  approved_amount_paise  Int?
  // The payer/TPA's own reference number, populated once approved --
  // MlcRegisters.mlc_number's own "assign once real" precedent.
  preauth_number         String?
  diagnosis_codes_json   Json?
  procedure_codes_json   Json?
  valid_until            DateTime?
  rejection_reason       String?
  notes                  String?

  requested_by_user_id String
  requested_at          DateTime  @default(now())
  decided_at            DateTime?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  client_organization ClientOrganizations       @relation(fields: [client_org_id], references: [id])
  clinic              Clinics                   @relation(fields: [clinic_id], references: [id])
  patient             Patients                  @relation(fields: [patient_id], references: [id])
  payer               Payers                    @relation(fields: [payer_id], references: [id])
  policy              PatientInsurancePolicies? @relation(fields: [policy_id], references: [id])
  admission           Admissions?               @relation(fields: [admission_id], references: [id])
  requested_by        UserProfiles              @relation(fields: [requested_by_user_id], references: [id])

  enhancements PreAuthEnhancements[]
  claim        IpdClaims?
  documents    IpdInsuranceDocuments[]

  @@index([client_org_id, clinic_id, status])
  @@index([patient_id])
}

// A mid-stay top-up request when the running bill (IpdBills.gross_paise,
// snapshotted server-side into bill_amount_at_request_paise -- never
// caller-supplied) exceeds the pre-auth's own currently authorized total.
// sequence_no + @@unique makes "enhancement #3 for pre-auth X" a stable,
// gapless-within-preauth identity the frontend and the payer correspondence
// can both reference.
model PreAuthEnhancements {
  id            String @id @default(uuid())
  preauth_id    String
  sequence_no   Int

  requested_amount_paise        Int
  approved_amount_paise         Int?
  // requested | approved | rejected
  status                        String @default("requested")
  bill_amount_at_request_paise  Int
  reason                        String
  rejection_reason              String?

  requested_by_user_id String
  requested_at          DateTime  @default(now())
  decided_at            DateTime?
  created_at            DateTime  @default(now())

  preauth      PreAuthorizations @relation(fields: [preauth_id], references: [id], onDelete: Cascade)
  requested_by UserProfiles      @relation(fields: [requested_by_user_id], references: [id])

  @@unique([preauth_id, sequence_no])
}

// One claim per admission (a stay bills to a payer once, reconciled at
// discharge against the real, finalized IPD bill) -- admission_id @unique.
// preauth_id is nullable+@unique: most cashless claims trace back to a real
// pre-auth, but this stays representable for a claim filed without one
// (nullable), while still guaranteeing at most one claim per pre-auth
// (@unique) when it is set.
model IpdClaims {
  id            String @id @default(uuid())
  client_org_id String
  clinic_id     String
  admission_id  String  @unique
  preauth_id    String? @unique
  patient_id    String
  payer_id      String
  policy_id     String?

  // draft | submitted | under_review | approved | partially_approved
  // | rejected | settled
  status                String  @default("draft")
  claimed_amount_paise  Int
  approved_amount_paise Int?
  // Gapless, via InvoiceSequences series IPC -- assigned at submission,
  // null while still a draft (IpdBills.bill_number's own precedent).
  claim_number          String?
  rejection_reason      String?
  notes                 String?

  submitted_by_user_id String?
  submitted_at          DateTime?
  decided_at            DateTime?
  settled_at            DateTime?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  client_organization ClientOrganizations       @relation(fields: [client_org_id], references: [id])
  clinic              Clinics                   @relation(fields: [clinic_id], references: [id])
  admission           Admissions                @relation(fields: [admission_id], references: [id])
  preauth             PreAuthorizations?        @relation(fields: [preauth_id], references: [id])
  patient             Patients                  @relation(fields: [patient_id], references: [id])
  payer               Payers                    @relation(fields: [payer_id], references: [id])
  policy              PatientInsurancePolicies? @relation(fields: [policy_id], references: [id])
  submitted_by        UserProfiles?             @relation(fields: [submitted_by_user_id], references: [id])

  deductions IpdClaimDeductions[]
  documents  IpdInsuranceDocuments[]

  @@index([client_org_id, clinic_id, status])
  @@index([payer_id])
  @@index([patient_id])
}

// Line-level disallowance -- the thing the pre-existing Claims model
// structurally cannot express (one scalar claim_amount, no line items at
// all). charge_id is optional: a deduction usually references a real
// IpdCharges row (e.g. "room rent capping" against the actual room-day
// charge), but a payer sometimes disallows a flat amount with no single
// line to point at (e.g. a co-pay percentage) -- forcing a charge_id would
// make that case unrepresentable.
model IpdClaimDeductions {
  id                    String @id @default(uuid())
  claim_id              String
  charge_id             String?
  description           String
  deducted_amount_paise Int
  created_at            DateTime @default(now())

  claim  IpdClaims   @relation(fields: [claim_id], references: [id], onDelete: Cascade)
  charge IpdCharges? @relation(fields: [charge_id], references: [id])

  @@index([claim_id])
}

// Pre-auth forms, discharge summaries, payer correspondence, id proof,
// policy copies -- the REST-upload + GraphQL-metadata two-step split
// already established by encounters/attachments.controller.ts and
// messages/message-attachments.controller.ts. Exactly one of
// preauth_id/claim_id is set (CHECK num_nonnulls(...) = 1 in the
// migration -- the Vitals.encounter_id/admission_id precedent).
model IpdInsuranceDocuments {
  id            String @id @default(uuid())
  client_org_id String
  preauth_id    String?
  claim_id      String?

  // preauth_form | discharge_summary | bill | payer_correspondence
  // | id_proof | policy_copy | other
  document_type String
  file_ref      String
  mime_type     String
  notes         String?

  uploaded_by_user_id String
  uploaded_at          DateTime @default(now())

  client_organization ClientOrganizations @relation(fields: [client_org_id], references: [id])
  preauth             PreAuthorizations?  @relation(fields: [preauth_id], references: [id])
  claim               IpdClaims?          @relation(fields: [claim_id], references: [id])
  uploaded_by         UserProfiles        @relation(fields: [uploaded_by_user_id], references: [id])

  @@index([preauth_id])
  @@index([claim_id])
}
