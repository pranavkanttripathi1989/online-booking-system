generator client {
  provider   = "prisma-client"
  output     = "../prisma/generated"
}

datasource db {
  provider = "postgresql"
}

//
// ENUMS
//

enum TemplateType {
  confirmation
  reschedule
  cancellation
}

enum NotificationType {
  appointment
  system
  payment
  alert
}

enum NotificationPriority {
  low
  medium
  high
}

enum ProductType {
  simple
  variable
}

enum RuleType {
  cancellation
  reschedule
}

enum FeeType {
  fixed
  percentage
}

enum SubscriptionStatus {
  active
  cancelled
  expired
  trial
}

enum BillingCycle {
  monthly
  yearly
}

enum RecurrenceType {
  single
  daily
  weekly
  monthly
  custom
}

//
// MODELS
//

model ClinicianTypeModel {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now())

  @@map("clinician_types")
}

model RoomTypeModel {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now())

  @@map("room_types")
}

model Appointments {
  id                  String   @id @default(uuid())
  clinic_id           String
  room_id             String
  clinician_id        String
  patient_id          String
  appointment_date    DateTime
  appointment_time    DateTime
  duration_minutes    Int      @default(30)
  status              String   @default("scheduled")
  reason              String
  notes               String   @default("")
  is_deleted          Boolean  @default(false)
  created_at          DateTime @default(now())
  updated_at          DateTime @default(now())
  product_id          String?
  product_variation_id String?

  clinic              Clinics               @relation(fields: [clinic_id], references: [id])
  room                Rooms                 @relation(fields: [room_id], references: [id])
  clinician           Clinicians            @relation(fields: [clinician_id], references: [id])
  patient             Patients              @relation(fields: [patient_id], references: [id])
  product             Products?             @relation(fields: [product_id], references: [id])
  product_variation   ProductVariations?    @relation(fields: [product_variation_id], references: [id])
}

model AuditLogs {
  id         String   @id @default(uuid())
  user_id    String?
  action     String
  resource   String
  resource_id String?
  details    Json     @default("{}")
  ip_address String?
  is_deleted Boolean  @default(false)
  created_at DateTime @default(now())

  user Users? @relation(fields: [user_id], references: [id])
}

model ClientOrganizations {
  id            String   @id @default(uuid())
  name          String
  code          String   @unique
  contact_email String
  contact_phone String?
  address       String?
  is_active     Boolean  @default(true)
  is_deleted    Boolean  @default(false)
  settings      Json     @default("{}")
  created_at    DateTime @default(now())
  updated_at    DateTime @default(now())

  clinics                Clinics[]
  organizationSubs       OrganizationSubscriptions[]
  user_profiles          UserProfiles[]
  stripe_configurations  StripeConfigurations?
  paymentTransactions    PaymentTransactions[]
}

model ClinicianAvailability {
  id                String   @id @default(uuid())
  clinician_id      String
  clinic_id         String
  day_of_week       Int?     // 0-6 (Sunday-Saturday) for weekly recurring
  start_time        String   // HH:MM format
  end_time          String   // HH:MM format
  recurrence_type   String   @default("weekly") // daily, weekly, monthly, custom
  custom_dates      String?  // JSON array of dates for custom recurrence
  exclude_weekends  Boolean  @default(false)
  exclude_saturday  Boolean  @default(false)
  exclude_sunday    Boolean  @default(false)
  excluded_days     String?  // JSON array of day numbers (0-6) to exclude
  valid_from        DateTime @default(now())
  valid_until       DateTime?
  is_active         Boolean  @default(true)
  is_deleted        Boolean  @default(false)
  created_at        DateTime @default(now())
  updated_at        DateTime @default(now()) @updatedAt
  room_id           String?

  clinician Clinicians @relation(fields: [clinician_id], references: [id])
  clinic    Clinics    @relation(fields: [clinic_id], references: [id])
  room      Rooms?     @relation(fields: [room_id], references: [id])
}


model Clinicians {
  id             String   @id @default(uuid())
  clinic_id      String
  first_name     String
  last_name      String
  clinician_type String
  gender         String?
  email          String   @unique
  phone          String
  is_active      Boolean  @default(true)
  is_deleted     Boolean  @default(false)
  created_at     DateTime @default(now())

  clinic Clinics @relation(fields: [clinic_id], references: [id])

  availability        ClinicianAvailability[]
  appointments        Appointments[]
  lunchBreaks         LunchBreaks[]
  spacerBlocks        SpacerBlocks[]
  userProfiles        UserProfiles[]
  clinicianLanguages  ClinicianLanguages[]
}

model Clinics {
  id           String   @id @default(uuid())
  name         String
  address      String
  phone        String
  email        String
  is_primary   Boolean  @default(false)
  is_active    Boolean  @default(true)
  is_deleted   Boolean  @default(false)
  created_at   DateTime @default(now())
  client_org_id String?

  client_organization ClientOrganizations? @relation(fields: [client_org_id], references: [id])

  clinicians         Clinicians[]
  rooms              Rooms[]
  availability       ClinicianAvailability[]
  lunchBreaks        LunchBreaks[]
  spacerBlocks       SpacerBlocks[]
  blocks             RoomBlocks[]
  appointments       Appointments[]
  userProfiles       UserProfiles[]
  products           Products[]
  productCategories  ProductCategories[]
  productSubcategories ProductSubcategories[]
}

model EmailTemplates {
  id            String       @id @default(uuid())
  name          String
  template_type TemplateType
  subject       String
  body          String
  is_active     Boolean      @default(true)
  is_deleted    Boolean      @default(false)
  created_at    DateTime     @default(now())
  updated_at    DateTime     @default(now())
}

model LunchBreaks {
  id             String        @id @default(uuid())
  clinician_id   String
  clinic_id      String
  day_of_week    Int?
  start_time     DateTime
  end_time       DateTime
  is_recurring   Boolean       @default(true)
  specific_date  DateTime?
  is_deleted     Boolean       @default(false)
  created_at     DateTime      @default(now())
  recurrence_type RecurrenceType @default(single)
  recurrence_days Json?
  end_date       DateTime?

  clinician Clinicians @relation(fields: [clinician_id], references: [id])
  clinic    Clinics    @relation(fields: [clinic_id], references: [id])
}

model Notifications {
  id         String              @id @default(uuid())
  user_id    String
  title      String
  message    String
  type       NotificationType
  priority   NotificationPriority @default(medium)
  is_read    Boolean             @default(false)
  is_deleted Boolean             @default(false)
  action_url String?
  metadata   Json                @default("{}")
  created_at DateTime            @default(now())

  user Users @relation(fields: [user_id], references: [id])
}

model OrganizationSubscriptions {
  id                   String              @id @default(uuid())
  client_org_id        String
  plan_id              String
  status               SubscriptionStatus
  billing_cycle        BillingCycle
  current_period_start DateTime @default(now())
  current_period_end   DateTime
  is_deleted           Boolean  @default(false)
  stripe_customer_id   String?
  stripe_subscription_id String?
  created_at           DateTime @default(now())
  updated_at           DateTime @default(now())

  client_org          ClientOrganizations @relation(fields: [client_org_id], references: [id])
  plan                SubscriptionPlans   @relation(fields: [plan_id], references: [id])
  paymentTransactions PaymentTransactions[] @relation("SubscriptionTransactions")
}

model Patients {
  id                    String   @id @default(uuid())
  first_name            String
  last_name             String
  date_of_birth         DateTime
  email                 String
  phone                 String
  phone_country_code    String?
  address               String
  medical_notes         String   @default("")
  title                 String?
  status                String?
  birth_surname         String?
  birth_name            String?
  birth_names           String?
  social_security_number String?
  gender                String?
  sex                   String?
  google_client_id      String?
  payment_reference     String?
  occupation            String?
  place_of_birth        Json?    // JSON: { city, country }
  phones                Json?    // JSON array: [{ countryCode, number }]
  address_structured    Json?    // JSON: { line1, line2, city, postalCode, country }
  is_deleted            Boolean  @default(false)
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  appointments Appointments[]
  userProfiles UserProfiles[]
}

model PaymentTransactions {
  id             String   @id @default(uuid())
  client_org_id  String
  subscription_id String?
  amount         Float
  currency       String   @default("USD")
  status         String
  is_deleted     Boolean  @default(false)
  stripe_payment_intent_id String?
  stripe_invoice_id String?
  transaction_date DateTime @default(now())
  metadata       Json     @default("{}")
  created_at     DateTime @default(now())

  client_org    ClientOrganizations        @relation(fields: [client_org_id], references: [id])
  subscription  OrganizationSubscriptions? @relation("SubscriptionTransactions", fields: [subscription_id], references: [id])
}

model Permissions {
  id          String   @id @default(uuid())
  name        String   @unique
  description String   @default("")
  resource    String
  action      String
  created_at  DateTime @default(now())

  rolePermissions RolePermissions[]
}

model ProductCancellationRules {
  id                     String      @id @default(uuid())
  product_id             String
  rule_type              RuleType
  hours_before_appointment Int      @default(24)
  fee_type               FeeType
  fee_amount             Float
  is_active              Boolean    @default(true)
  is_deleted             Boolean    @default(false)
  created_at             DateTime   @default(now())
  updated_at             DateTime   @default(now())

  product Products @relation(fields: [product_id], references: [id])
}

model ProductCategories {
  id           String   @id @default(uuid())
  clinic_id    String?
  name         String
  description  String   @default("")
  is_active    Boolean  @default(true)
  is_deleted   Boolean  @default(false)
  created_at   DateTime @default(now())

  clinic            Clinics? @relation(fields: [clinic_id], references: [id])
  subcategories     ProductSubcategories[]
  products          Products[]
}

model ProductSubcategories {
  id           String   @id @default(uuid())
  clinic_id    String?
  category_id  String
  name         String
  description  String   @default("")
  is_active    Boolean  @default(true)
  is_deleted   Boolean  @default(false)
  created_at   DateTime @default(now())

  clinic    Clinics? @relation(fields: [clinic_id], references: [id])
  category  ProductCategories @relation(fields: [category_id], references: [id])
  products  Products[]
}

model ProductVariations {
  id              String   @id @default(uuid())
  product_id      String
  variation_name  String
  sku             String   @unique
  price           Float
  stock_quantity  Int      @default(0)
  is_active       Boolean  @default(true)
  is_deleted      Boolean  @default(false)
  created_at      DateTime @default(now())

  product Products @relation(fields: [product_id], references: [id])
  appointments Appointments[]
}

model Products {
  id                String   @id @default(uuid())
  clinic_id         String?
  category_id       String?
  subcategory_id    String?
  name              String
  description       String   @default("")
  product_type      ProductType
  sku               String   @unique
  price             Float?
  order_by          Int      @default(0)
  is_active         Boolean  @default(true)
  is_deleted        Boolean  @default(false)
  created_at        DateTime @default(now())

  clinic            Clinics? @relation(fields: [clinic_id], references: [id])
  category          ProductCategories? @relation(fields: [category_id], references: [id])
  subcategory       ProductSubcategories? @relation(fields: [subcategory_id], references: [id])
  variations        ProductVariations[]
  appointments      Appointments[]
  cancellationRules ProductCancellationRules[]
}

model RolePermissions {
  id            String   @id @default(uuid())
  role_id       String
  permission_id String
  is_deleted    Boolean  @default(false)
  created_at    DateTime @default(now())

  role       UserRoles   @relation(fields: [role_id], references: [id])
  permission Permissions @relation(fields: [permission_id], references: [id])
}

model RoomBlocks {
  id          String   @id @default(uuid())
  room_id     String
  clinic_id   String
  block_date  DateTime
  start_time  DateTime
  end_time    DateTime
  reason      String   @default("")
  is_recurring Boolean @default(false)
  is_deleted  Boolean  @default(false)
  created_at  DateTime @default(now())

  room   Rooms   @relation(fields: [room_id], references: [id])
  clinic Clinics @relation(fields: [clinic_id], references: [id])
}

model Rooms {
  id          String   @id @default(uuid())
  clinic_id   String
  room_number String
  room_type   String   @default("consultation")
  clinician_type String?
  is_active   Boolean  @default(true)
  is_deleted  Boolean  @default(false)
  created_at  DateTime @default(now())

  clinic Clinics @relation(fields: [clinic_id], references: [id])
  availability ClinicianAvailability[]
  appointments Appointments[]
  roomBlocks   RoomBlocks[]
  spacerBlocks SpacerBlocks[]
}

model SpacerBlocks {
  id             String        @id @default(uuid())
  clinician_id   String
  clinic_id      String
  room_id        String?
  block_date     DateTime?
  start_time     DateTime
  end_time       DateTime
  reason         String         @default("")
  is_deleted     Boolean        @default(false)
  created_at     DateTime       @default(now())
  recurrence_type RecurrenceType @default(single)
  recurrence_days Json?
  end_date       DateTime?

  clinician Clinicians @relation(fields: [clinician_id], references: [id])
  clinic    Clinics    @relation(fields: [clinic_id], references: [id])
  room      Rooms?     @relation(fields: [room_id], references: [id])
}

model StripeConfigurations {
  id                 String   @id @default(uuid())
  client_org_id      String   @unique
  stripe_account_id  String?
  stripe_publishable_key String?
  stripe_webhook_secret String?
  is_active          Boolean  @default(true)
  is_deleted         Boolean  @default(false)
  created_at         DateTime @default(now())
  updated_at         DateTime @default(now())

  client_organization ClientOrganizations @relation(fields: [client_org_id], references: [id])
}

model SubscriptionPlans {
  id            String   @id @default(uuid())
  name          String   @unique
  description   String
  price_monthly Float    @default(0)
  price_yearly  Float    @default(0)
  max_clinics   Int      @default(1)
  max_users     Int      @default(5)
  features      Json     @default("{}")
  is_active     Boolean  @default(true)
  is_deleted    Boolean  @default(false)
  created_at    DateTime @default(now())

  subscriptions OrganizationSubscriptions[]
}

//
// USERS FROM auth.users TABLE
//

model Users {
  id String @id @default(uuid())

  auditLogs    AuditLogs[]
  notifications Notifications[]
  userProfiles  UserProfiles?
}

model UserProfiles {
  id            String   @id
  role_id       String
  first_name    String
  last_name     String
  email         String   @unique
  password      String
  phone         String?
  phone_country_code String?
  address_line1 String?
  address_line2 String?
  city          String?
  postal_code   String?
  country       String?
  user_image    String?
  clinic_id     String?
  clinician_id  String?
  patient_id    String?
  is_active     Boolean  @default(true)
  is_deleted    Boolean  @default(false)
  created_at    DateTime @default(now())
  updated_at    DateTime @default(now())
  client_org_id String?

  // add these for forgot-password
  password_reset_token   String?
  password_reset_expires DateTime?

  email_verified           Boolean   @default(false)
  email_verification_token String?
  email_verification_expires DateTime?

  user        Users                @relation(fields: [id], references: [id])
  role        UserRoles            @relation(fields: [role_id], references: [id])
  clinic      Clinics?             @relation(fields: [clinic_id], references: [id])
  clinician   Clinicians?          @relation(fields: [clinician_id], references: [id])
  patient     Patients?            @relation(fields: [patient_id], references: [id])
  client_org  ClientOrganizations? @relation(fields: [client_org_id], references: [id])
}

model UserRoles {
  id          String   @id @default(uuid())
  name        String   @unique
  description String   @default("")
  is_deleted  Boolean  @default(false)
  created_at  DateTime @default(now())

  rolePermissions RolePermissions[]
  userProfiles   UserProfiles[]
}

model Languages {
  id         String   @id @default(uuid())
  name       String   @unique
  code       String   @unique
  is_active  Boolean  @default(true)
  is_deleted Boolean  @default(false)
  created_at DateTime @default(now())

  clinicianLanguages ClinicianLanguages[]
}

model ClinicianLanguages {
  id            String   @id @default(uuid())
  clinician_id  String
  language_id   String
  is_deleted    Boolean  @default(false)
  created_at    DateTime @default(now())

  clinician Clinicians @relation(fields: [clinician_id], references: [id], onDelete: Cascade)
  language  Languages  @relation(fields: [language_id], references: [id], onDelete: Cascade)

  @@unique([clinician_id, language_id])
}
