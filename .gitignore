# ─────────────────────────────────────────────────────────────────────────────
# .gitignore — MediBook / HealthSync Online Booking System
# Stack: React (Vite) frontend · Laravel (PHP) backend · Prisma ORM · Docker
# ─────────────────────────────────────────────────────────────────────────────


# ── Environment & Secrets ─────────────────────────────────────────────────────
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*


# ── Node / npm ────────────────────────────────────────────────────────────────
node_modules/
frontend/node_modules/
backend/node_modules/
.npm-cache/
frontend/.npm-cache/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/


# ── Frontend Build (Vite / React) ─────────────────────────────────────────────
frontend/dist/
backend/dist/
frontend/build/
frontend/.vite/
frontend/.vite-temp/
frontend/storybook-static/

# Vite cache
frontend/.cache/


# ── Frontend Testing ──────────────────────────────────────────────────────────
frontend/coverage/
frontend/playwright-report/
frontend/test-results/
frontend/.vitest/


# ── Frontend Config (keep .npmrc out — may contain registry tokens) ───────────
frontend/.npmrc


# ── Backend — Laravel (PHP) ───────────────────────────────────────────────────
backend/vendor/
backend/storage/logs/*.log
backend/storage/app/public
backend/storage/framework/cache/
backend/storage/framework/sessions/
backend/storage/framework/testing/
backend/storage/framework/views/
backend/bootstrap/cache/*.php
backend/.phpunit.result.cache
backend/coverage/
backend/public/hot
backend/public/storage

# Laravel debug bar & telescope
backend/storage/debugbar/
backend/storage/telescope/


# ── Backend — Prisma ORM ──────────────────────────────────────────────────────
# Keep schema.prisma committed; ignore generated client & migration dev files
backend/prisma/dev.db
backend/prisma/dev.db-journal
backend/prisma/*.db
prisma/*.db
prisma/dev.db
prisma/dev.db-journal

# Generated Prisma client (re-generated on install)
backend/node_modules/.prisma/
backend/generated/


# ── Backend — GraphQL ─────────────────────────────────────────────────────────
# Keep schema files; ignore generated types/introspection snapshots
backend/graphql/generated/
backend/graphql/__generated__/


# ── Docker ────────────────────────────────────────────────────────────────────
docker-compose.override.yml
backend/docker/nginx/logs/
.docker-volumes/


# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini


# ── IDE / Editor ──────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-workspace


# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/
*.log.*


# ── Archives & Temp Files ─────────────────────────────────────────────────────
*.zip
*.tar.gz
*.tgz
*.rar
*.7z
*.bak
*.tmp
*.temp
frontend/*.zip
frontend/*.tar.gz


# ── TypeScript Build Cache ────────────────────────────────────────────────────
*.tsbuildinfo
frontend/*.tsbuildinfo


# ── Testing / CI Artifacts ────────────────────────────────────────────────────
.cache/
.turbo/
.next/
.nuxt/


# ── Security / Certificates ───────────────────────────────────────────────────
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
