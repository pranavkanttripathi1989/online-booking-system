# ─── Root Environment Variables ────────────────────────────────────────────────
# Copy this to .env and fill in your values

# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=local
APP_DEBUG=true
APP_KEY=

# ── MySQL ─────────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=medibook_db
MYSQL_USER=medibook
MYSQL_PASSWORD=medibook_secret
MYSQL_PORT=3306

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PORT=6379

# ── Service Ports ─────────────────────────────────────────────────────────────
NGINX_PORT=8000
FRONTEND_PORT=3000
PMA_PORT=8080

# ── App URLs ──────────────────────────────────────────────────────────────────
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# ── Frontend GraphQL Endpoints ────────────────────────────────────────────────
VITE_GRAPHQL_URL=http://localhost:8000/graphql
VITE_GRAPHQL_WS_URL=ws://localhost:8000/graphql

# ── Pusher (Real-time WebSockets) ─────────────────────────────────────────────
VITE_PUSHER_KEY=
VITE_PUSHER_CLUSTER=mt1
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

# ── Mail (dev only — use Mailpit) ─────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS=noreply@medibook.app

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=
